{
  "$schema": "https://design-tokens.org/schema.json",
  "meta": {
    "brand": "Vey",
    "source": "Vey native theme",
    "sync": "assets/design-tokens.json → ui/tokens.slint + assets/design-tokens.css",
    "mode": "dark-only (color-scheme: dark)"
  },
  "primitive": {
    "color": {
      "neutral": {
        "0": { "$value": "#080808", "$type": "color" },
        "50": { "$value": "#0c0c0c", "$type": "color" },
        "100": { "$value": "#141414", "$type": "color" },
        "150": { "$value": "#1c1c1c", "$type": "color" },
        "200": { "$value": "#252525", "$type": "color" },
        "300": { "$value": "#363636", "$type": "color" }
      },
      "ink": {
        "100": { "$value": "#f5f5f5", "$type": "color" },
        "150": { "$value": "#d6d6d6", "$type": "color" },
        "200": { "$value": "#b8b8b8", "$type": "color" },
        "300": { "$value": "#888888", "$type": "color" }
      },
      "brand": {
        "300": { "$value": "#c9ff62", "$type": "color" },
        "500": { "$value": "#adff12", "$type": "color" },
        "600": { "$value": "#86c900", "$type": "color" },
        "ink": { "$value": "#101400", "$type": "color" }
      },
      "status": {
        "ok": { "$value": "#34d399", "$type": "color" },
        "warn": { "$value": "#fbbf24", "$type": "color" },
        "danger": { "$value": "#f87171", "$type": "color" }
      },
      "alpha": {
        "04": { "$value": "rgba(255, 255, 255, 0.04)", "$type": "color" },
        "06": { "$value": "rgba(255, 255, 255, 0.06)", "$type": "color" },
        "08": { "$value": "rgba(255, 255, 255, 0.08)", "$type": "color" },
        "12": { "$value": "rgba(255, 255, 255, 0.12)", "$type": "color" },
        "16": { "$value": "rgba(255, 255, 255, 0.16)", "$type": "color" },
        "24": { "$value": "rgba(255, 255, 255, 0.24)", "$type": "color" },
        "40": { "$value": "rgba(255, 255, 255, 0.4)", "$type": "color" },
        "60": { "$value": "rgba(255, 255, 255, 0.6)", "$type": "color" },
        "brand-08": { "$value": "rgba(173, 255, 18, 0.08)", "$type": "color" },
        "brand-16": { "$value": "rgba(173, 255, 18, 0.16)", "$type": "color" },
        "brand-32": { "$value": "rgba(173, 255, 18, 0.32)", "$type": "color" },
        "brand-48": { "$value": "rgba(173, 255, 18, 0.48)", "$type": "color" },
        "danger-40": { "$value": "rgba(248, 113, 113, 0.4)", "$type": "color" },
        "scrim": { "$value": "rgba(8, 8, 12, 0.9)", "$type": "color" }
      }
    },
    "fontSize": {
      "micro": { "$value": "11px", "$type": "dimension" },
      "xs": { "$value": "12px", "$type": "dimension" },
      "sm": { "$value": "13px", "$type": "dimension" },
      "md": { "$value": "14px", "$type": "dimension" },
      "card": { "$value": "15px", "$type": "dimension" },
      "lg": { "$value": "16px", "$type": "dimension" },
      "xl": { "$value": "20px", "$type": "dimension" },
      "2xl": { "$value": "24px", "$type": "dimension" },
      "3xl": { "$value": "28px", "$type": "dimension" }
    },
    "spacing": {
      "1": { "$value": "4px", "$type": "dimension" },
      "2": { "$value": "8px", "$type": "dimension" },
      "3": { "$value": "12px", "$type": "dimension" },
      "4": { "$value": "16px", "$type": "dimension" },
      "5": { "$value": "20px", "$type": "dimension" },
      "6": { "$value": "24px", "$type": "dimension" },
      "8": { "$value": "32px", "$type": "dimension" },
      "10": { "$value": "48px", "$type": "dimension" }
    },
    "radius": {
      "xs": { "$value": "4px", "$type": "dimension" },
      "sm": { "$value": "8px", "$type": "dimension" },
      "md": { "$value": "12px", "$type": "dimension" },
      "lg": { "$value": "16px", "$type": "dimension" },
      "pill": { "$value": "999px", "$type": "dimension" }
    },
    "duration": {
      "fast": { "$value": "120ms", "$type": "duration" },
      "base": { "$value": "180ms", "$type": "duration" },
      "slow": { "$value": "280ms", "$type": "duration" }
    },
    "easing": {
      "standard": { "$value": "cubic-bezier(0.2, 0, 0, 1)", "$type": "other" },
      "out": { "$value": "cubic-bezier(0.16, 1, 0.3, 1)", "$type": "other" }
    },
    "shadow": {
      "pop": { "$value": "0 12px 32px rgba(0, 0, 0, 0.55)", "$type": "shadow" },
      "art": { "$value": "0 16px 48px rgba(0, 0, 0, 0.6)", "$type": "shadow" }
    },
    "fontFamily": {
      "ui": { "$value": "\"Roboto\", \"Segoe UI\", system-ui, -apple-system, sans-serif", "$type": "fontFamily" },
      "mono": { "$value": "\"DM Mono\", ui-monospace, monospace", "$type": "fontFamily" }
    },
    "metric": {
      "sidebar-width": { "$value": "240px", "$type": "dimension" },
      "sidebar-rail": { "$value": "72px", "$type": "dimension" },
      "topbar-height": { "$value": "64px", "$type": "dimension" },
      "player-height": { "$value": "72px", "$type": "dimension" },
      "control-2xs": { "$value": "24px", "$type": "dimension" },
      "control-xs": { "$value": "28px", "$type": "dimension" },
      "control-sm": { "$value": "32px", "$type": "dimension" },
      "control-md": { "$value": "36px", "$type": "dimension" },
      "control-lg": { "$value": "40px", "$type": "dimension" },
      "control-xl": { "$value": "44px", "$type": "dimension" }
    }
  },
  "semantic": {
    "color": {
      "canvas": { "$value": "{primitive.color.neutral.0}", "$type": "color" },
      "surface": { "$value": "{primitive.color.neutral.100}", "$type": "color" },
      "surface-raised": { "$value": "{primitive.color.neutral.150}", "$type": "color" },
      "surface-overlay": { "$value": "{primitive.color.neutral.200}", "$type": "color" },
      "surface-sunken": { "$value": "{primitive.color.neutral.50}", "$type": "color" },
      "surface-hover": { "$value": "{primitive.color.alpha.08}", "$type": "color" },
      "surface-press": { "$value": "{primitive.color.alpha.12}", "$type": "color" },
      "surface-selected": { "$value": "{primitive.color.alpha.16}", "$type": "color" },
      "line": { "$value": "{primitive.color.alpha.08}", "$type": "color" },
      "line-strong": { "$value": "{primitive.color.alpha.24}", "$type": "color" },
      "text": { "$value": "{primitive.color.ink.100}", "$type": "color" },
      "text-muted": { "$value": "{primitive.color.ink.200}", "$type": "color" },
      "text-soft": { "$value": "{primitive.color.ink.150}", "$type": "color" },
      "text-faint": { "$value": "{primitive.color.ink.300}", "$type": "color" },
      "accent": { "$value": "{primitive.color.brand.500}", "$type": "color" },
      "accent-hover": { "$value": "{primitive.color.brand.300}", "$type": "color" },
      "accent-press": { "$value": "{primitive.color.brand.600}", "$type": "color" },
      "on-accent": { "$value": "{primitive.color.brand.ink}", "$type": "color" },
      "focus-ring": { "$value": "{primitive.color.brand.300}", "$type": "color" }
    }
  },
  "component": {
    "icon-button": {
      "size": { "$value": "{primitive.metric.control-md}", "$type": "dimension" },
      "radius": { "$value": "{primitive.radius.pill}", "$type": "dimension" },
      "fg": { "$value": "{semantic.color.text-muted}", "$type": "color" },
      "fg-hover": { "$value": "{semantic.color.text}", "$type": "color" },
      "bg-hover": { "$value": "{semantic.color.surface-hover}", "$type": "color" },
      "fg-active": { "$value": "{semantic.color.accent}", "$type": "color" }
    },
    "button-bordered": {
      "height": { "$value": "{primitive.metric.control-sm}", "$type": "dimension" },
      "height-lg": { "$value": "{primitive.metric.control-md}", "$type": "dimension" },
      "radius": { "$value": "{primitive.radius.pill}", "$type": "dimension" },
      "border": { "$value": "{semantic.color.line-strong}", "$type": "color" },
      "font-size": { "$value": "{primitive.fontSize.sm}", "$type": "dimension" },
      "primary-bg": { "$value": "{semantic.color.accent}", "$type": "color" },
      "primary-fg": { "$value": "{semantic.color.on-accent}", "$type": "color" }
    },
    "chip": {
      "height": { "$value": "{primitive.metric.control-sm}", "$type": "dimension" },
      "radius": { "$value": "{primitive.radius.pill}", "$type": "dimension" },
      "bg": { "$value": "{semantic.color.surface-hover}", "$type": "color" },
      "bg-active": { "$value": "{semantic.color.accent}", "$type": "color" },
      "fg-active": { "$value": "{semantic.color.on-accent}", "$type": "color" },
      "font-size": { "$value": "{primitive.fontSize.sm}", "$type": "dimension" }
    },
    "card": {
      "bg": { "$value": "{semantic.color.surface-raised}", "$type": "color" },
      "border": { "$value": "{semantic.color.line}", "$type": "color" },
      "radius": { "$value": "{primitive.radius.md}", "$type": "dimension" }
    },
    "popover": {
      "bg": { "$value": "{semantic.color.surface-overlay}", "$type": "color" },
      "border": { "$value": "{semantic.color.line}", "$type": "color" },
      "radius": { "$value": "{primitive.radius.md}", "$type": "dimension" },
      "shadow": { "$value": "{primitive.shadow.pop}", "$type": "shadow" }
    },
    "playerbar": {
      "height": { "$value": "{primitive.metric.player-height}", "$type": "dimension" },
      "bg": { "$value": "{semantic.color.surface}", "$type": "color" },
      "progress-height": { "$value": "3px", "$type": "dimension" },
      "progress-track": { "$value": "{primitive.color.alpha.16}", "$type": "color" },
      "progress-fill": { "$value": "{semantic.color.accent}", "$type": "color" }
    },
    "lyrics": {
      "line-fg": { "$value": "{primitive.color.alpha.40}", "$type": "color" },
      "line-active-fg": { "$value": "{semantic.color.text}", "$type": "color" },
      "line-fg-size": { "$value": "{primitive.fontSize.xl}", "$type": "dimension" },
      "line-active-size": { "$value": "{primitive.fontSize.3xl}", "$type": "dimension" }
    }
  }
}
