import { Tokens } from "tokens.slint";
import { I18n } from "i18n.slint";
// Actual composition diagrams, using the same six arrangements as Home.
export component HomePreview inherits Rectangle {
    in property <int> variant;
    in property <bool> selected;
    private property <string> layout-name: root.variant == 0 ? I18n.tr("Для вас") : root.variant == 1 ? I18n.tr("Компактний") : root.variant == 2 ? I18n.tr("Швидкий вибір") : root.variant == 3 ? I18n.tr("Відкривайте") : root.variant == 4 ? I18n.tr("Плейлісти") : I18n.tr("Виконавці");
    callback clicked();
    min-width: 0px;
    max-width: 100000px;
    preferred-width: 180px;
    horizontal-stretch: 1;
    height: 106px;
    border-radius: 12px;
    background: touch.has-hover || root.selected ? Tokens.neutral-150 : transparent;
    border-width: root.selected ? 1px : 0px;
    border-color: Tokens.brand-300;
    VerticalLayout {
        padding: 10px; spacing: 5px;
        Rectangle { height: 4px; width: 48px; border-radius: 2px; background: Tokens.brand-300.with-alpha(0.35); }
        if root.variant != 2: Rectangle {
            height: 30px;
            for i in [0,1,2,3]: Rectangle { x: i * (self.width + 4px); width: max(4px, min(root.variant == 1 ? 20px : root.variant == 3 ? 46px : 28px, (parent.width - 12px) / 4)); height: root.variant == 3 ? self.width * 9 / 16 : self.width; border-radius: root.variant == 5 ? self.width / 2 : 4px; background: Tokens.brand-300.with-alpha(0.18 + i * 0.05); }
        }
        VerticalLayout {
            spacing: 3px;
            for i in [0,1]: Rectangle { height: root.variant == 2 ? 10px : 4px; border-radius: 2px; background: Tokens.ink-300.with-alpha(0.3); }
        }
        Text { text: root.layout-name; color: root.selected ? Tokens.brand-300 : Tokens.ink-100; font-size: 12px; overflow: elide; vertical-alignment: bottom; vertical-stretch: 1; }
    }
    touch := TouchArea { mouse-cursor: pointer; clicked => {root.clicked();} }
    accessible-role: button;
    accessible-label: I18n.tr("Макет головної") + ": " + root.layout-name;
    accessible-action-default => {root.clicked();}
}
