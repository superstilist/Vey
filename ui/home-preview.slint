import { Tokens } from "tokens.slint";
// Actual composition diagrams, using the same six arrangements as Home.
export component HomePreview inherits Rectangle {
    in property <int> variant;
    in property <bool> selected;
    callback clicked();
    height: 106px;
    border-radius: 12px;
    background: touch.has-hover || root.selected ? Tokens.neutral-150 : transparent;
    border-width: root.selected ? 1px : 0px;
    border-color: Tokens.brand-300;
    VerticalLayout {
        padding: 10px; spacing: 5px;
        if root.variant == 0 || root.variant == 3: Rectangle { height: root.variant == 3 ? 30px : 18px; border-radius: 4px; background: Tokens.brand-300.with-alpha(0.35); }
        if root.variant != 2: HorizontalLayout {
            spacing: 4px;
            for i in [0,1,2,3]: Rectangle { height: root.variant == 1 ? 32px : 17px; border-radius: root.variant == 5 ? 12px : 4px; background: Tokens.brand-300.with-alpha(0.18 + i * 0.05); }
        }
        if root.variant != 1 && root.variant != 3: VerticalLayout {
            spacing: 3px;
            for i in [0,1]: Rectangle { height: 5px; border-radius: 2px; background: Tokens.ink-300.with-alpha(0.3); }
        }
        Text { text: root.variant == 0 ? "Editorial" : root.variant == 1 ? "Gallery" : root.variant == 2 ? "Compact" : root.variant == 3 ? "Spotlight" : root.variant == 4 ? "Library" : "Discovery"; color: root.selected ? Tokens.brand-300 : Tokens.ink-100; font-size: 12px; vertical-alignment: bottom; vertical-stretch: 1; }
    }
    touch := TouchArea { mouse-cursor: pointer; clicked => {root.clicked();} }
    accessible-role: button;
    accessible-label: "Home layout " + (root.variant + 1);
    accessible-action-default => {root.clicked();}
}
