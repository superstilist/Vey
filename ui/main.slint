import { I18n } from "i18n.slint";
import { HomePreview } from "home-preview.slint";
import { Motion } from "motion.slint";
import "../assets/fonts/Roboto.ttf";
import "../assets/fonts/NotoSansJP.ttf";
import { LineEdit, ListView, ScrollView, Palette, ComboBox, TextEdit } from "std-widgets.slint";
import { WordRow, LyricRow } from "lyric-types.slint";
export { WordRow, LyricRow } from "lyric-types.slint";
import { MediaSlot } from "media-slot.slint";
import { LyricsSettings } from "lyrics-settings.slint";
import { LyricThemePreset } from "lyric-theme-picker.slint";
import { LyricAppearance } from "lyric-appearance.slint";
export { LyricThemePreset } from "lyric-theme-picker.slint";
import { BraccatoLyrics } from "braccato-lyrics.slint";
import { NativeLyrics, LyricStyle } from "native-lyrics.slint";
import { BraccatoRow, LyricWord as BraccatoWord, LyricGlyph as BraccatoGlyph, InstrumentalFrames as BraccatoInstrumental } from "@braccato/lyrics.slint";
export { BraccatoRow, LyricWord as BraccatoWord, LyricGlyph as BraccatoGlyph, InstrumentalFrames as BraccatoInstrumental } from "@braccato/lyrics.slint";
import { Tokens } from "tokens.slint";
export { I18n } from "i18n.slint";
export { Motion } from "motion.slint";
export { Tokens } from "tokens.slint";
import { PlayerTheme, PlayerThemeStyle } from "player-theme.slint";
export { PlayerTheme, PlayerThemeStyle } from "player-theme.slint";
export { CoverBadges } from "controls.slint";
import { StageNavigator } from "stage-navigator.slint";
import { NavigationStreaks } from "navigation-streaks.slint";
import { TouchStyle, CoverBadges, Action, SongRow, NavItem, Artwork, Transport, SeekBar, TonalSlider, MobileNavItem, SettingsRow, SwitchRow, SectionLabel, PlaylistChoice } from "controls.slint";

export struct TrackRow { title: string, artist: string, album: string, duration: string, path: string, art: image, liked: bool, downloaded: bool, downloading: bool }
export struct PlaylistRow { id: string, name: string, detail: string, art: image }


export component MainWindow inherits Window {
    in-out property <int> home-layout;
    in-out property <bool> home-rotate;
    callback home-choose(int);
    in-out property <bool> music-supported;
    in-out property <int> music-provider;
    in-out property <int> connection-provider;
    in-out property <string> music-client-id;
    in-out property <string> music-client-secret;
    in-out property <string> music-link;
    in-out property <string> music-status;
    in-out property <string> youtube-account;
    in-out property <string> spotify-account;
    in-out property <bool> music-busy;
    in-out property <bool> music-auto-sync;
    callback music-command(string);
    title: "Vey";
    in-out property <string> account-api;
    in-out property <string> account-email;
    in-out property <string> account-password;
    in-out property <string> account-name;
    in-out property <string> account-nickname;
    in-out property <string> account-bio;
    in-out property <string> account-discord;
    in-out property <string> account-created-at;
    in-out property <image> account-avatar;
    in-out property <string> account-current-password;
    in-out property <string> account-new-password;
    in-out property <string> account-status;
    in-out property <string> account-verification-url;
    in-out property <string> account-verification-page;
    in-out property <string> account-user-code;
    in-out property <image> account-qr;
    in-out property <int> account-seconds-left;
    in-out property <bool> account-signed-in;
    in-out property <bool> account-manual;
    in-out property <bool> account-premium;
    in-out property <bool> account-busy;
    in-out property <bool> account-auto-sync: true;
    in-out property <bool> account-auto-upload;
    in-out property <[string]> account-local-files;
    in-out property <[string]> account-cloud-files;
    in-out property <int> account-local-index;
    in-out property <int> account-cloud-index;
    callback account-command(string);

    init => { Palette.color-scheme = ColorScheme.dark; TouchStyle.mobile = root.mobile; }
    icon: @image-url("../assets/vey-logo-transparent.png");
    preferred-width: 1440px;
    preferred-height: 900px;
    min-width: 320px;
    min-height: root.mobile ? 240px : 560px;
    background: root.navigation-capture ? transparent : Tokens.neutral-0;
    default-font-family: I18n.language == "ja" ? "Noto Sans JP" : PlayerTheme.family;
    default-font-size: 14px;

    in-out property <string> active-view: "home";
    in-out property <string> app-version;
    // Route motion moves only page content; the background and player host stay fixed.
    out property <string> displayed-view: "home";
    // Every page has a fixed world position; one camera moves between them.
    private property <int> page-phase: 1; // 1: settled, 2: travel, 3: capture
    private property <float> camera-target-x: 0;
    private property <float> camera-target-y: 0;
    private property <float> camera-x: root.camera-target-x;
    private property <float> camera-y: root.camera-target-y;
    out property <int> camera-epoch: 0;
    out property <float> camera-start-x: 0;
    out property <float> camera-start-y: 0;
    out property <float> camera-end-x: root.camera-target-x;
    out property <float> camera-end-y: root.camera-target-y;
    out property <int> camera-duration: 160;
    out property <bool> camera-travelling: root.page-phase == 2;
    out property <float> stage-width: content.width / 1px;
    out property <float> stage-height: content.height / 1px;
    out property <float> stage-x: content.x / 1px;
    out property <float> stage-y: content.y / 1px;
    out property <float> stage-radius: PlayerTheme.enabled ? PlayerTheme.corner : root.mobile ? 20 : 28;
    in-out property <bool> navigation-capture: false;
    // Diagnostic compatibility path. Normal navigation presents live surfaces.
    in-out property <bool> navigation-snapshot-fx: false;
    in-out property <bool> navigation-capture-target: false;
    in-out property <bool> navigation-fx-ready: false;
    in-out property <image> navigation-from-image;
    in-out property <image> navigation-to-image;
    callback capture-navigation();
    private property <float> navigation-distance: max(abs(root.camera-end-x - root.camera-start-x), abs(root.camera-end-y - root.camera-start-y));
    out property <float> navigation-progress: root.navigation-distance < 0.001 ? 1 : clamp(max(abs(root.camera-x - root.camera-start-x), abs(root.camera-y - root.camera-start-y)) / root.navigation-distance, 0, 1);
    out property <float> navigation-pulse: root.camera-travelling && !root.lyrics-reduced-motion && !root.navigation-capture ? 4 * root.navigation-progress * (1 - root.navigation-progress) : 0;
    private property <float> navigation-fx-opacity: root.navigation-fx-ready ? 1 : 0;
    animate navigation-fx-opacity {duration: root.lyrics-reduced-motion ? 0ms : 80ms; easing: ease-in-out;}
    private property <float> navigation-blend: root.navigation-blur && root.navigation-fx-ready ? root.navigation-pulse * root.navigation-fx-opacity : 0;
    animate camera-x { duration: root.lyrics-reduced-motion || root.mobile-sheet ? 0ms : root.camera-duration * 1ms; easing: cubic-bezier(0.2, 0, 0, 1); }
    animate camera-y { duration: root.lyrics-reduced-motion || root.mobile-sheet ? 0ms : root.camera-duration * 1ms; easing: cubic-bezier(0.2, 0, 0, 1); }
    out property <float> player-motion-x: root.mobile ? 0 : (1 - root.camera-x) * content.width / 1px;
    out property <float> player-motion-y: root.mobile ? (1 - root.mobile-player-progress) * 48 : (-1 - root.camera-y) * content.height / 1px;
    out property <bool> page-moving: root.page-phase != 1 || (root.mobile && root.mobile-player-progress > 0.001 && root.mobile-player-progress < 0.999);
    in-out property <[TrackRow]> home-page-tracks;
    in-out property <[TrackRow]> home-recommendation-tracks;
    in-out property <bool> home-recommendation-loading;
    in-out property <bool> home-recommendation-failed;
    in-out property <bool> home-recommendation-personalized;
    in-out property <[TrackRow]> explore-page-tracks;
    in-out property <[TrackRow]> library-page-tracks;
    in-out property <[TrackRow]> liked-page-tracks;
    in-out property <[TrackRow]> playlist-page-tracks;
    in-out property <[TrackRow]> queue-page-tracks;
    in-out property <[TrackRow]> search-page-tracks;
    in-out property <[TrackRow]> settings-page-tracks;
    in-out property <bool> pages-seeded: false;
    private property <int> warm-page: 1;
    out property <bool> player-on-stage: root.mobile ? root.mobile-sheet : abs(1 - root.camera-x) < 1 && abs(-1 - root.camera-y) < 1;
    function stage-navigate(column: int, row: int) {
        let route = row < 0 ? (column < 0 ? "search" : column > 0 ? "lyrics" : "settings") : row > 0 ? (column < 0 ? "playlist" : column > 0 ? "library" : "liked") : (column < 0 ? "queue" : column > 0 ? "explore" : "home");
        if route == "playlist" && root.playlists.length > 2 { root.open-playlist(root.playlists[2].id); }
        else { root.navigate(route); }
    }
    // Warm one viewport at a time, yielding to input and camera movement.
    Timer {
        interval: 120ms;
        running: root.warm-page < 9 && root.page-phase == 1 && !root.colors-changing;
        triggered => { root.warm-page += 1; }
    }
    pure function page-column(view: string) -> int {
        return view == "explore" || view == "library" || view == "lyrics" ? 1 : view == "playlist" || view == "queue" || view == "search" ? -1 : 0;
    }
    pure function page-row(view: string) -> int {
        return view == "library" || view == "liked" || view == "playlist" ? 1 : view == "search" || view == "settings" || view == "lyrics" ? -1 : 0;
    }
    function finish-travel() {
        root.displayed-view = root.active-view;
        root.page-phase = 1;
    }
    function prepare-travel() {
        if !root.navigation-snapshot-fx { root.start-travel(); return; }
        // Hold the current presentation during readback, including retargets.
        root.camera-start-x = root.camera-x;
        root.camera-start-y = root.camera-y;
        root.camera-target-x = root.camera-start-x;
        root.camera-target-y = root.camera-start-y;
        root.capture-navigation();
        // Capture restored both layouts synchronously; start on this tick.
        root.start-travel();
    }
    function start-travel() {
        root.camera-start-x = root.camera-x;
        root.camera-start-y = root.camera-y;
        root.camera-duration = round(clamp(Motion.navigation-min + max(abs(root.page-column(root.active-view) - root.camera-start-x), abs(root.page-row(root.active-view) - root.camera-start-y)) * Motion.navigation-distance, Motion.navigation-min, Motion.navigation-max));
        root.camera-target-x = root.page-column(root.active-view);
        root.camera-target-y = root.page-row(root.active-view);
        root.camera-epoch += 1;
        root.displayed-view = root.active-view;
        root.page-phase = 2;
        if root.lyrics-reduced-motion || root.navigation-distance < 0.001 { root.finish-travel(); }
        else { travel-finish.restart(); }
    }
    changed tracks => {
        if root.active-view == "home" { root.home-page-tracks = root.tracks; }
        else if root.active-view == "explore" { root.explore-page-tracks = root.tracks; }
        else if root.active-view == "library" { root.library-page-tracks = root.tracks; }
        else if root.active-view == "liked" { root.liked-page-tracks = root.tracks; }
        else if root.active-view == "playlist" { root.playlist-page-tracks = root.tracks; }
        else if root.active-view == "queue" { root.queue-page-tracks = root.tracks; }
        else if root.active-view == "search" { root.search-page-tracks = root.tracks; }
        else if root.active-view == "settings" { root.settings-page-tracks = root.tracks; }
    }
    changed active-view => {
        root.search-focus-pending = root.active-view == "search";
        root.player-tools = false;
        if root.mobile && root.active-view == "lyrics" {
            root.camera-target-x = root.page-column(root.mobile-underlay);
            root.camera-target-y = root.page-row(root.mobile-underlay);
            root.displayed-view = "lyrics";
            root.page-phase = 1;
        } else if root.mobile && root.mobile-sheet && root.active-view == root.mobile-underlay {
            root.displayed-view = root.active-view;
            root.page-phase = 1;
        } else {
            if root.active-view != "lyrics" { root.mobile-underlay = root.active-view; }
            if root.lyrics-reduced-motion {
                root.page-phase = 3;
                root.start-travel();
            } else {
                root.page-phase = 3;
                root.prepare-travel();
            }
        }
    }
    travel-finish := Timer {
        interval: root.camera-duration * 1ms;
        running: root.page-phase == 2;
        triggered => { root.finish-travel(); }
    }
    changed lyrics-reduced-motion => {
        Motion.reduced = root.lyrics-reduced-motion;
        root.artwork-theme();
        if root.lyrics-reduced-motion && root.page-phase != 1 { root.start-travel(); }
    }
    in-out property <string> settings-section;
    pure function settings-name(section: string) -> string {
        return section == "account" ? I18n.tr("Акаунт Vey") : section == "language" ? I18n.tr("Мова інтерфейсу") : section == "appearance" ? I18n.tr("Вигляд") : section == "audio" ? I18n.tr("Відтворення") : section == "lyrics" ? I18n.tr("Слова пісень") : section == "library" ? I18n.tr("Бібліотека") : section == "data" ? I18n.tr("Дані та вхід") : section == "about" ? I18n.tr("Про застосунок") : I18n.tr("Налаштування");
    }
    public function open-settings(section: string) {
        root.settings-section = section;
    }
    function navigate-settings() {
        if root.active-view == "settings" { root.open-settings(""); }
        else { root.navigate("settings"); }
    }
    in-out property <string> search-query;
    private property <bool> search-focus-pending;
    Timer {
        interval: 16ms;
        running: root.search-focus-pending && !root.immersive && root.dialog == "";
        triggered => { root.search-focus-pending = false; search-input.focus(); }
    }
    in-out property <string> current-track-key;
    in-out property <string> current-video-id;
    in-out property <string> current-clip-video-id;
    in-out property <image> video-frame;
    in-out property <bool> video-ready;
    in-out property <bool> video-muted: true;
    in-out property <float> video-position: -1;
    in-out property <float> video-x;
    in-out property <float> video-y;
    in-out property <float> video-width;
    in-out property <float> video-height;
    in-out property <string> current-title: I18n.tr("Нічого не грає");
    in-out property <string> current-artist: I18n.tr("Виберіть пісню");
    in-out property <string> current-album: "";
    in-out property <image> current-art;
    callback artwork-theme();
    changed current-art => { root.artwork-theme(); }
    in-out property <string> color-mode: "dynamic";
    in-out property <float> color-hue: 85;
    changed color-mode => { root.artwork-theme(); }
    changed color-hue => { root.artwork-theme(); }
    callback appearance-changed(string, float);
    in-out property <bool> colors-changing: false;
    in-out property <float> kawarp-opacity: 0.28;
    in-out property <float> kawarp-warp: 1;
    in-out property <float> kawarp-blur: 15;
    in-out property <float> kawarp-saturation: 1.5;
    in-out property <float> kawarp-dithering: 0.02;
    in-out property <bool> kawarp-dim: true;
    callback preferences-changed();
    out property <float> ambient-opacity: !PlayerTheme.enabled && root.color-mode == "static" ? 0 : root.kawarp-opacity * PlayerTheme.ambient;
    animate ambient-opacity { duration: Motion.palette; easing: cubic-bezier(0.45, 0, 0.55, 1); }
    in-out property <image> ambient-frame;
    in-out property <string> player-state: "stopped";
    in-out property <bool> current-liked;
    in-out property <bool> current-downloaded;
    in-out property <bool> current-downloading;
    in-out property <bool> current-local;
    in-out property <bool> native-file-tools;
    in-out property <float> position;
    in-out property <float> duration;
    in-out property <string> time-label: "0:00 / 0:00";
    in-out property <float> volume: 1;
    in-out property <float> rate: 1;
    in-out property <bool> shuffle;
    in-out property <string> repeat-mode: "off";
    in-out property <string> art-mode: "cover";
    in-out property <string> status;
    in-out property <[TrackRow]> tracks;
    in-out property <[TrackRow]> queue-tracks;
    in-out property <[PlaylistRow]> playlists;
    in-out property <[PlaylistRow]> playlist-destinations;
    in-out property <bool> adding-to-new-playlist: false;
    in-out property <[string]> sources;
    in-out property <string> playlist-title: I18n.tr("Список відтворення");
    in-out property <string> playlist-detail;
    in-out property <image> playlist-art;
    in-out property <bool> playlist-public;
    in-out property <[LyricRow]> lyric-lines;
    in-out property <bool> lyrics-timed: true;
    in-out property <bool> lyrics-word-timed: true;
    in-out property <string> lyrics-credits;
    in-out property <string> lyrics-document;
    in-out property <bool> native-lyrics: false;
    in-out property <[BraccatoRow]> native-lyric-lines;
    in-out property <[float]> native-focus-values;
    in-out property <[BraccatoRow]> native-render-lines;
    in-out property <int> native-render-start: 0;
    in-out property <int> native-preload-line: -1;
    in-out property <int> native-seek-revision: 0;
    in-out property <int> native-render-end: -1;
    in-out property <float> native-render-top: 0;
    in-out property <float> native-render-bottom: 0;
    in-out property <BraccatoInstrumental> native-instrumental;
    in-out property <int> native-active-line: -1;
    in-out property <float> native-scroll-position;
    in-out property <float> native-passive-progress;
    in-out property <bool> native-scroll-snap;
    in-out property <bool> native-camera-driven;
    in-out property <float> native-camera-position;
    in-out property <float> native-content-y;
    in-out property <float> native-content-height;
    callback native-lyric-seek(int, int);
    in-out property <bool> lyrics-web-ready;
    in-out property <bool> lyrics-web-required;
    in-out property <string> lyrics-renderer-error;
    in-out property <int> lyrics-renderer-generation;
    out property <float> backdrop-x: 0;
    out property <float> backdrop-y: 0;
    out property <float> backdrop-width: root.width / 1px;
    out property <float> backdrop-height: root.height / 1px;
    out property <bool> tools-visible: tools-panel.visible;
    out property <float> tools-x: (content.x + tools-panel.x) / 1px;
    out property <float> tools-y: (content.y + tools-panel.y) / 1px;
    out property <float> tools-width: tools-panel.width / 1px;
    out property <float> tools-height: tools-panel.height / 1px;
    in-out property <float> lyrics-widget-x;
    in-out property <float> lyrics-widget-y;
    in-out property <float> lyrics-widget-width;
    in-out property <float> lyrics-widget-height;
    in-out property <float> lyrics-editor-x;
    in-out property <float> lyrics-editor-y;
    in-out property <float> lyrics-editor-width;
    in-out property <float> lyrics-editor-height;
    in-out property <bool> lyrics-stage: false;
    in-out property <bool> lyrics-passive-scroll: false;
    callback lyric-mode-changed(bool,bool,bool);
    in-out property <bool> lyrics-reduced-motion: false;
    in-out property <bool> navigation-blur: true;
    in-out property <bool> lyrics-romanization: true;
    in-out property <bool> lyrics-translation: true;
    in-out property <float> lyrics-secondary-gap: 0.65;
    in-out property <string> lyrics-translation-language: "auto";
    in-out property <string> lyrics-enrichment-status;
    in-out property <bool> lyrics-user-scrolling: false;
    in-out property <float> lyrics-scroll-ratio: 0.37;
    in-out property <int> lyrics-lookahead-ms: 0;
    in-out property <int> lyrics-scroll-offset-ms: 0;
    in-out property <int> lyrics-ending-threshold-ms: 0;
    in-out property <int> lyrics-scroll-duration-ms: 750;
    in-out property <float> lyrics-passive-seconds: 3.5;
    in-out property <bool> lyrics-disable-richsync: false;
    in-out property <int> lyrics-richsync-offset-ms;
    in-out property <int> lyrics-line-offset-ms;
    in-out property <int> lyrics-effective-offset-ms;
    callback lyric-user-scroll();
    callback lyric-resume();
    callback lyric-geometry(int, float, float);
    in-out property <float> lyrics-viewport-height;
    in-out property <float> lyrics-scroll-target;
    in-out property <int> active-lyric-index: -1;
    in-out property <int> lyrics-position;
    in-out property <int> lyrics-offset;
    in-out property <string> lyrics-status: I18n.tr("Виберіть пісню, щоб побачити слова");
    in-out property <[string]> providers;
    in-out property <int> provider-index;
    in-out property <string> lyrics-provider: "auto";
    in-out property <float> lyric-size: 48;
    // Set once from the actual native renderer, including automatic GPU fallback.
    in-out property <bool> native-text-gradients: true;
    in-out property <color> lyric-active: Tokens.ink-100;
    in-out property <color> lyric-inactive: Tokens.ink-300;
    in-out property <int> lyric-weight: 700;
    in-out property <string> lyric-theme-source;
    in-out property <string> lyric-theme-applied;
    in-out property <string> lyric-font-family;
    in-out property <string> lyric-font-applied;
    in-out property <bool> theme-entire-player: true;
    in-out property <bool> theme-entire-player-draft: true;
    in-out property <PlayerThemeStyle> player-theme-style;
    in-out property <PlayerThemeStyle> player-theme-draft;
    changed theme-entire-player-draft => { root.preview-lyric-style(); }
    changed player-theme-style => {
        PlayerTheme.enabled = root.player-theme-style.enabled;
        PlayerTheme.corner = root.player-theme-style.enabled ? root.player-theme-style.corner : 28;
        PlayerTheme.artwork-corner = root.player-theme-style.enabled ? root.player-theme-style.artwork-corner : 24;
        PlayerTheme.control-corner = root.player-theme-style.enabled ? root.player-theme-style.control-corner : 999;
        PlayerTheme.artwork-share = root.player-theme-style.enabled ? root.player-theme-style.artwork-share : 0.43;
        PlayerTheme.ambient = root.player-theme-style.enabled ? root.player-theme-style.ambient : 1;
        PlayerTheme.motion-ms = root.player-theme-style.enabled ? root.player-theme-style.motion-ms : 1000;
        PlayerTheme.family = root.player-theme-style.enabled ? root.player-theme-style.family : "Roboto";
        root.artwork-theme();
    }
    in-out property <string> lyric-style-status;
    in-out property <[LyricThemePreset]> lyric-theme-presets;
    in-out property <[string]> lyric-theme-names;
    in-out property <int> lyric-preset-index;
    in-out property <LyricStyle> lyric-draft-style;
    in-out property <float> lyric-draft-size: 48;
    in-out property <int> lyric-draft-weight: 700;
    in-out property <color> lyric-draft-active;
    in-out property <color> lyric-draft-inactive;
    in-out property <bool> lyric-draft-valid: true;
    in-out property <[BraccatoRow]> lyric-preview-rows;
    callback preview-lyric-style();
    callback adjust-lyric-style(string, float);
    callback adjust-player-color(string,color);
    callback lyric-preview-paint();
    private property <bool> lyric-preview-pending;
    changed lyric-theme-source => { root.lyric-preview-pending = true; }
    changed lyric-font-family => { root.lyric-preview-pending = true; }
    Timer {
        interval: 120ms; running: root.dialog == "lyric-style" && root.lyric-preview-pending;
        triggered => { root.lyric-preview-pending = false; root.preview-lyric-style(); }
    }
    callback select-lyric-preset(int);
    select-lyric-preset(index) => {
        if index >= 0 && index < root.lyric-theme-presets.length - 1 {
            root.lyric-preset-index = index;
            root.lyric-theme-source = root.lyric-theme-presets[index].css;
        } else {
            root.lyric-preset-index = max(0, root.lyric-theme-presets.length - 1);
        }
        root.preview-lyric-style();
        root.lyric-preview-pending = false;
    }
    in-out property <LyricStyle> lyric-style: {family:"Satoshi",glow-color:#ffffff50,glow-radius:6,glow-duration:1200,
        glow:true,swipe:true,wave:false,wobble:true,wobble-duration:1000,wobble-strength:1,fade:true,inactive-blur:2,line-spacing:1.333,active-scale:1,inactive-scale:0.95,
        swipe-duration:1.6,swipe-lead:0.1,wave-duration:900};
    callback apply-lyric-style();
    callback import-lyric-font();
    in-out property <bool> lyric-font-import-supported: false;
    in-out property <string> lyrics-paste;
    in-out property <string> jwt-status: I18n.tr("Потрібна перевірка");
    in-out property <bool> sidebar-collapsed;
    in-out property <bool> focus-player: false;
    in-out property <bool> expanded-player: false;
    out property <string> mobile-underlay: "home";
    private property <float> mobile-player-progress: root.mobile && root.active-view == "lyrics" ? 1 : 0;
    private property <bool> mobile-sheet: root.mobile && (root.active-view == "lyrics" || root.mobile-player-progress > 0.001);
    animate mobile-player-progress { duration: Motion.sheet; easing: cubic-bezier(0.2, 0, 0, 1); }
    out property <float> player-reveal: root.mobile ? root.mobile-player-progress : 1;
    function close-player() { root.focus-player = false; root.expanded-player = false; root.navigate(root.mobile ? root.mobile-underlay : "home"); }
    private property <length> sheet-press-x;
    private property <length> sheet-press-y;
    private property <bool> sheet-pointer-active: false;

    in-out property <bool> player-tools: false;
    in-out property <string> player-tab: "lyrics";
    private property <bool> immersive: root.mobile ? root.mobile-sheet : root.displayed-view == "lyrics" && root.focus-player;
    private property <bool> expanded-active: !root.mobile && root.displayed-view == "lyrics" && root.expanded-player && !root.focus-player;

    pure function chip-label(chip: string) -> string {
        return chip == "all" ? I18n.tr("Всі") : chip == "for-you" ? I18n.tr("Для вас") : chip == "focus" ? I18n.tr("Зосередження") : chip == "relax" ? I18n.tr("Відпочинок") : I18n.tr("Енергія");
    }
    pure function language-code(index: int) -> string {
        return index == 1 ? "en" : index == 2 ? "cs" : index == 3 ? "pl" : index == 4 ? "de" : index == 5 ? "es" : index == 6 ? "fr" : index == 7 ? "ja" : "uk";
    }
    pure function language-name(code: string) -> string {
        return code == "en" ? "English" : code == "cs" ? "Čeština" : code == "pl" ? "Polski" : code == "de" ? "Deutsch" : code == "es" ? "Español" : code == "fr" ? "Français" : code == "ja" ? "日本語" : "Українська";
    }
    pure function clock(seconds: float) -> string {
        return floor(max(0, seconds) / 60) + ":" + (Math.mod(floor(max(0, seconds)), 60) < 10 ? "0" : "") + Math.mod(floor(max(0, seconds)), 60);
    }

    private property <length> bottom-dock-height: root.mobile ? (root.compact-height ? 104px : 112px) : 72px;
    private property <length> bottom-reserve: root.bottom-dock-height + 8px;
    private property <length> page-viewport-height: root.height - (root.compact-height ? 52px : 64px) - root.bottom-reserve - (root.compact-height ? 4px : 8px) - (root.safe-top + root.safe-bottom) * 1px;
    private property <bool> compact-height: root.height - (root.safe-top + root.safe-bottom) * 1px < 500px;
    in property <bool> android-platform: false;
    in-out property <bool> mobile: root.width - (root.safe-left + root.safe-right) * 1px < 800px || (root.android-platform && root.height < 600px);
    // Native Android insets include status/navigation bars and display cutouts.
    // Browser code can still supply CSS safe-area values through these properties.
    in-out property <float> safe-top: root.safe-area-insets.top / 1px;
    in-out property <float> safe-bottom: root.safe-area-insets.bottom / 1px;
    in-out property <float> safe-left: root.safe-area-insets.left / 1px;
    in-out property <float> safe-right: root.safe-area-insets.right / 1px;
    changed mobile => {
        TouchStyle.mobile = root.mobile;
        if root.active-view == "lyrics" {
            if root.mobile {
                root.camera-target-x = root.page-column(root.mobile-underlay);
                root.camera-target-y = root.page-row(root.mobile-underlay);
                root.page-phase = 1;
            } else { root.start-travel(); }
        }
    }

    in-out property <string> dialog;
    in-out property <string> source-kind: "folder";
    private property <string> new-name;
    private property <string> selected-chip: "all";

    callback navigate(string);
    callback search(string);
    callback search-edited(string);
    callback select-track(int);
    callback play-toggle();
    callback previous-track();
    callback next-track();
    callback seek-to(int);
    callback volume-changed(float);
    callback toggle-like(int);
    callback toggle-shuffle();
    callback toggle-repeat();
    callback change-art-mode();
    callback add-path(string, string);
    callback scan();
    callback refresh-explore();
    callback request-home-recommendations();
    callback select-home-recommendation(int);
    callback play-home-recommendations();
    callback add-source(string);
    callback remove-source(int);
    callback create-playlist(string);
    callback open-playlist(string);
    callback play-playlist(string);
    callback add-to-playlist(string);
    callback remove-from-playlist(int);
    callback delete-playlist();
    callback set-playlist-public(bool);
    callback refresh-lyrics();
    callback request-lyrics();
    callback choose-provider(int);
    callback adjust-offset(int);
    callback provider-changed(string);
    callback import-lyrics(string);
    callback copy-lyrics();
    in-out property <string> match-title;
    in-out property <string> match-artist;
    in-out property <string> match-album;
    callback apply-tags(string, string, string);
    callback download(int);
    callback choose-cover();
    callback save-cover();
    callback radio();
    callback sync-tags();
    callback restore-tags();
    callback migrate();
    callback backup();
    callback restore();
    callback open-login();
    callback open-challenge();
    callback submit-auth(string);
    private property <string> auth-token;
    changed dialog => {
        if root.dialog == "lyric-style" {
            root.lyric-theme-source = root.lyric-theme-applied;
            root.lyric-font-family = root.lyric-font-applied;
            root.theme-entire-player-draft = root.theme-entire-player;
            root.preview-lyric-style();
            root.lyric-preview-pending = false;
        }
        if root.dialog != "auth" { root.auth-token = ""; }
        if root.dialog != "connections" { root.music-client-secret = ""; }
        if root.dialog != "create" && root.dialog != "add" { root.adding-to-new-playlist = false; }
    }
    callback clear-history();

    // Top Navigation Bar
    Rectangle {
        x: root.safe-left * 1px; y: root.safe-top * 1px; height: root.compact-height ? 52px : 64px; width: root.width - (root.safe-left + root.safe-right) * 1px;
        visible: !root.immersive && !root.expanded-active;
        background: Tokens.neutral-0;

        HorizontalLayout {
            x: 0px; y: 0px; width: 100%; height: 100%;
            padding-left: root.mobile ? 12px : 16px; padding-right: root.mobile ? 12px : 16px; padding-top: root.compact-height ? 4px : 10px; padding-bottom: root.compact-height ? 4px : 10px;
            spacing: 12px;
            if !root.mobile: Action {
                icon: @image-url("../assets/icons/Menu.svg");
                label: I18n.tr("Меню");
                clicked => { root.sidebar-collapsed = !root.sidebar-collapsed; }
            }
            if !root.mobile: HorizontalLayout {
                spacing: 10px;
                alignment: start;
                width: root.sidebar-collapsed ? 110px : 184px;
                VerticalLayout {
                    alignment: center;
                    Rectangle {
                        width: 28px; height: 28px; border-radius: 8px; clip: true;
                        Image { source: @image-url("../assets/vey-logo-transparent.png"); width: 100%; height: 100%; image-fit: contain; }
                        TouchArea { mouse-cursor: pointer; clicked => { root.navigate("home"); } }
                        accessible-role: button; accessible-label: I18n.tr("Vey · Головна");
                        accessible-action-default => { root.navigate("home"); }
                    }
                }
                if !root.mobile: Text {
                    text: "Vey";
                    color: Tokens.ink-100;
                    font-size: 21px;
                    font-weight: 700;
                    vertical-alignment: center;
                }
            }
            Rectangle {
                horizontal-stretch: 1;
                max-width: root.mobile ? root.width : 560px;
                forward-focus: search-input;
                TouchArea {
                    mouse-cursor: text;
                    clicked => { search-input.focus(); }
                }
                height: root.mobile ? 44px : 42px;
                border-radius: root.mobile ? 16px : 21px;
                background: Tokens.neutral-100;
                border-width: 0px;
                border-color: #ffffff18;
                HorizontalLayout {
                    padding-left: root.mobile ? 0px : 16px; padding-right: root.mobile ? 0px : 6px; spacing: root.mobile ? 0px : 10px;
                    if root.mobile: Action {
                        comfortable: true;
                        icon: @image-url("../assets/icons/Search.svg");
                        label: I18n.tr("Пошук музики");
                        clicked => { root.search(root.search-query); }
                    }
                    if !root.mobile: VerticalLayout {
                        alignment: center;
                        Image {
                            source: @image-url("../assets/icons/Search.svg");
                            width: 18px; height: 18px;
                            colorize: Tokens.ink-200;
                        }
                    }
                    Rectangle {
                        horizontal-stretch: 1;
                        if root.search-query == "": Text {
                            text: root.mobile ? I18n.tr("Пошук музики") : I18n.tr("Шукати пісні, альбоми, виконавців, подкасти");
                            color: Tokens.ink-300;
                            width: 100%; height: 100%;
                            vertical-alignment: center;
                            font-size: root.mobile ? 16px : 14px;
                            overflow: elide;
                        }
                        search-input := TextInput {
                            accessible-label: I18n.tr("Пошук музики");
                            text <=> root.search-query;
                            width: 100%; height: 100%;
                            color: Tokens.ink-100;
                            font-size: root.mobile ? 16px : 14px;
                            vertical-alignment: center;
                            single-line: true;
                            edited => { root.search-edited(self.text); }
                            accepted => { root.search(self.text); }
                        }
                    }
                    // Keep the input's width and IME geometry stable on the first key.
                    VerticalLayout {
                        width: root.mobile ? 44px : 36px;
                        alignment: center;
                        Action {
                            comfortable: root.mobile;
                            visible: root.search-query != "";
                            icon: @image-url("../assets/icons/X.svg");
                            label: I18n.tr("Очистити пошук");
                            clicked => { root.search-query = ""; root.search(""); search-input.focus(); }
                        }
                    }
                }
            }

            if !root.mobile: Rectangle { horizontal-stretch: 1; }
            if !root.mobile: Action {
                icon: @image-url("../assets/icons/Radio.svg");
                label: I18n.tr("Радіо за треком");
                clicked => { root.radio(); }
            }
            if !root.mobile: Action {
                text: I18n.tr("Підключені акаунти");
                icon: @image-url("../assets/icons/User.svg");
                outlined: true;
                clicked => { root.dialog = "connections"; }
            }
        }
    }

    // Left Navigation Rail / Sidebar
    Rectangle {
        x: root.safe-left * 1px; y: 64px + root.safe-top * 1px;
        width: root.mobile ? 0px : root.sidebar-collapsed ? 72px : 240px;
        height: root.height - 136px - (root.safe-top + root.safe-bottom) * 1px;
        visible: !root.mobile && !root.immersive && !root.expanded-active;
        background: Tokens.neutral-0;

        VerticalLayout {
            x: 0px; y: 0px; width: 100%; height: 100%;
            padding-left: 12px; padding-right: 12px; padding-top: 12px; padding-bottom: 12px;
            spacing: 4px;
            NavItem { text: I18n.tr("Головна"); icon: @image-url("../assets/icons/House.svg"); selected: root.displayed-view == "home"; collapsed: root.sidebar-collapsed; clicked => { root.navigate("home"); } }
            NavItem { text: I18n.tr("Огляд"); icon: @image-url("../assets/icons/Compass.svg"); selected: root.displayed-view == "explore"; collapsed: root.sidebar-collapsed; clicked => { root.navigate("explore"); } }
            NavItem { text: I18n.tr("Бібліотека"); icon: @image-url("../assets/icons/Library.svg"); selected: root.displayed-view == "library"; collapsed: root.sidebar-collapsed; clicked => { root.navigate("library"); } }
            NavItem { text: I18n.tr("Сподобалось"); icon: @image-url("../assets/icons/Heart.svg"); selected: root.displayed-view == "liked"; collapsed: root.sidebar-collapsed; clicked => { root.navigate("liked"); } }
            NavItem { text: I18n.tr("Налаштування"); icon: @image-url("../assets/icons/Settings.svg"); selected: root.displayed-view == "settings"; collapsed: root.sidebar-collapsed; clicked => { root.navigate-settings(); } }
            Rectangle { height: 8px; }
            if !root.sidebar-collapsed: Action {
                text: I18n.tr("Новий список");
                icon: @image-url("../assets/icons/Plus.svg");
                outlined: true;
                clicked => { root.dialog = "create"; }
            }
            if root.sidebar-collapsed: Action {
                icon: @image-url("../assets/icons/Plus.svg");
                label: I18n.tr("Новий список відтворення");
                outlined: true;
                clicked => { root.dialog = "create"; }
            }
            Rectangle { height: 12px; }

            Rectangle { height: 6px; }
            if !root.sidebar-collapsed: ListView {
                vertical-stretch: 1;
                for item in root.playlists: pl-row := Rectangle {
                    height: 64px;
                    border-radius: 8px;
                    background: pl-touch.has-hover ? #ffffff10 : transparent;
                    HorizontalLayout {
                        padding-left: 8px; padding-right: 8px; spacing: 10px; alignment: center;
                        Rectangle { width: 42px; height: 42px; border-radius: 7px; clip: true; background: Tokens.neutral-150;
                            Image { source: @image-url("../assets/icons/Music2.svg"); width: 18px; height: 18px; x: 12px; y: 12px; colorize: Tokens.ink-300; }
                            Image { source: item.art; width: 100%; height: 100%; image-fit: cover; }
                        }
                        VerticalLayout { horizontal-stretch: 1; min-width: 0px;
                            spacing: 3px; alignment: center;
                            Text { text: item.name; color: Tokens.ink-100; font-size: 13px; font-weight: 600; overflow: elide; }
                            Text { text: item.detail; color: Tokens.ink-300; font-size: 10px; overflow: elide; }
                        }
                    }
                    pl-touch := TouchArea { mouse-cursor: pointer; clicked => { root.open-playlist(item.id); } }
                    if pl-touch.has-hover: Rectangle {
                        x: parent.width - 44px; y: (parent.height - 32px) / 2;
                        width: 32px; height: 32px; border-radius: 16px; background: Tokens.neutral-50;
                        Image { source: @image-url("../assets/icons/Play.svg"); width: 16px; height: 16px; x: 8px; y: 8px; colorize: Tokens.ink-100; }
                        TouchArea { mouse-cursor: pointer; clicked => { root.play-playlist(item.id); } }
                    }
                }
            }
            if root.sidebar-collapsed: Rectangle { vertical-stretch: 1; }
            StageNavigator {
                width: 48px; height: 48px;
                stage-column: root.page-column(root.active-view); stage-row: root.page-row(root.active-view);
                reduced: root.lyrics-reduced-motion;
                navigate(column,row) => { root.stage-navigate(column,row); }
            }
        }
    }

    // Main Content Canvas
    content := Rectangle {
        x: 8px + root.safe-left * 1px + (root.immersive || root.expanded-active || root.mobile ? 0px : root.sidebar-collapsed ? 72px : 240px);
        y: root.safe-top * 1px + (root.immersive || root.expanded-active ? 8px : root.compact-height ? 52px : 64px);
        width: root.width - self.x - 8px - root.safe-right * 1px;
        height: root.immersive ? root.height - 16px - (root.safe-top + root.safe-bottom) * 1px : root.expanded-active ? root.height - root.bottom-reserve - 8px - (root.safe-top + root.safe-bottom) * 1px : root.page-viewport-height;
        border-radius: root.navigation-capture ? 0px : root.stage-radius * 1px;
        clip: true;
        background: root.navigation-capture ? transparent : Tokens.neutral-0;

        // One persistent surface on every route. Window coordinates keep its
        // pattern fixed when the player expands or the sidebar changes width.
        ambient-surface := Rectangle {
            visible: !root.navigation-capture;
            x: -content.x; y: -content.y;
            width: root.width; height: root.height;
            background: Tokens.neutral-0;
            Image { source: root.ambient-frame; width: 100%; height: 100%; image-fit: fill; opacity: root.ambient-opacity; }

        }

        // Non-Lyrics Views (Home, Explore, Library, Liked, Playlist, Queue, Search, Settings)
        for page-name[index] in ["home", "explore", "library", "liked", "playlist", "queue", "search", "settings"]: page-layer := Rectangle {
            property <string> route: page-name;
            property <[TrackRow]> page-tracks: self.route == "home" ? root.home-page-tracks : self.route == "explore" ? root.explore-page-tracks : self.route == "library" ? root.library-page-tracks : self.route == "liked" ? root.liked-page-tracks : self.route == "playlist" ? root.playlist-page-tracks : self.route == "queue" ? root.queue-page-tracks : self.route == "search" ? root.search-page-tracks : root.settings-page-tracks;
            property <bool> warming: !root.mobile-sheet && ((root.warm-page == index && root.page-phase == 1 && self.route != root.displayed-view) || (root.page-phase == 3 && self.route == root.active-view));
            visible: root.navigation-capture && root.navigation-capture-target ? self.route == root.active-view : !root.colors-changing || (!self.warming && abs(root.page-column(self.route) - root.camera-x) < 1 && abs(root.page-row(self.route) - root.camera-y) < 1) || (root.page-phase == 3 && self.route == root.active-view);
            // A clipped edge strip warms the cached surface without covering
            // the active page's controls or intercepting its normal gestures.
            x: root.navigation-capture && root.navigation-capture-target ? 0px : self.warming ? content.width - 1px : (root.page-column(self.route) - root.camera-x) * content.width;
            y: root.navigation-capture && root.navigation-capture-target ? 0px : (root.mobile-sheet ? 56px : 0px) + (self.warming ? 0px : (root.page-row(self.route) - root.camera-y) * self.height);
            opacity: root.navigation-capture && root.navigation-capture-target ? 1 : self.warming ? 0.003922 : 1 - root.navigation-blend;
            clip: true;
            width: 100%; height: root.mobile ? root.page-viewport-height : content.height;
            cache-rendering-hint: true;
            if page-layer.route == "settings": Rectangle {
                x: (parent.width - min(parent.width - (root.mobile ? 32px : 80px), 840px)) / 2;
                y: root.mobile ? 12px : 24px;
                width: min(parent.width - (root.mobile ? 32px : 80px), 840px); height: 44px;
                HorizontalLayout { padding-left: 12px; spacing: 10px;
                    if root.settings-section != "": Action { icon: @image-url("../assets/icons/ChevronLeft.svg"); label: I18n.tr("Назад до налаштувань"); comfortable: true; clicked => { root.open-settings(""); } }
                    Text { text: root.settings-name(root.settings-section); color: Tokens.ink-100; font-size: root.mobile ? 24px : 30px; font-weight: 700; overflow: elide; horizontal-stretch: 1; vertical-alignment: center; }
                }
            }
            ScrollView {
            private property <string> page: page-layer.route;
            private property <string> settings-location: root.settings-section;
            changed settings-location => { if self.page == "settings" { self.content-y = 0px; } }
            changed page => { self.content-y = 0px; }
            y: page-layer.route == "settings" ? (root.compact-height ? 56px : root.mobile ? 72px : 84px) : 0px;
            width: 100%; height: parent.height - self.y;
            content-width: self.width;
            content-height: page-layer.route == "home" || page-layer.route == "settings" ? max(self.height, page-layout.preferred-height) : max(self.height, page-layout.min-height);
            page-layout := VerticalLayout {
                padding-left: root.mobile ? (page-layer.route == "search" ? 12px : 16px) : max(40px, (content.width - 1440px) / 2);
                padding-right: root.mobile ? (page-layer.route == "search" ? 12px : 16px) : max(40px, (content.width - 1440px) / 2);
                padding-top: page-layer.route == "settings" ? 0px : root.mobile ? (page-layer.route == "search" ? 12px : 20px) : 32px;
                padding-bottom: 24px;
                spacing: 16px;

                if (page-layer.route == "home" || page-layer.route == "explore") && !root.compact-height: ScrollView {
                    height: root.mobile ? 44px : 36px;
                    content-height: self.height;
                    content-width: max(self.width, chips-row.preferred-width);
                    chips-row := HorizontalLayout {
                        height: root.mobile ? 44px : 36px; spacing: 8px; alignment: start;
                        for chip in ["all", "for-you", "focus", "relax", "energy"]: Action {
                            text: root.chip-label(chip);
                            chip: true;
                            selected: root.selected-chip == chip;
                            clicked => {
                                root.selected-chip = chip;
                                if chip == "for-you" && page-layer.route == "home" { root.request-home-recommendations(); }
                                else if chip != "all" { root.search(root.chip-label(chip)); }
                                else { root.navigate("home"); }
                            }
                        }
                    }
                }

                if page-layer.route == "home": HorizontalLayout {
                    height: root.mobile ? 52px : 58px;
                    VerticalLayout {
                        alignment: center; spacing: 4px; horizontal-stretch: 1;
                        Text { text: I18n.tr("Головна"); color: Tokens.ink-100; font-size: root.mobile ? 22px : 28px; font-weight: 700; overflow: elide; }
                        Text { text: I18n.tr("Музика, до якої хочеться повернутись."); color: Tokens.ink-300; font-size: 12px; overflow: elide; }
                    }
                    Action { icon: @image-url("../assets/icons/Palette.svg"); label: I18n.tr("Макет головної"); comfortable: true; clicked => {root.dialog = "home-layout";} }
                    Action { icon: @image-url("../assets/icons/Download.svg"); label: I18n.tr("Імпорт плейліста"); comfortable: true; clicked => {root.dialog = "music-import";} }
                }
                if page-layer.route == "home" && (root.home-layout == 0 || root.home-layout == 3): HorizontalLayout {
                    height: root.home-layout == 3 ? (root.mobile ? 240px : 300px) : root.mobile ? 188px : 208px;
                    spacing: 14px;
                    Rectangle {
                        horizontal-stretch: 1;
                        border-radius: 0px;
                        background: transparent;
                        HorizontalLayout {
                            padding: root.mobile ? 22px : 28px; spacing: 20px;
                            VerticalLayout {
                                alignment: center; spacing: 10px;
                                Text { text: root.duration > 0 ? root.current-title : I18n.tr("Знайдіть свій ритм"); color: Tokens.ink-100; font-size: root.mobile ? 26px : 34px; font-weight: 600; overflow: elide; }
                                Text { text: root.duration > 0 ? root.current-artist : I18n.tr("Музика, до якої хочеться повернутись."); color: Tokens.ink-150; font-size: 13px; overflow: elide; }
                                HorizontalLayout {
                                    alignment: start;
                                    Action { text: root.duration > 0 ? I18n.tr("Продовжити") : I18n.tr("Слухати"); primary: true; icon: @image-url("../assets/icons/Play.svg"); clicked => { if root.duration > 0 { root.navigate("lyrics"); } else { root.select-track(0); } } }
                                }
                            }
                            if !root.mobile && content.width > 800px: Artwork { art: root.current-art; downloaded: root.current-downloaded; mark-clicked => { root.status = I18n.tr("Доступно локально"); } width: root.home-layout == 3 ? 220px : 140px; height: self.width; border-radius: 16px; }
                        }
                    }
                    if !root.mobile && root.home-layout != 3: VerticalLayout {
                        width: content.width > 900px ? 208px : 168px; spacing: 14px;
                        Rectangle {
                            background: transparent; border-radius: 0px;
                            HorizontalLayout {
                                padding: 20px; spacing: 14px;
                                Image { source: @image-url("../assets/icons/Heart.svg"); width: 26px; height: 26px; colorize: Tokens.brand-300; }
                                VerticalLayout { alignment: center; spacing: 6px;
                                    Text { text: I18n.tr("Улюблене"); color: Tokens.ink-100; font-size: 16px; font-weight: 600; }
                                }
                            }
                            TouchArea { mouse-cursor: pointer; clicked => { root.navigate("liked"); } }
                            accessible-role: button; accessible-label: I18n.tr("Улюблене"); accessible-action-default => { root.navigate("liked"); }
                        }
                        Rectangle {
                            background: transparent; border-radius: 0px;
                            HorizontalLayout {
                                padding: 20px; spacing: 14px;
                                Image { source: @image-url("../assets/icons/Compass.svg"); width: 26px; height: 26px; colorize: Tokens.ink-150; }
                                VerticalLayout { alignment: center; spacing: 6px;
                                    Text { text: I18n.tr("Відкривайте"); color: Tokens.ink-100; font-size: 16px; font-weight: 600; }
                                }
                            }
                            TouchArea { mouse-cursor: pointer; clicked => { root.navigate("explore"); } }
                            accessible-role: button; accessible-label: I18n.tr("Відкрити нову музику"); accessible-action-default => { root.navigate("explore"); }
                        }
                    }
                }

                if page-layer.route == "home" && (root.home-layout == 4 || root.home-layout == 5): VerticalLayout {
                    spacing: 8px;
                    Text {text: root.home-layout == 4 ? I18n.tr("Ваша колекція") : I18n.tr("Що послухаємо?"); color: Tokens.ink-100; font-size: 28px; font-weight: 700;}
                    HorizontalLayout {
                        height: 48px;
                        Action {text: I18n.tr("Улюблене"); comfortable: true; clicked => {root.navigate("liked");}}
                        Action {text: I18n.tr("Бібліотека"); comfortable: true; clicked => {root.navigate("library");}}
                        Action {text: I18n.tr("Огляд"); comfortable: true; clicked => {root.navigate("explore");}}
                    }
                    if root.home-layout == 4: VerticalLayout {
                        spacing: 4px;
                        for p[index] in root.playlist-destinations: SettingsRow {
                            visible: index < 4;
                            text: p.name; detail: p.detail;
                            icon: @image-url("../assets/icons/ListMusic.svg");
                            clicked => {root.open-playlist(p.id);}
                        }
                    }
                }
                if page-layer.route == "home": VerticalLayout {
                    spacing: 12px;
                    HorizontalLayout {
                        height: root.mobile ? 58px : 56px;
                        spacing: 12px;
                        VerticalLayout {
                            alignment: center;
                            spacing: 4px;
                            horizontal-stretch: 1;
                            Text {
                                text: I18n.tr("Рекомендовано для вас");
                                color: Tokens.ink-100;
                                font-size: root.mobile ? 20px : 26px;
                                font-weight: 700;
                                overflow: elide;
                            }
                            Text {
                                text: root.home-recommendation-personalized ? I18n.tr("На основі ваших прослуховувань") : I18n.tr("Свіжі композиції з YouTube Music");
                                color: Tokens.ink-300;
                                font-size: 12px;
                                overflow: elide;
                            }
                        }
                        if root.home-recommendation-tracks.length > 0 && !root.mobile: Action {
                            text: I18n.tr("Відтворити все");
                            icon: @image-url("../assets/icons/Play.svg");
                            comfortable: true;
                            clicked => { root.play-home-recommendations(); }
                        }
                        Action {
                            icon: @image-url("../assets/icons/RefreshCw.svg");
                            label: I18n.tr("Оновити");
                            comfortable: true;
                            enabled: !root.home-recommendation-loading;
                            clicked => { root.request-home-recommendations(); }
                        }
                    }
                    if root.home-recommendation-tracks.length > 0: ScrollView {
                        height: root.mobile ? 208px : 236px;
                        content-height: self.height;
                        content-width: max(self.width, recommendation-row.preferred-width);
                        recommendation-row := HorizontalLayout {
                            height: parent.height;
                            spacing: 14px;
                            for track[index] in root.home-recommendation-tracks: Rectangle {
                                property <length> cover-size: root.mobile ? 140px : 172px;
                                width: self.cover-size;
                                height: root.mobile ? 202px : 230px;
                                background: transparent;
                                VerticalLayout {
                                    spacing: 7px;
                                    Artwork {
                                        art: track.art;
                                        downloaded: track.downloaded;
                                        width: parent.width;
                                        height: self.width;
                                        border-radius: 14px;
                                    }
                                    Text {
                                        text: track.title;
                                        color: Tokens.ink-100;
                                        font-size: 13px;
                                        font-weight: 600;
                                        overflow: elide;
                                    }
                                    Text {
                                        text: track.artist;
                                        color: Tokens.ink-300;
                                        font-size: 12px;
                                        overflow: elide;
                                    }
                                }
                                TouchArea { mouse-cursor: pointer; clicked => { root.select-home-recommendation(index); } }
                                accessible-role: button;
                                accessible-label: track.title + " · " + track.artist;
                                accessible-action-default => { root.select-home-recommendation(index); }
                            }
                        }
                    }
                    if root.home-recommendation-tracks.length == 0: Rectangle {
                        height: root.mobile ? 64px : 60px;
                        background: Tokens.neutral-100;
                        border-radius: 12px;
                        HorizontalLayout {
                        padding-left: 16px; padding-right: 12px; spacing: 12px;
                        Image { source: @image-url("../assets/icons/Music2.svg"); width: 20px; height: 20px; colorize: Tokens.ink-300; }
                        Text {
                            text: root.home-recommendation-loading ? I18n.tr("Підбираємо композиції…") : root.home-recommendation-failed ? I18n.tr("Не вдалося завантажити рекомендації") : I18n.tr("Каталог поки не знайшов збігів");
                            color: Tokens.ink-300;
                            font-size: 13px;
                            vertical-alignment: center;
                            horizontal-stretch: 1;
                        }
                        if !root.home-recommendation-loading && !root.home-recommendation-failed: Action {
                            text: I18n.tr("Спробувати огляд");
                            comfortable: true;
                            clicked => { root.navigate("explore"); }
                        }
                        if root.home-recommendation-failed && !root.home-recommendation-loading: Action {
                            text: I18n.tr("Спробувати ще раз");
                            comfortable: true;
                            clicked => { root.request-home-recommendations(); }
                        }
                        }
                    }
                }
                if page-layer.route != "settings" && !(page-layer.route == "home" && root.home-layout == 4): HorizontalLayout {
                    visible: page-layer.route != "playlist";
                    height: root.mobile && page-layer.route == "search" ? 36px : page-layer.route == "home" && !root.mobile ? 48px : 44px;
                    spacing: 10px;
                    if page-layer.route == "settings" && root.settings-section != "": Action {
                        icon: @image-url("../assets/icons/ChevronLeft.svg"); label: I18n.tr("Назад до налаштувань"); comfortable: true;
                        clicked => { root.open-settings(""); }
                    }
                    Text {
                        text: page-layer.route == "home" ? I18n.tr("Послухати ще раз") :
                              page-layer.route == "explore" ? I18n.tr("Відкривайте нову музику") :
                              page-layer.route == "library" ? I18n.tr("Бібліотека") :
                              page-layer.route == "liked" ? I18n.tr("Музика, яка сподобалась") :
                              page-layer.route == "settings" ? root.settings-name(root.settings-section) :
                              page-layer.route == "playlist" ? root.playlist-title :
                              page-layer.route == "queue" ? I18n.tr("Черга відтворення") : I18n.tr("Результати пошуку");
                        color: Tokens.ink-100;
                        font-size: root.mobile ? (page-layer.route == "search" ? 22px : 24px) : page-layer.route == "home" ? 24px : 30px;
                        font-weight: 700;
                        horizontal-stretch: 1;
                        vertical-alignment: center;
                        overflow: elide;
                    }
                    if page-layer.route == "explore": Action {
                        text: I18n.tr("Оновити");
                        icon: @image-url("../assets/icons/RefreshCw.svg");
                        outlined: true;
                        clicked => { root.refresh-explore(); }
                    }
                    if page-layer.route == "library": Action {
                        text: root.mobile ? "" : root.android-platform ? I18n.tr("Доступ до музики") : I18n.tr("Додати папку");
                        label: root.android-platform ? I18n.tr("Доступ до музики на пристрої") : I18n.tr("Додати папку");
                        icon: root.android-platform ? @image-url("../assets/icons/Music2.svg") : @image-url("../assets/icons/FolderPlus.svg");
                        outlined: true;
                        clicked => { root.add-source("folder"); }
                    }
                    if page-layer.route == "library": Action {
                        icon: @image-url("../assets/icons/Download.svg"); label: I18n.tr("Імпорт плейліста"); comfortable: true; clicked => {root.dialog = "music-import";}
                    }
                    if page-layer.route == "library": Action {
                        icon: @image-url("../assets/icons/RefreshCw.svg");
                        label: I18n.tr("Сканувати бібліотеку");
                        outlined: true;
                        clicked => { root.scan(); }
                    }
                    if page-layer.route == "library" && !root.mobile: Action {
                        text: I18n.tr("Синхронізувати з YT");
                        outlined: true;
                        clicked => { root.sync-tags(); }
                    }
                }

                if root.status != "": Rectangle {
                    height: page-layer.route == "home" ? (root.mobile ? 32px : 24px) : root.mobile ? 64px : 36px; border-radius: 10px;
                    background: page-layer.route == "home" ? transparent : Tokens.primary-container; border-width: 0px; border-color: #ffffff18;
                    HorizontalLayout {
                        padding-left: page-layer.route == "home" ? 0px : 14px; padding-right: 14px;
                        Text { text: I18n.tr(root.status); color: page-layer.route == "home" ? Tokens.ink-300 : Tokens.brand-300; font-size: 12px; font-weight: 600; vertical-alignment: center; wrap: word-wrap; overflow: elide; }
                    }
                }

                if page-layer.route == "settings": Rectangle {
                    height: settings-content.preferred-height;
                    settings-content := VerticalLayout {
                        x: (parent.width - self.width) / 2;
                        width: min(parent.width - (root.mobile ? 32px : 80px), 840px); height: self.preferred-height;
                        spacing: 4px; padding-bottom: 24px;
                        if root.settings-section == "account": VerticalLayout {
                            spacing: 0px;
                            SettingsRow {text: I18n.tr("Підключені акаунти"); icon: @image-url("../assets/icons/User.svg"); clicked => {root.dialog = "connections";}}
                            HorizontalLayout {
                                padding-left: 12px; padding-right: 12px; padding-top: 4px; padding-bottom: 8px;
                                Text { text: root.account-signed-in ? (root.account-premium ? "Premium · developer / tester" : I18n.tr("Базовий акаунт")) + " · " + root.account-email : I18n.tr("Увійдіть, щоб зберігати бібліотеку та налаштування між пристроями."); wrap: word-wrap; color: Tokens.ink-100; font-size: 14px; horizontal-stretch: 1; }
                            }
                            if !root.account-signed-in: VerticalLayout {
                                spacing: 10px;
                                padding-left: 12px; padding-right: 12px;
                                if root.account-verification-url == "": Action { text: I18n.tr("Продовжити з Vey"); comfortable: true; wide: true; primary: true; enabled: !root.account-busy; clicked => { root.account-command("device"); } }
                                if root.account-verification-url == "": Action { text: I18n.tr("Увійти через QR-код"); comfortable: true; wide: true; enabled: !root.account-busy; clicked => { root.account-command("qr"); } }
                                if root.account-verification-url == "": Action { text: I18n.tr("Email або інший сервер"); comfortable: true; wide: true; enabled: !root.account-busy; clicked => { root.account-manual = !root.account-manual; } }
                                if root.account-manual && root.account-verification-url == "": VerticalLayout {
                                    spacing: 10px;
                                Text { text: I18n.tr("Адреса API Vey"); color: Tokens.ink-200; }
                                LineEdit { height: 44px; text <=> root.account-api; placeholder-text: "https://your-api.example"; enabled: !root.account-busy; }
                                LineEdit { height: 44px; text <=> root.account-name; placeholder-text: I18n.tr("Ім’я для нового акаунта"); enabled: !root.account-busy; }
                                LineEdit { height: 44px; text <=> root.account-email; placeholder-text: "Email"; enabled: !root.account-busy; }
                                LineEdit { height: 44px; text <=> root.account-password; placeholder-text: I18n.tr("Пароль Vey"); input-type: password; enabled: !root.account-busy; }
                                HorizontalLayout {
                                    spacing: 8px;
                                    Action { text: I18n.tr("Увійти"); primary: true; comfortable: true; wide: true; enabled: !root.account-busy; clicked => { root.account-command("login"); } }
                                    Action { text: I18n.tr("Створити акаунт"); comfortable: true; wide: true; enabled: !root.account-busy; clicked => { root.account-command("register"); } }
                                }
                                }
                                if root.account-verification-url != "": VerticalLayout {
                                    spacing: 10px;
                                    Text { text: I18n.tr("Скануй QR-код камерою телефона"); color: Tokens.ink-100; wrap: word-wrap; }
                                    HorizontalLayout {
                                        alignment: center;
                                        Rectangle {
                                            width: root.height < 720px ? 184px : 216px; height: self.width;
                                            background: #ffffff; border-radius: 12px;
                                            Image { x: 8px; y: 8px; width: parent.width - 16px; height: parent.height - 16px; source: root.account-qr; image-fit: contain; }
                                        }
                                    }
                                    Text { text: root.account-user-code; color: Tokens.ink-100; font-size: 25px; font-weight: 700; horizontal-alignment: center; }
                                    Text { text: I18n.tr("Код діє ще") + " " + root.account-seconds-left + " " + I18n.tr("сек"); color: Tokens.ink-300; font-size: 12px; horizontal-alignment: center; }
                                    Text { text: I18n.tr("Або відкрий посилання та введи код:") + " " + root.account-verification-page; color: Tokens.ink-200; font-size: 12px; wrap: word-wrap; }

                                    Action { text: I18n.tr("Відкрити сторінку входу"); comfortable: true; wide: true; primary: true; clicked => { root.account-command("website"); } }
                                    Action { text: I18n.tr("Скасувати вхід"); comfortable: true; wide: true; clicked => { root.account-command("cancel-login"); } }
                                }
                            }
                            if root.account-status != "": HorizontalLayout {
                                padding-left: 12px; padding-right: 12px;
                                Text { text: root.account-status; wrap: word-wrap; color: Tokens.ink-200; font-size: 13px; horizontal-stretch: 1; }
                            }
                            if root.account-signed-in: VerticalLayout {
                                spacing: 0px;
                                SectionLabel { text: I18n.tr("Профіль акаунта"); }
                                HorizontalLayout {
                                    spacing: 12px; padding-left: 12px; padding-right: 12px; padding-bottom: 12px;
                                    Rectangle {
                                        width: 64px; height: 64px; border-radius: 32px; clip: true;
                                        background: Tokens.neutral-50; border-width: 0px;
                                        Image { width: parent.width; height: parent.height; source: root.account-avatar; image-fit: cover; }
                                    }
                                    VerticalLayout {
                                        alignment: center; spacing: 3px; horizontal-stretch: 1;
                                        Text { text: root.account-name; color: Tokens.ink-100; font-size: 16px; font-weight: 600; }
                                        Text { text: root.account-email; color: Tokens.ink-300; font-size: 13px; }
                                        if root.account-created-at != "": Text { text: I18n.tr("Створено") + " · " + root.account-created-at; color: Tokens.ink-300; font-size: 11px; }
                                    }
                                }
                                HorizontalLayout {
                                    spacing: 8px; padding-left: 12px; padding-right: 12px; padding-bottom: 10px;
                                    Action { text: I18n.tr("Завантажити аватар"); comfortable: true; wide: true; enabled: !root.account-busy; clicked => { root.account-command("upload-avatar"); } }
                                    Action { text: I18n.tr("Видалити аватар"); comfortable: true; wide: true; enabled: !root.account-busy; clicked => { root.account-command("delete-avatar"); } }
                                }
                                VerticalLayout {
                                    spacing: 8px; padding-left: 12px; padding-right: 12px; padding-bottom: 10px;
                                    LineEdit { height: 44px; text <=> root.account-name; placeholder-text: I18n.tr("Ім’я"); enabled: !root.account-busy; }
                                    LineEdit { height: 44px; text <=> root.account-nickname; placeholder-text: I18n.tr("Нікнейм"); enabled: !root.account-busy; }
                                    LineEdit { height: 44px; text <=> root.account-email; placeholder-text: "Email"; enabled: !root.account-busy; }
                                    LineEdit { height: 44px; text <=> root.account-discord; placeholder-text: "Discord"; enabled: !root.account-busy; }
                                    TextEdit { height: 82px; text <=> root.account-bio; }
                                    LineEdit { height: 44px; text <=> root.account-current-password; placeholder-text: I18n.tr("Поточний пароль для зміни email або пароля"); input-type: password; enabled: !root.account-busy; }
                                    Action { text: I18n.tr("Зберегти профіль"); primary: true; comfortable: true; wide: true; enabled: !root.account-busy; clicked => { root.account-command("save-profile"); } }
                                    SectionLabel { text: I18n.tr("Зміна пароля"); }
                                    LineEdit { height: 44px; text <=> root.account-new-password; placeholder-text: I18n.tr("Новий пароль · щонайменше 10 символів"); input-type: password; enabled: !root.account-busy; }
                                    Action { text: I18n.tr("Змінити пароль"); comfortable: true; wide: true; enabled: !root.account-busy && root.account-current-password != "" && root.account-new-password != ""; clicked => { root.account-command("change-password"); } }
                                }
                                HorizontalLayout {
                                    padding-left: 12px; padding-right: 12px; padding-bottom: 8px;
                                    Text { text: I18n.tr("Синхронізуються посилання на відео, улюблене, історія, списки та налаштування. Файли пристрою залишаються локальними."); color: Tokens.ink-200; wrap: word-wrap; font-size: 12px; horizontal-stretch: 1; }
                                }
                                SectionLabel { text: I18n.tr("Синхронізація"); }
                                SettingsRow {
                                    text: I18n.tr("Зберегти дані цього пристрою у хмарі");
                                    icon: @image-url("../assets/icons/Cloud.svg");
                                    chevron: false;
                                    clickable: !root.account-busy;
                                    clicked => { root.account-command("push"); }
                                }
                                SettingsRow {
                                    text: I18n.tr("Відновити дані з хмари на цьому пристрої");
                                    icon: @image-url("../assets/icons/Download.svg");
                                    chevron: false;
                                    clickable: !root.account-busy;
                                    clicked => { root.account-command("pull"); }
                                }
                                SwitchRow {
                                    text: I18n.tr("Автоматична синхронізація");
                                    icon: @image-url("../assets/icons/RefreshCw.svg");
                                    checked: root.account-auto-sync;
                                    toggled => { root.account-auto-sync = !root.account-auto-sync; }
                                }
                                SettingsRow {
                                    text: I18n.tr("Оновити доступ акаунта");
                                    icon: @image-url("../assets/icons/RefreshCw.svg");
                                    chevron: false;
                                    clickable: !root.account-busy;
                                    clicked => { root.account-command("refresh"); }
                                }
                                if !root.account-premium: HorizontalLayout {
                                    padding-left: 12px; padding-right: 12px; padding-top: 8px; padding-bottom: 8px;
                                    Text { text: I18n.tr("Premium для завантаження власного аудіо зараз видається лише розробникам і тестувальникам. Купівля недоступна."); color: Tokens.ink-300; wrap: word-wrap; font-size: 12px; horizontal-stretch: 1; }
                                }
                                if root.account-premium: VerticalLayout {
                                    spacing: 0px;
                                    SectionLabel { text: I18n.tr("Власне аудіо · приватне сховище"); }
                                    HorizontalLayout {
                                        padding-left: 12px; padding-right: 12px; padding-bottom: 8px;
                                        ComboBox { model: root.account-local-files; current-index <=> root.account-local-index; enabled: !root.account-busy; horizontal-stretch: 1; }
                                    }
                                    SettingsRow {
                                        text: I18n.tr("Завантажити вибрану пісню у хмару");
                                        icon: @image-url("../assets/icons/Download.svg");
                                        chevron: false;
                                        clickable: !root.account-busy;
                                        clicked => { root.account-command("upload"); }
                                    }
                                    SwitchRow {
                                        text: I18n.tr("Автоматично завантажувати локальні пісні");
                                        checked: root.account-auto-upload;
                                        toggled => { root.account-auto-upload = !root.account-auto-upload; }
                                    }
                                    HorizontalLayout {
                                        padding-left: 12px; padding-right: 12px; padding-bottom: 8px;
                                        Text { text: I18n.tr("Автоматичне завантаження працює для пісень із вашої бібліотеки, поки Vey відкритий."); color: Tokens.ink-300; wrap: word-wrap; font-size: 12px; horizontal-stretch: 1; }
                                    }
                                }
                                SectionLabel { text: I18n.tr("Хмарні файли"); }
                                SettingsRow {
                                    text: I18n.tr("Оновити список хмарних файлів");
                                    icon: @image-url("../assets/icons/Cloud.svg");
                                    chevron: false;
                                    clickable: !root.account-busy;
                                    clicked => { root.account-command("files"); }
                                }
                                if root.account-cloud-files.length > 0: HorizontalLayout {
                                    padding-left: 12px; padding-right: 12px; padding-bottom: 8px;
                                    ComboBox { model: root.account-cloud-files; current-index <=> root.account-cloud-index; enabled: !root.account-busy; horizontal-stretch: 1; }
                                }
                                if root.account-cloud-files.length > 0: SettingsRow {
                                    text: I18n.tr("Завантажити пісню на пристрій");
                                    icon: @image-url("../assets/icons/Download.svg");
                                    chevron: false;
                                    clickable: !root.account-busy;
                                    clicked => { root.account-command("download"); }
                                }
                                if root.account-busy: SettingsRow {
                                    text: I18n.tr("Скасувати завантаження");
                                    icon: @image-url("../assets/icons/X.svg");
                                    chevron: false;
                                    clicked => { root.account-command("cancel"); }
                                }
                                Rectangle { height: 16px; background: transparent; }
                                SettingsRow {
                                    text: I18n.tr("Вийти з акаунта");
                                    icon: @image-url("../assets/icons/X.svg");
                                    chevron: false;
                                    clickable: !root.account-busy;
                                    clicked => { root.account-command("logout"); }
                                }
                            }
                        }
                        if root.settings-section == "": VerticalLayout {
                            spacing: 4px;
                            SectionLabel { text: I18n.tr("Головна"); }
                            SettingsRow {
                                text: I18n.tr("Макет головної");
                                icon: @image-url("../assets/icons/House.svg");
                                clicked => { root.dialog = "home-layout"; }
                            }
                            SectionLabel { text: I18n.tr("Обліковий запис"); }
                            SettingsRow {
                                text: I18n.tr("Акаунт Vey");
                                detail: root.account-signed-in ? root.account-email : I18n.tr("Улюблене, історія та налаштування у хмарі");
                                icon: @image-url("../assets/icons/User.svg");
                                accent: root.account-signed-in;
                                clicked => { root.open-settings("account"); }
                            }
                            SectionLabel { text: I18n.tr("Загальні"); }
                            SettingsRow {
                                text: I18n.tr("Мова інтерфейсу");
                                value: root.language-name(I18n.language);
                                icon: @image-url("../assets/icons/Languages.svg");
                                clicked => { root.open-settings("language"); }
                            }
                            SettingsRow {
                                text: I18n.tr("Вигляд");
                                value: PlayerTheme.enabled ? root.player-theme-style.name : root.color-mode == "dynamic" ? I18n.tr("Динамічні") : root.color-mode == "static" ? I18n.tr("Статичні") : I18n.tr("Лише фон");
                                icon: @image-url("../assets/icons/Palette.svg");
                                clicked => { root.open-settings("appearance"); }
                            }
                            SectionLabel { text: I18n.tr("Відтворення"); }
                            SettingsRow {
                                text: I18n.tr("Гучність звуку");
                                value: round(root.volume * 100) + "%";
                                icon: @image-url("../assets/icons/Volume2.svg");
                                clicked => { root.open-settings("audio"); }
                            }
                            SectionLabel { text: I18n.tr("Слова пісень"); }
                            SettingsRow {
                                text: I18n.tr("Відстань до романізації");
                                value: round(root.lyrics-secondary-gap * 100) + "%";
                                icon: @image-url("../assets/icons/Music2.svg");
                                clicked => { root.open-settings("lyrics"); }
                            }
                            SectionLabel { text: I18n.tr("Бібліотека"); }
                            SettingsRow {
                                text: I18n.tr("Джерела музики");
                                detail: root.sources.length + I18n.tr(" джерел");
                                icon: @image-url("../assets/icons/Library.svg");
                                clicked => { root.open-settings("library"); }
                            }
                            SettingsRow {
                                text: I18n.tr("Сканувати бібліотеку");
                                icon: @image-url("../assets/icons/RefreshCw.svg");
                                chevron: false;
                                clicked => { root.scan(); }
                            }
                            SectionLabel { text: I18n.tr("Дані та вхід"); }
                            SettingsRow {
                                text: I18n.tr("Резервні копії");
                                detail: root.account-signed-in ? root.account-email : "";
                                icon: @image-url("../assets/icons/Cloud.svg");
                                clicked => { root.open-settings("data"); }
                            }
                            SectionLabel { text: I18n.tr("Про застосунок"); }
                            SettingsRow {
                                text: "Vey";
                                detail: I18n.tr("Версія") + " " + root.app-version;
                                icon: @image-url("../assets/icons/Info.svg");
                                clicked => { root.open-settings("about"); }
                            }
                        }
                        if root.settings-section == "language": VerticalLayout {
                            spacing: 0px;
                            for locale[index] in ["Українська", "English", "Čeština", "Polski", "Deutsch", "Español", "Français", "日本語"]:
                            SettingsRow {
                                text: locale;
                                selected: I18n.language == root.language-code(index);
                                chevron: false;
                                clicked => { I18n.language = root.language-code(index); root.preferences-changed(); }
                            }
                        }
                        if root.settings-section == "appearance": VerticalLayout {
                            spacing: 0px;
                            SettingsRow {
                                text: I18n.tr("Теми плеєра");
                                detail: PlayerTheme.enabled ? I18n.tr("Кольори цієї теми застосовані до всіх сторінок.") : I18n.tr("Вимкнено");
                                icon: @image-url("../assets/icons/Palette.svg");
                                clicked => { root.dialog = "lyric-style"; }
                            }
                            if !PlayerTheme.enabled: VerticalLayout {
                                spacing: 0px;
                                SectionLabel { text: I18n.tr("Кольори інтерфейсу"); }
                                SettingsRow {
                                    text: I18n.tr("Динамічні");
                                    detail: root.mobile ? "" : I18n.tr("Кольори плавно змінюються разом з обкладинкою.");
                                    selected: root.color-mode == "dynamic";
                                    chevron: false;
                                    clicked => { root.color-mode = "dynamic"; root.appearance-changed(root.color-mode, root.color-hue); }
                                }
                                SettingsRow {
                                    text: I18n.tr("Статичні");
                                    detail: root.mobile ? "" : I18n.tr("Обраний колір залишається незмінним для всіх пісень.");
                                    selected: root.color-mode == "static";
                                    chevron: false;
                                    clicked => { root.color-mode = "static"; root.appearance-changed(root.color-mode, root.color-hue); }
                                }
                                SettingsRow {
                                    text: I18n.tr("Лише фон");
                                    detail: root.mobile ? "" : I18n.tr("Фон змінюється з обкладинкою, а колір кнопок і тексту залишається обраним.");
                                    selected: root.color-mode == "background";
                                    chevron: false;
                                    clicked => { root.color-mode = "background"; root.appearance-changed(root.color-mode, root.color-hue); }
                                }
                                if root.color-mode != "dynamic": SectionLabel { text: I18n.tr("Основний колір"); }
                                if root.color-mode != "dynamic": GridLayout {
                                    spacing: 8px;
                                    for hue[index] in [85, 30, 160, 210, 275, 340]: Rectangle {
                                        row: floor(index / 3); col: Math.mod(index, 3);
                                        height: 44px; min-width: 44px; horizontal-stretch: 1; border-radius: 22px;
                                        background: root.color-hue == hue ? Tokens.neutral-200 : transparent;
                                        Rectangle { width: 24px; height: 24px; x: (parent.width - self.width) / 2; y: 10px; border-radius: 12px; background: hue == 85 ? #bfdc96 : hue == 30 ? #dfbf9b : hue == 160 ? #9cdbc6 : hue == 210 ? #9dbfdf : hue == 275 ? #c39bdf : #df9bb2; }
                                        TouchArea { mouse-cursor: pointer; clicked => { root.color-hue = hue; root.appearance-changed(root.color-mode, hue); } }
                                        accessible-role: button; accessible-label: hue == 85 ? I18n.tr("Лаймовий") : hue == 30 ? I18n.tr("Бурштиновий") : hue == 160 ? I18n.tr("М’ятний") : hue == 210 ? I18n.tr("Блакитний") : hue == 275 ? I18n.tr("Фіолетовий") : I18n.tr("Рожевий");
                                        accessible-action-default => { root.color-hue = hue; root.appearance-changed(root.color-mode, hue); }
                                    }
                                }
                            }
                            SectionLabel { text: I18n.tr("Рух інтерфейсу"); }
                            SwitchRow {
                                text: root.mobile ? I18n.tr("Розмиття переходів") : I18n.tr("Розмиття під час переходів");
                                icon: @image-url("../assets/icons/MonitorPlay.svg");
                                checked: root.navigation-blur;
                                toggled => { root.navigation-blur = !root.navigation-blur; root.preferences-changed(); }
                            }
                            SwitchRow {
                                text: I18n.tr("Вимкнути всі анімації");
                                detail: root.mobile ? "" : I18n.tr("Вимикає рух сторінок, панелей і тексту.");
                                icon: @image-url("../assets/icons/Compass.svg");
                                checked: root.lyrics-reduced-motion;
                                toggled => { root.lyrics-reduced-motion = !root.lyrics-reduced-motion; root.lyric-mode-changed(root.lyrics-stage, root.lyrics-reduced-motion, root.lyrics-passive-scroll); }
                            }
                            if root.mobile: SectionLabel { text: I18n.tr("Позначка локального файлу"); }
                            if !root.mobile: HorizontalLayout {
                                height: 56px;
                                padding-left: 12px; padding-right: 12px;
                                spacing: 12px;
                                Text { text: I18n.tr("Позначка локального файлу"); color: Tokens.ink-200; font-size: 13px; font-weight: 700; letter-spacing: 0.4px; horizontal-stretch: 1; vertical-alignment: center; }
                                Artwork { art: root.current-art; downloaded: true; width: 44px; height: 44px; border-radius: 8px; }
                            }
                            SwitchRow {
                                text: I18n.tr("Показувати позначку");
                                icon: @image-url("../assets/icons/LocalFile.svg");
                                checked: CoverBadges.shown;
                                toggled => { CoverBadges.shown = !CoverBadges.shown; root.preferences-changed(); }
                            }
                            if CoverBadges.shown: SettingsRow {
                                text: I18n.tr("Трикутник");
                                selected: CoverBadges.style == "triangle";
                                chevron: false;
                                clicked => { CoverBadges.style = "triangle"; root.preferences-changed(); }
                            }
                            if CoverBadges.shown: SettingsRow {
                                text: I18n.tr("Піктограма");
                                selected: CoverBadges.style == "icon";
                                chevron: false;
                                clicked => { CoverBadges.style = "icon"; root.preferences-changed(); }
                            }
                            if CoverBadges.shown: SectionLabel { text: I18n.tr("Розташування"); }
                            if CoverBadges.shown: SettingsRow {
                                text: I18n.tr("Знизу ліворуч");
                                selected: CoverBadges.position == "bottom-left";
                                chevron: false;
                                clicked => { CoverBadges.position = "bottom-left"; root.preferences-changed(); }
                            }
                            if CoverBadges.shown: SettingsRow {
                                text: I18n.tr("Знизу праворуч");
                                selected: CoverBadges.position == "bottom-right";
                                chevron: false;
                                clicked => { CoverBadges.position = "bottom-right"; root.preferences-changed(); }
                            }
                            if CoverBadges.shown: SettingsRow {
                                text: I18n.tr("Зверху ліворуч");
                                selected: CoverBadges.position == "top-left";
                                chevron: false;
                                clicked => { CoverBadges.position = "top-left"; root.preferences-changed(); }
                            }
                            if CoverBadges.shown: SettingsRow {
                                text: I18n.tr("Зверху праворуч");
                                selected: CoverBadges.position == "top-right";
                                chevron: false;
                                clicked => { CoverBadges.position = "top-right"; root.preferences-changed(); }
                            }
                            SectionLabel { text: I18n.tr("Фон обкладинки"); }
                            SettingsRow {
                                text: I18n.tr("Спокійний");
                                selected: root.kawarp-warp < 0.6;
                                chevron: false;
                                clicked => { root.kawarp-opacity = 0.22; root.kawarp-warp = 0.4; root.kawarp-blur = 22; root.kawarp-saturation = 1; root.kawarp-dithering = 0.01; root.kawarp-dim = true; root.preferences-changed(); }
                            }
                            SettingsRow {
                                text: I18n.tr("Виразний");
                                selected: root.kawarp-warp >= 0.6;
                                chevron: false;
                                clicked => { root.kawarp-opacity = 0.36; root.kawarp-warp = 0.85; root.kawarp-blur = 18; root.kawarp-saturation = 1.3; root.kawarp-dithering = 0.015; root.kawarp-dim = true; root.preferences-changed(); }
                            }
                            HorizontalLayout {
                                padding-left: 12px; padding-right: 12px;
                                Text { text: I18n.tr("Непрозорість") + " · " + round(root.kawarp-opacity * 100) / 100; color: Tokens.ink-200; font-size: 13px; }
                            }
                            TonalSlider { height: 44px; minimum: 0; maximum: 1; value: root.kawarp-opacity; label: I18n.tr("Непрозорість"); changed(value) => { root.kawarp-opacity = value; root.preferences-changed(); } }
                            HorizontalLayout {
                                padding-left: 12px; padding-right: 12px;
                                Text { text: I18n.tr("Інтенсивність") + " · " + round(root.kawarp-warp * 100) / 100; color: Tokens.ink-200; font-size: 13px; }
                            }
                            TonalSlider { height: 44px; minimum: 0; maximum: 1; value: root.kawarp-warp; label: I18n.tr("Інтенсивність"); changed(value) => { root.kawarp-warp = value; root.preferences-changed(); } }
                            HorizontalLayout {
                                padding-left: 12px; padding-right: 12px;
                                Text { text: I18n.tr("Розмиття") + " · " + round(root.kawarp-blur * 1) / 1; color: Tokens.ink-200; font-size: 13px; }
                            }
                            TonalSlider { height: 44px; minimum: 1; maximum: 40; value: root.kawarp-blur; label: I18n.tr("Розмиття"); changed(value) => { root.kawarp-blur = round(value); root.preferences-changed(); } }
                            HorizontalLayout {
                                padding-left: 12px; padding-right: 12px;
                                Text { text: I18n.tr("Насиченість") + " · " + round(root.kawarp-saturation * 100) / 100; color: Tokens.ink-200; font-size: 13px; }
                            }
                            TonalSlider { height: 44px; minimum: 0; maximum: 2; value: root.kawarp-saturation; label: I18n.tr("Насиченість"); changed(value) => { root.kawarp-saturation = value; root.preferences-changed(); } }
                            HorizontalLayout {
                                padding-left: 12px; padding-right: 12px;
                                Text { text: I18n.tr("Дизеринг") + " · " + round(root.kawarp-dithering * 1000) / 1000; color: Tokens.ink-200; font-size: 13px; }
                            }
                            TonalSlider { height: 44px; minimum: 0; maximum: 0.05; value: root.kawarp-dithering; label: I18n.tr("Дизеринг"); changed(value) => { root.kawarp-dithering = value; root.preferences-changed(); } }
                            SwitchRow {
                                text: I18n.tr("Затемнювати світлі обкладинки");
                                icon: @image-url("../assets/icons/Palette.svg");
                                checked: root.kawarp-dim;
                                toggled => { root.kawarp-dim = !root.kawarp-dim; root.preferences-changed(); }
                            }
                            SettingsRow {
                                text: I18n.tr("Скинути фон");
                                icon: @image-url("../assets/icons/RefreshCw.svg");
                                chevron: false;
                                clicked => { root.kawarp-opacity = 0.28; root.kawarp-warp = 1; root.kawarp-blur = 15; root.kawarp-saturation = 1.5; root.kawarp-dithering = 0.02; root.kawarp-dim = true; root.preferences-changed(); }
                            }
                        }
                        if root.settings-section == "audio": VerticalLayout {
                            spacing: 0px;
                            SectionLabel { text: I18n.tr("Відтворення"); }
                            HorizontalLayout {
                                height: 48px;
                                padding-left: 12px; padding-right: 12px;
                                Text { text: I18n.tr("Гучність"); color: Tokens.ink-100; font-size: 15px; font-weight: 500; horizontal-stretch: 1; vertical-alignment: center; }
                                Text { text: round(root.volume * 100) + "%"; color: Tokens.ink-300; font-size: 13px; vertical-alignment: center; }
                            }
                            TonalSlider { height: 44px; label: I18n.tr("Гучність"); value <=> root.volume; changed(value) => { root.volume-changed(value); } }
                        }
                        if root.settings-section == "lyrics": LyricsSettings {
                            embedded: false;
                            provider <=> root.lyrics-provider;
                            romanization <=> root.lyrics-romanization;
                            translation <=> root.lyrics-translation;
                            language <=> root.lyrics-translation-language;
                            secondary-gap <=> root.lyrics-secondary-gap;
                            status: root.lyrics-enrichment-status;
                            reduced-motion <=> root.lyrics-reduced-motion;
                            stage <=> root.lyrics-stage;
                            passive <=> root.lyrics-passive-scroll;
                            appearance => { root.dialog = "lyric-style"; }
                            provider-changed(value) => { root.provider-changed(value); }
                            display-changed => { root.preferences-changed(); }
                            mode-changed => { root.lyric-mode-changed(root.lyrics-stage, root.lyrics-reduced-motion, root.lyrics-passive-scroll); }
                        }
                        if root.settings-section == "library": VerticalLayout {
                            spacing: 0px;
                            SectionLabel { text: I18n.tr("Джерела музики"); }
                            HorizontalLayout {
                                padding-left: 12px; padding-right: 12px; padding-bottom: 8px;
                                Text { text: I18n.tr("Додайте файли або вкажіть папку з музикою."); color: Tokens.ink-300; font-size: 12px; wrap: word-wrap; }
                            }
                            for source[index] in root.sources: Rectangle {
                                height: 56px; border-radius: 10px; background: transparent;
                                HorizontalLayout { padding-left: 12px; padding-right: 6px; spacing: 16px;
                                    VerticalLayout { width: 22px; alignment: center; Image { source: @image-url("../assets/icons/FolderPlus.svg"); width: 22px; height: 22px; colorize: Tokens.ink-200; } }
                                    Text { text: source; color: Tokens.ink-150; font-size: 15px; overflow: elide; horizontal-stretch: 1; vertical-alignment: center; }
                                    Action { icon: @image-url("../assets/icons/X.svg"); label: I18n.tr("Видалити джерело"); comfortable: true; clicked => { root.remove-source(index); } }
                                }
                            }
                            if root.android-platform: HorizontalLayout {
                                padding-left: 12px; padding-right: 12px; padding-top: 8px;
                                Text { text: I18n.tr("Сканування знаходить музику на пристрої та карті пам’яті. Дозвольте доступ до музики й аудіо в запиті Android."); color: Tokens.ink-300; font-size: 12px; wrap: word-wrap; }
                            }
                            SettingsRow {
                                text: root.android-platform ? I18n.tr("Дозволити доступ до музики") : I18n.tr("Додати файли");
                                icon: @image-url("../assets/icons/Plus.svg");
                                accent: true;
                                chevron: false;
                                clicked => { root.add-source("file"); }
                            }
                            if !root.mobile && !root.android-platform: SettingsRow {
                                text: I18n.tr("Додати папку");
                                icon: @image-url("../assets/icons/FolderPlus.svg");
                                chevron: false;
                                clicked => { root.add-source("folder"); }
                            }
                            SettingsRow {
                                text: I18n.tr("Вказати шлях");
                                icon: @image-url("../assets/icons/LocalFile.svg");
                                chevron: false;
                                clicked => { root.dialog = "source"; root.new-name = ""; }
                            }
                            SettingsRow {
                                text: I18n.tr("Оновити бібліотеку");
                                icon: @image-url("../assets/icons/RefreshCw.svg");
                                chevron: false;
                                clicked => { root.scan(); }
                            }
                        }
                        if root.settings-section == "data": VerticalLayout {
                            spacing: 0px;
                            SectionLabel { text: I18n.tr("Підключення"); }
                            SettingsRow {
                                text: I18n.tr("Відкрити YouTube Music");
                                icon: @image-url("../assets/icons/Music2.svg");
                                accent: true;
                                chevron: false;
                                clicked => { root.open-login(); }
                            }
                            HorizontalLayout {
                                padding-left: 12px; padding-right: 12px; padding-bottom: 8px;
                                Text { text: I18n.tr(root.jwt-status); color: Tokens.ink-300; font-size: 12px; wrap: word-wrap; }
                            }
                            SettingsRow {
                                text: I18n.tr("Оновити доступ до слів");
                                icon: @image-url("../assets/icons/RefreshCw.svg");
                                chevron: false;
                                clicked => { root.open-challenge(); }
                            }
                            SettingsRow {
                                text: I18n.tr("Вставити токен");
                                icon: @image-url("../assets/icons/Key.svg");
                                chevron: false;
                                clicked => { root.dialog = "auth"; }
                            }
                            SectionLabel { text: I18n.tr("Ваші дані"); }
                            SettingsRow {
                                text: I18n.tr("Експорт");
                                icon: @image-url("../assets/icons/Download.svg");
                                chevron: false;
                                clicked => { root.backup(); }
                            }
                            SettingsRow {
                                text: I18n.tr("Імпорт");
                                icon: @image-url("../assets/icons/LocalFile.svg");
                                chevron: false;
                                clicked => { root.restore(); }
                            }
                            SettingsRow {
                                text: I18n.tr("Перенести дані");
                                icon: @image-url("../assets/icons/ListMusic.svg");
                                chevron: false;
                                clicked => { root.migrate(); }
                            }
                            SettingsRow {
                                text: I18n.tr("Очистити історію");
                                icon: @image-url("../assets/icons/X.svg");
                                chevron: false;
                                clicked => { root.clear-history(); }
                            }
                            SettingsRow {
                                text: I18n.tr("Відновити теги");
                                icon: @image-url("../assets/icons/RefreshCw.svg");
                                chevron: false;
                                clicked => { root.restore-tags(); }
                            }
                        }
                        if root.settings-section == "about": VerticalLayout {
                            spacing: 0px;
                            SettingsRow {
                                text: "Vey";
                                detail: I18n.tr("Музика, до якої хочеться повернутись.");
                                icon: @image-url("../assets/icons/Info.svg");
                                chevron: false;
                                clickable: false;
                            }
                            SettingsRow {
                                text: I18n.tr("Версія");
                                value: root.app-version;
                                icon: @image-url("../assets/icons/Info.svg");
                                chevron: false;
                                clickable: false;
                            }
                            HorizontalLayout {
                                padding: 12px;
                                Text { text: "Rust · Slint · Braccato"; color: Tokens.ink-300; font-size: 12px; }
                            }
                        }
                    }
                }

                if page-layer.route != "settings": VerticalLayout {
                    spacing: 18px;
                    if ((page-layer.route == "home" && root.home-layout != 2 && root.home-layout != 4) || page-layer.route == "explore") && page-layer.page-tracks.length > 0: ScrollView {
                        horizontal-scrollbar-policy: always-off;
                        vertical-scrollbar-policy: always-off;
                        mouse-drag-pan-enabled: true;
                        height: page-layer.route == "home" && root.home-layout == 1 ? (root.mobile ? 228px : 266px) : root.mobile ? 218px : (content.width < 900px ? 236px : 284px);
                        content-width: max(self.width, min(page-layer.page-tracks.length, 8) * ((page-layer.route == "home" && root.home-layout == 1 ? (root.mobile ? 158px : 196px) : root.mobile ? 148px : max(156px, min(204px, (content.width - 152px) / 5))) + 16px));
                        content-height: self.height;
                        HorizontalLayout {
                            spacing: 16px; alignment: start;
                            for track[index] in page-layer.page-tracks: Rectangle {
                                width: page-layer.route == "home" && root.home-layout == 1 ? (root.mobile ? 158px : 196px) : root.mobile ? 148px : max(156px, min(204px, (content.width - 152px) / 5));
                                visible: index < 8;
                                border-radius: 20px;
                                background: card-touch.has-hover ? Tokens.neutral-150 : transparent;
                                animate background { duration: Motion.feedback; }
                                VerticalLayout {
                                    spacing: 8px; padding: 8px;
                                    Artwork { art: track.art; downloaded: track.downloaded; mark-clicked => { root.status = I18n.tr("Доступно локально"); } height: self.width; tone: index; border-radius: page-layer.route == "home" && root.home-layout == 5 ? self.width / 2 : 12px; }
                                    Text { text: track.title; color: track.path == root.current-track-key ? Tokens.brand-300 : Tokens.ink-100; font-size: 14px; font-weight: 600; overflow: elide; }
                                    Text { text: I18n.tr("Пісня · ") + track.artist; color: Tokens.ink-200; font-size: 12px; overflow: elide; }
                                    Rectangle { vertical-stretch: 1; }
                                }
                                if card-touch.has-hover: Rectangle {
                                    width: 44px; height: 44px;
                                    x: parent.width - 60px; y: parent.width - 60px;
                                    border-radius: 22px;
                                    background: Tokens.brand-500;
                                    Image { source: @image-url("../assets/icons/Play.svg"); width: 20px; height: 20px; x: 13px; y: 12px; colorize: Tokens.brand-ink; }
                                }
                                card-touch := TouchArea { mouse-cursor: pointer; clicked => { root.select-track(index); } }
                                accessible-role: button;
                                accessible-label: track.title + " · " + track.artist;
                                accessible-action-default => { root.select-track(index); }
                            }
                        }
                    }

                    if page-layer.page-tracks.length > 0: HorizontalLayout {
                        visible: page-layer.route != "playlist";
                        height: root.mobile ? 40px : 52px;
                        spacing: 10px;
                        Text {
                            text: page-layer.route == "home" ? I18n.tr("Швидкий вибір") : page-layer.page-tracks.length + I18n.tr(" композицій");
                            color: Tokens.ink-100;
                            font-size: page-layer.route == "home" && !root.mobile ? 26px : 16px;
                            font-weight: 700;
                            vertical-alignment: center;
                            horizontal-stretch: 1;
                        }
                        Action { text: I18n.tr("Відтворити все"); icon: @image-url("../assets/icons/Play.svg"); outlined: true; clicked => { root.select-track(0); } }
                        if page-layer.route == "playlist": Action { text: I18n.tr("Видалити список"); outlined: true; clicked => { root.delete-playlist(); } }
                    }

                    if page-layer.route == "playlist" && root.mobile: HorizontalLayout {
                        height: root.mobile ? 148px : 184px; spacing: root.mobile ? 14px : 22px;
                        Rectangle { width: root.mobile ? 112px : 152px; height: root.mobile ? 112px : 152px; border-radius: 12px; clip: true; background: Tokens.neutral-150;
                            Image { source: root.playlist-art; width: 100%; height: 100%; image-fit: cover; }
                        }
                        VerticalLayout { spacing: 8px; alignment: center; horizontal-stretch: 1;
                            Text { text: root.playlist-title; color: Tokens.ink-100; font-size: root.mobile ? 22px : 30px; font-weight: 700; overflow: elide; }
                            Text { text: root.playlist-detail; color: Tokens.ink-300; font-size: 13px; overflow: elide; }
                            HorizontalLayout { spacing: 10px;
                                Action { text: I18n.tr("Відтворити"); icon: @image-url("../assets/icons/Play.svg"); comfortable: true; clicked => { if page-layer.page-tracks.length > 0 { root.select-track(0); } } }
                                Action { text: root.playlist-public ? I18n.tr("Опубліковано у профілі") : I18n.tr("Показати у профілі"); outlined: true; clicked => { root.set-playlist-public(!root.playlist-public); } }
                                Action { text: I18n.tr("Видалити"); outlined: true; clicked => { root.delete-playlist(); } }
                            }
                        }
                    }

                    if page-layer.page-tracks.length == 0 && (page-layer.route != "playlist" || root.mobile): Rectangle {
                        height: 220px; border-radius: 0px; background: transparent; border-width: 0px; border-color: transparent;
                        VerticalLayout {
                            alignment: center; spacing: 12px; padding: 24px;
                            Text { text: page-layer.route == "search" ? I18n.tr("Нічого не знайдено") : page-layer.route == "playlist" ? I18n.tr("У списку ще немає композицій") : I18n.tr("Тут з’явиться ваша музика"); color: Tokens.ink-100; font-size: 20px; font-weight: 700; horizontal-alignment: center; }
                            Text { text: page-layer.route == "playlist" ? I18n.tr("Додавайте пісні через меню композиції") : I18n.tr("Додайте файли або скористайтеся пошуком музики"); color: Tokens.ink-300; horizontal-alignment: center; wrap: word-wrap; }
                            if page-layer.route != "playlist": HorizontalLayout { alignment: center;
                                Action { text: page-layer.route == "explore" || page-layer.route == "search" || page-layer.route == "liked" ? I18n.tr("Пошук музики") : I18n.tr("Додати файли"); icon: @image-url("../assets/icons/Plus.svg"); comfortable: true; primary: true; clicked => { if page-layer.route == "explore" { root.refresh-explore(); } else if page-layer.route == "search" || page-layer.route == "liked" { root.navigate("search"); } else { root.add-source("file"); } } }
                            }
                        }
                    }

                    if page-layer.route == "home" && !root.mobile: HorizontalLayout {
                        spacing: 20px;
                        for col in [0, 1, 2]: VerticalLayout {
                            spacing: 4px;
                            for ri in [0, 1, 2, 3]: tile := SongRow {
                                visible: col * 4 + ri < page-layer.page-tracks.length;
                                property <TrackRow> song: page-layer.page-tracks[col * 4 + ri];
                                title: tile.song.title; artist: tile.song.artist; album: tile.song.album;
                                art: tile.song.art; downloaded: tile.song.downloaded; tone: col * 4 + ri;
                                current: tile.song.path == root.current-track-key;
                                mobile: true; actions: false; filled: true;
                                activated => { root.select-track(col * 4 + ri); }
                                mark-clicked => { root.status = I18n.tr("Доступно локально"); }
                            }
                            Rectangle { vertical-stretch: 1; }
                        }
                    }

                    if (page-layer.route != "home" || root.mobile) && page-layer.route != "playlist": ListView {
                        min-height: root.mobile && page-layer.page-tracks.length > 0 ? (page-layer.route == "home" ? 320px : 120px) : 0px;
                        for track[index] in page-layer.page-tracks: SongRow {
                            title: track.title; artist: track.artist; album: track.album; duration: track.duration;
                            art: track.art; downloaded: track.downloaded; downloading: track.downloading; liked: track.liked;
                            tone: index; mobile: root.mobile; album-column: !root.mobile && root.width >= 1120px; current: track.path == root.current-track-key;
                            removable: page-layer.route == "playlist";
                            activated => { root.select-track(index); }
                            like-clicked => { root.toggle-like(index); }
                            download-clicked => { root.download(index); }
                            remove-clicked => { root.remove-from-playlist(index); }
                            mark-clicked => { root.status = I18n.tr("Доступно локально"); }
                        }
                    }

                    if page-layer.route == "playlist" && !root.mobile: HorizontalLayout {
                        vertical-stretch: 1; min-height: 320px; spacing: 36px;
                        VerticalLayout {
                            width: min(root.width * 0.25, 420px); alignment: center; spacing: 16px;
                            Rectangle {
                                width: min(root.width * 0.23, 380px); height: min(root.width * 0.23, 380px); border-radius: 14px; clip: true; background: Tokens.neutral-150;
                                if page-layer.page-tracks.length == 1: Image { source: page-layer.page-tracks[0].art; width: 100%; height: 100%; image-fit: cover; }
                                if page-layer.page-tracks.length > 1: Image { source: page-layer.page-tracks[0].art; x: 0px; y: 0px; width: 50%; height: 50%; image-fit: cover; }
                                if page-layer.page-tracks.length > 1: Image { source: page-layer.page-tracks[1].art; x: parent.width / 2; y: 0px; width: 50%; height: 50%; image-fit: cover; }
                                if page-layer.page-tracks.length > 2: Image { source: page-layer.page-tracks[2].art; x: 0px; y: parent.height / 2; width: 50%; height: 50%; image-fit: cover; }
                                if page-layer.page-tracks.length > 3: Image { source: page-layer.page-tracks[3].art; x: parent.width / 2; y: parent.height / 2; width: 50%; height: 50%; image-fit: cover; }
                            }
                            Text { text: root.playlist-title; color: Tokens.ink-100; font-size: 28px; font-weight: 700; horizontal-alignment: center; overflow: elide; }
                            Text { text: root.playlist-detail; color: Tokens.ink-300; font-size: 13px; horizontal-alignment: center; wrap: word-wrap; }
                            HorizontalLayout { alignment: center; spacing: 12px;
                                Rectangle {
                                    width: 64px; height: 64px; border-radius: 32px; background: Tokens.ink-100;
                                    Image { source: @image-url("../assets/icons/Play.svg"); width: 26px; height: 26px; x: 20px; y: 19px; colorize: Tokens.neutral-0; }
                                    TouchArea { enabled: page-layer.page-tracks.length > 0; mouse-cursor: pointer; clicked => { if page-layer.page-tracks.length > 0 { root.select-track(0); } } }
                                    accessible-role: button; accessible-label: I18n.tr("Відтворити плейлист");
                                }
                                Action { text: root.playlist-public ? I18n.tr("Опубліковано") : I18n.tr("Опублікувати"); outlined: true; clicked => { root.set-playlist-public(!root.playlist-public); } }
                                Action { icon: @image-url("../assets/icons/X.svg"); label: I18n.tr("Видалити плейлист"); outlined: true; clicked => { root.delete-playlist(); } }
                            }
                        }
                        VerticalLayout {
                            vertical-stretch: 1; min-width: 0px; spacing: 8px;
                            HorizontalLayout { height: 40px; spacing: 12px;
                                Text { text: page-layer.page-tracks.length + I18n.tr(" композицій"); color: Tokens.ink-100; font-size: 16px; font-weight: 700; vertical-alignment: center; horizontal-stretch: 1; }
                            }
                            if page-layer.page-tracks.length == 0: Rectangle { vertical-stretch: 1; VerticalLayout { alignment: center; Text { text: I18n.tr("У списку ще немає композицій"); color: Tokens.ink-200; horizontal-alignment: center; } } }
                            if page-layer.page-tracks.length > 0: ListView {
                                vertical-stretch: 1; min-height: 0px;
                                for track[index] in page-layer.page-tracks: SongRow {
                                    title: track.title; artist: track.artist; album: track.album; duration: track.duration; art: track.art;
                                    downloaded: track.downloaded; downloading: track.downloading; liked: track.liked;
                                    tone: index; mobile: false; album-column: root.width >= 1280px; current: track.path == root.current-track-key; removable: true;
                                    activated => { root.select-track(index); }
                                    like-clicked => { root.toggle-like(index); }
                                    download-clicked => { root.download(index); }
                                    remove-clicked => { root.remove-from-playlist(index); }
                                    mark-clicked => { root.status = I18n.tr("Доступно локально"); }
                                }
                            }
                        }
                    }
                }
            }
        }
        }

        if root.page-phase != 1 && root.displayed-view != "lyrics": TouchArea { }

        // =========================================================================
        // Now playing: open artwork stage and synchronized lyrics
        // =========================================================================
        player-stage := Rectangle {
            property <bool> warming: root.warm-page == 8 && root.page-phase == 1 && !root.player-on-stage;
            visible: root.navigation-capture && root.navigation-capture-target ? root.active-view == "lyrics" : root.player-on-stage || (self.warming && !root.colors-changing);
            x: root.navigation-capture && root.navigation-capture-target ? 0px : self.warming ? content.width - 1px : root.player-motion-x * 1px;
            y: root.navigation-capture && root.navigation-capture-target ? 0px : self.warming ? 0px : root.player-motion-y * 1px; width: 100%; height: 100%;
            opacity: root.navigation-capture && root.navigation-capture-target ? 1 : self.warming ? 0.003922 : root.player-reveal * (1 - root.navigation-blend);
            // Lyrics change each tick: a permanent full-page cache is redrawn
            // anyway. Keep it only for camera composition and offscreen warming.
            cache-rendering-hint: root.page-moving || self.warming;
            background: root.mobile && !root.navigation-capture ? Tokens.neutral-50 : transparent;
            border-radius: root.mobile ? (PlayerTheme.enabled ? PlayerTheme.corner * 1px : 28px) : 0px;
            clip: true;
            if root.mobile: Rectangle {
                visible: !root.navigation-capture;
                width: 100%; height: 100%; border-radius: PlayerTheme.enabled ? PlayerTheme.corner * 1px : 28px; clip: true;
                Image { source: root.ambient-frame; width: 100%; height: 100%; image-fit: fill; opacity: root.ambient-opacity; }
            }
            if root.mobile: TouchArea {} // The sheet consumes input above the retained page.
            VerticalLayout {
            width: 100%; height: 100%;
            padding-left: root.mobile ? 16px : (root.immersive ? max(44px, (content.width - 1560px) / 2) : max(40px, (content.width - 1480px) / 2));
            padding-right: root.mobile ? 16px : (root.immersive ? max(44px, (content.width - 1560px) / 2) : max(40px, (content.width - 1480px) / 2));
            padding-top: root.mobile ? 12px : (root.immersive ? 22px : 18px);
            padding-bottom: root.mobile ? 12px : (root.immersive ? 24px : 18px);
            spacing: root.mobile ? 10px : (root.immersive ? 18px : 14px);

            // Keep swipe-to-dismiss separate from the lyrics' vertical scroll.
            if root.mobile: Rectangle {
                width: 100%; height: 20px; background: transparent;
                Rectangle {
                    x: (parent.width - 36px) / 2; y: 5px;
                    width: 36px; height: 4px; border-radius: 2px;
                    background: Tokens.ink-300;
                }
                TouchArea {
                    pointer-event(event) => {
                        if event.kind == PointerEventKind.cancel {
                            root.sheet-pointer-active = false;
                            return;
                        }
                        if event.button == PointerEventButton.left && event.kind == PointerEventKind.down {
                            root.sheet-press-x = self.mouse-x;
                            root.sheet-press-y = self.mouse-y;
                            root.sheet-pointer-active = true;
                        }
                        if event.button == PointerEventButton.left && event.kind == PointerEventKind.up {
                            if !root.sheet-pointer-active { return; }
                            root.sheet-pointer-active = false;
                            let dx = abs(self.mouse-x - root.sheet-press-x);
                            let dy = self.mouse-y - root.sheet-press-y;
                            if dy > max(28px, root.height * 0.06) && dx < max(40px, root.width * 0.12) {
                                root.close-player();
                            }
                        }
                    }
                }
            }

            // Player Stage Header Bar
            if !root.expanded-active && (!root.immersive || root.mobile): HorizontalLayout {
                height: 40px;
                spacing: 10px;
                Action {
                    icon: @image-url("../assets/icons/ChevronDown.svg");
                    label: I18n.tr("Згорнути програвач");
                    outlined: true;
                    clicked => { root.close-player(); }
                }
                if root.mobile: Rectangle { horizontal-stretch: 1; }
                if !root.mobile: VerticalLayout {
                    alignment: center;
                    horizontal-stretch: 1;
                    spacing: 2px;
                    Text {
                        text: I18n.tr("Зараз грає");
                        color: Tokens.ink-100;
                        font-size: 14px;
                        font-weight: 700;
                        letter-spacing: 0px;
                        overflow: elide;
                    }
                    if !root.mobile && root.current-album != "": Text {
                        text: root.current-artist + " · " + root.current-album;
                        color: Tokens.ink-300;
                        font-size: 12px;
                        overflow: elide;
                    }
                }
                if root.mobile: Action { text: root.art-mode == "cover" ? I18n.tr("Кліп") : I18n.tr("Обкладинка"); comfortable: true; selected: root.art-mode == "clip"; clicked => { root.change-art-mode(); } }
                // Cover / Clip Pill Switcher
                if !root.mobile: Rectangle {
                    height: 36px; width: 176px;
                    border-radius: 18px;
                    background: #ffffff12;
                    border-width: 0px;
                    border-color: #ffffff18;
                    HorizontalLayout {
                        padding: 3px; spacing: 2px;
                        Rectangle {
                            horizontal-stretch: 1; border-radius: 15px;
                            background: root.art-mode == "cover" ? Tokens.ink-100 : transparent;
                            Text { text: I18n.tr("Обкладинка"); color: root.art-mode == "cover" ? Tokens.neutral-0 : Tokens.ink-200; font-size: 12px; font-weight: 700; horizontal-alignment: center; vertical-alignment: center; }
                            TouchArea { mouse-cursor: pointer; clicked => { if root.art-mode != "cover" { root.change-art-mode(); } } }
                        }
                        Rectangle {
                            horizontal-stretch: 1; border-radius: 15px;
                            background: root.art-mode != "cover" ? Tokens.ink-100 : transparent;
                            Text { text: I18n.tr("Кліп"); color: root.art-mode != "cover" ? Tokens.neutral-0 : Tokens.ink-200; font-size: 12px; font-weight: 700; horizontal-alignment: center; vertical-alignment: center; }
                            TouchArea { mouse-cursor: pointer; clicked => { if root.art-mode == "cover" { root.change-art-mode(); } } }
                        }
                    }
                }
                if !root.mobile: Action {
                    icon: @image-url("../assets/icons/MonitorPlay.svg");
                    label: I18n.tr("Розгорнути програвач");
                    selected: root.immersive;
                    outlined: true;
                    clicked => { root.player-tab = "lyrics"; root.expanded-player = true; }
                }
                Action {
                    icon: @image-url("../assets/icons/Settings.svg");
                    label: I18n.tr("Інструменти слів пісні");
                    selected: root.player-tools;
                    outlined: true;
                    clicked => { root.player-tools = !root.player-tools; }
                }
            }

            // Main Split Stage: Left Hero Vinyl/Cover Card + Right Synchronized Lyrics & Queue
            HorizontalLayout {
                vertical-stretch: 1;
                spacing: root.mobile ? 0px : root.immersive || root.expanded-active ? 72px : 48px;

                // Left Column: Album Art Showcase + Track Metadata + Full Studio Transport Deck
                if !root.mobile: Rectangle {
                    width: min(content.width * (PlayerTheme.enabled ? PlayerTheme.artwork-share : 0.44), 620px);
                    background: transparent;
                    border-radius: 32px;
                    border-width: 0px;
                    border-color: transparent;

                    VerticalLayout {
                        padding: 0px;
                        spacing: root.immersive ? 16px : 12px;
                        alignment: center;

                        // Unframed cover artwork
                        HorizontalLayout {
                            alignment: center;
                            Rectangle {
                                property <length> art-edge: min(parent.width, max(132px, content.height - (root.immersive ? 280px : 120px)));
                                width: self.art-edge;
                                height: self.art-edge;
                                border-radius: PlayerTheme.artwork-corner * 1px;
                                MediaSlot {
                                    cover: root.current-art; frame: root.video-frame; active: root.art-mode == "clip" && root.player-on-stage;
                                    width: 100%; height: 100%;
                                    geometry(x,y,width,height) => { root.video-x=x; root.video-y=y; root.video-width=width; root.video-height=height; }
                                }
                            }
                        }

                        // Track Title, Artist, Quick Like & More Actions
                        if root.immersive || root.expanded-active: HorizontalLayout {
                            height: 54px;
                            spacing: 12px;
                            VerticalLayout {
                                horizontal-stretch: 1;
                                alignment: center;
                                spacing: 4px;
                                Text {
                                    text: root.current-title;
                                    color: Tokens.ink-100;
                                    font-size: root.immersive ? 24px : 20px;
                                    font-weight: 700;
                                    overflow: elide;
                                }
                                HorizontalLayout {
                                    spacing: 4px;
                                    Text {
                                        text: root.current-artist + (root.current-album == "" ? "" : " · " + root.current-album);
                                        color: Tokens.ink-200;
                                        font-size: 15px;
                                        font-weight: 500;
                                        overflow: elide;
                                        horizontal-stretch: 1;
                                    }
                                }
                            }
                            if root.immersive: VerticalLayout {
                                alignment: center;
                                HorizontalLayout {
                                    spacing: 6px;
                                    Action {
                                        icon: @image-url("../assets/icons/Heart.svg");
                                        label: I18n.tr("Подобається");
                                        selected: root.current-liked;
                                        outlined: true;
                                        clicked => { root.toggle-like(-1); }
                                    }
                                    Action {
                                        icon: @image-url("../assets/icons/Plus.svg");
                                        label: I18n.tr("Додати до списку");
                                        outlined: true;
                                        clicked => { root.dialog = "add"; }
                                    }
                                    Action {
                                        icon: @image-url("../assets/icons/Ellipsis.svg");
                                        label: I18n.tr("Дії з композицією");
                                        selected: root.player-tools;
                                        outlined: true;
                                        clicked => { root.player-tools = !root.player-tools; }
                                    }
                                }
                            }
                        }

                        // Interactive Scrubber, Timestamps & Transport Controls (Full-screen / Focus mode only)
                        if root.immersive: VerticalLayout {
                            spacing: 6px;
                            SeekBar {
                                position: root.position;
                                duration: root.duration;
                                accent: true;
                                seek(value) => { root.seek-to(round(value * 1000)); }
                            }
                            HorizontalLayout {
                                height: 16px;
                                Text { text: root.clock(root.position); color: Tokens.ink-200; font-size: 12px; font-weight: 600; }
                                Rectangle { horizontal-stretch: 1; }
                                Text {
                                    text: root.lyrics-timed ? I18n.tr("СИНХРОНІЗОВАНО") : I18n.tr("ТЕКСТ");
                                    color: Tokens.brand-300;
                                    font-size: 10px;
                                    font-weight: 700;
                                    letter-spacing: 0.8px;
                                }
                                Rectangle { horizontal-stretch: 1; }
                                Text { text: root.clock(root.duration); color: Tokens.ink-300; font-size: 12px; font-weight: 600; }
                            }
                        }

                        if root.immersive: HorizontalLayout {
                            height: 60px;
                            alignment: center;
                            spacing: 16px;
                            VerticalLayout {
                                alignment: center;
                                Action {
                                    icon: @image-url("../assets/icons/Shuffle.svg");
                                    label: I18n.tr("Перемішати");
                                    selected: root.shuffle;
                                    clicked => { root.toggle-shuffle(); }
                                }
                            }
                            VerticalLayout {
                                alignment: center;
                                Action {
                                    icon: @image-url("../assets/icons/SkipBack.svg");
                                    label: I18n.tr("Попередня композиція");
                                    clicked => { root.previous-track(); }
                                }
                            }
                            VerticalLayout {
                                alignment: center;
                                Transport {
                                    playing: root.player-state == "playing";
                                    clicked => { root.play-toggle(); }
                                }
                            }
                            VerticalLayout {
                                alignment: center;
                                Action {
                                    icon: @image-url("../assets/icons/SkipForward.svg");
                                    label: I18n.tr("Наступна композиція");
                                    clicked => { root.next-track(); }
                                }
                            }
                            VerticalLayout {
                                alignment: center;
                                Action {
                                    icon: @image-url("../assets/icons/Repeat.svg");
                                    label: I18n.tr("Повтор");
                                    selected: root.repeat-mode != "off";
                                    clicked => { root.toggle-repeat(); }
                                }
                            }
                        }
                    }
                }

                // Right Column: Synchronized Lyrics Stage & Inline Up-Next Queue
                Rectangle {
                    horizontal-stretch: 1;
                    vertical-stretch: 1;
                    background: transparent;
            border-radius: PlayerTheme.enabled ? PlayerTheme.corner * 1px : 24px;
                    border-width: 0px;
                    border-color: transparent;
                    VerticalLayout {
                    padding: root.mobile ? 0px : 12px;
                    spacing: root.mobile ? 8px : 14px;

                    // Pill Tab Switcher (ТЕКСТ ПІСНІ / ДАЛІ В ЧЕРЗІ / ПОВ’ЯЗАНІ) + Provider Badge
                    if root.mobile || (!root.immersive && !root.expanded-active): HorizontalLayout {
                        height: 42px;
                        spacing: 12px;
                        Rectangle {
                            horizontal-stretch: 1;
                            border-radius: root.mobile ? 21px : 0px;
                            background: root.mobile ? Tokens.neutral-100 : transparent;
                            border-width: 0px;
                            border-color: #ffffff16;
                            HorizontalLayout {
                                padding: root.mobile ? 4px : 0px; spacing: root.mobile ? 4px : 0px;
                                Rectangle {
                                    horizontal-stretch: 1;
                                    border-radius: 17px;
                                    background: root.mobile && root.player-tab == "lyrics" ? Tokens.primary-container : transparent;
                                    if !root.mobile && root.player-tab == "lyrics": Rectangle { x: 0px; y: parent.height - 1px; width: 100%; height: 1px; background: Tokens.ink-100; }
                                    Text {
                                        text: root.mobile ? I18n.tr("СЛОВА") : I18n.tr("ТЕКСТ ПІСНІ");
                                        color: root.player-tab == "lyrics" ? Tokens.ink-100 : Tokens.ink-300;
                                        font-size: 12px; font-weight: 700; letter-spacing: 0px;
                                        width: 100%; height: 100%;
                                        horizontal-alignment: center; vertical-alignment: center;
                                    }
                                    TouchArea { mouse-cursor: pointer; clicked => { root.player-tab = "lyrics"; } }
                                    accessible-role: button; accessible-label: I18n.tr("Текст пісні");
                                    accessible-action-default => { root.player-tab = "lyrics"; }
                                }
                                Rectangle {
                                    horizontal-stretch: 1;
                                    border-radius: 17px;
                                    background: root.mobile && root.player-tab == "queue" ? Tokens.primary-container : transparent;
                                    if !root.mobile && root.player-tab == "queue": Rectangle { x: 0px; y: parent.height - 1px; width: 100%; height: 1px; background: Tokens.ink-100; }
                                    Text {
                                        text: root.mobile ? I18n.tr("ЧЕРГА") : I18n.tr("ДАЛІ В ЧЕРЗІ");
                                        color: root.player-tab == "queue" ? Tokens.ink-100 : Tokens.ink-300;
                                        font-size: 12px; font-weight: 700; letter-spacing: 0px;
                                        width: 100%; height: 100%;
                                        horizontal-alignment: center; vertical-alignment: center;
                                    }
                                    TouchArea { mouse-cursor: pointer; clicked => { root.player-tab = "queue"; } }
                                    accessible-role: button; accessible-label: I18n.tr("Черга відтворення");
                                    accessible-action-default => { root.player-tab = "queue"; }
                                }
                                if !root.mobile: Rectangle {
                                    horizontal-stretch: 1;
                                    border-radius: 17px;
                                    Text {
                                        text: I18n.tr("РАДІО ТРЕКУ");
                                        color: Tokens.ink-300;
                                        font-size: 12px; font-weight: 700; letter-spacing: 0px;
                                        width: 100%; height: 100%;
                                        horizontal-alignment: center; vertical-alignment: center;
                                    }
                                    TouchArea { mouse-cursor: pointer; clicked => { root.radio(); } }
                                    accessible-role: button; accessible-label: I18n.tr("Радіо треку");
                                    accessible-action-default => { root.radio(); }
                                }
                            }
                        }
                    }

                    // Active Tab: Up Next Queue List inside Player View
                    if root.player-tab == "queue": Rectangle {
                        vertical-stretch: 1;
                        border-radius: 20px;
                        background: transparent;
                        border-width: 0px;
                        border-color: #ffffff14;
                        ListView {
                            for track[index] in root.tracks: SongRow {
                                title: track.title; artist: track.artist; album: track.album; duration: track.duration;
                                art: track.art; tone: index;
                                current: track.path == root.current-track-key; mobile: root.mobile; actions: false;
                                activated => { root.select-track(index); }
                                mark-clicked => { root.status = I18n.tr("Доступно локально"); }
                            }
                        }
                    }

                    // Active Tab: Empty Lyrics State
                    if root.player-tab == "lyrics" && root.lyric-lines.length == 0: Rectangle {
                        vertical-stretch: 1;
                        border-radius: 24px;
                        background: transparent;
                        border-width: 0px;
                        border-color: #ffffff12;
                        VerticalLayout {
                            alignment: center; spacing: 14px; padding: root.mobile ? 12px : 32px;
                            HorizontalLayout {
                                alignment: center;
                                Rectangle {
                                    width: 56px; height: 56px; border-radius: 28px;
                                    background: #ffffff10; border-width: 0px; border-color: #ffffff18;
                                    Image { source: @image-url("../assets/icons/Captions.svg"); width: 26px; height: 26px; x: 15px; y: 15px; colorize: Tokens.brand-300; }
                                }
                            }
                            Text { text: I18n.tr("Слова пісні"); color: Tokens.ink-100; font-size: 26px; font-weight: 700; horizontal-alignment: center; }
                            Text { text: I18n.tr(root.lyrics-status); color: Tokens.ink-200; font-size: 14px; wrap: word-wrap; horizontal-alignment: center; }
                            HorizontalLayout {
                                alignment: center; spacing: 10px;
                                Action { text: I18n.tr("Оновити"); icon: @image-url("../assets/icons/RefreshCw.svg"); primary: true; clicked => { root.refresh-lyrics(); } }
                                Action { text: I18n.tr("Вставити слова"); outlined: true; clicked => { root.dialog = "paste"; } }
                            }
                        }
                    }

                    // Active Tab: Synchronized Karaoke / Line-by-Line Lyrics Stage
                    if root.player-tab == "lyrics" && root.lyric-lines.length > 0 && !root.native-lyrics: BraccatoLyrics {
                        vertical-stretch: 1;
                        lyric-lines: root.lyric-lines;
                        external-view: root.lyrics-web-required || root.lyrics-web-ready;
                        waiting: root.lyrics-web-required && !root.lyrics-web-ready;
                        load-error: root.lyrics-renderer-error;
                        retry => { root.lyrics-renderer-generation += 1; }
                        widget-geometry(x,y,width,height) => {
                            // The embedded viewport stays fixed; its content receives
                            // the same visual translation through the host bridge.
                            root.lyrics-widget-x=round((x - player-stage.x / 1px) * 1000) / 1000;
                            root.lyrics-widget-y=round((y - player-stage.y / 1px) * 1000) / 1000;
                            root.lyrics-widget-width=width; root.lyrics-widget-height=height;
                        }
                        lyrics-timed: root.lyrics-timed;
                        word-timed: root.lyrics-word-timed;
                        active-lyric-index: root.active-lyric-index;
                        lyrics-position: root.lyrics-position;
                        lyrics-offset: root.lyrics-offset + root.lyrics-effective-offset-ms;
                        mobile: root.mobile;
                        lyric-size: root.lyric-size;
                        lyric-active: root.lyric-active;
                        lyric-inactive: root.lyric-inactive;
                        lyric-weight: root.lyric-weight;
                        scroll-target: root.lyrics-scroll-target;
                        geometry(index, top, height) => {root.lyric-geometry(index,top,height);}
                        viewport(height) => {root.lyrics-viewport-height=height;}
                        credits: root.player-tools ? root.lyrics-credits : "";
                        passive: root.lyrics-passive-scroll;
                        stage: root.lyrics-stage;
                        reduced-motion: root.lyrics-reduced-motion;
                        user-scrolling: root.lyrics-user-scrolling;
                        scroll-ratio: root.lyrics-scroll-ratio;
                        scroll-duration-ms: root.lyrics-scroll-duration-ms;
                        disable-richsync: root.lyrics-disable-richsync;
                        user-scroll => { root.lyric-user-scroll(); }
                        resume => { root.lyric-resume(); }
                        seek-to(position) => { root.seek-to(position); }
                    }

                    if root.player-tab == "lyrics" && root.lyric-lines.length > 0 && root.native-lyrics: NativeLyrics {
                        vertical-stretch: 1;
                        lines: root.native-lyric-lines;
                        focus-values: root.native-focus-values;
                        render-lines: root.native-render-lines;
                        render-start: root.native-render-start; render-end: root.native-render-end;
                        render-top: root.native-render-top; render-bottom: root.native-render-bottom;
                        instrumental-frames: root.native-instrumental;
                        active-line: root.native-active-line;
                        preload-line: root.native-preload-line;
                        scroll-position: root.native-scroll-position;
                        camera-driven: root.native-camera-driven;
                        camera-position: root.native-camera-position;
                        passive-progress: root.native-passive-progress;
                        time-ms: root.lyrics-position;
                        timed: root.lyrics-timed;
                        paused: root.player-state != "playing";
                        stage: root.lyrics-stage && root.lyrics-timed;
                        secondary-gap: root.lyrics-secondary-gap;
                        passive: root.lyrics-passive-scroll;
                        reduced: root.lyrics-reduced-motion;
                        manual: root.lyrics-user-scrolling;
                        richsync: !root.lyrics-disable-richsync;
                        size: root.mobile && root.lyric-size == 48 ? 32 : clamp(root.lyric-size,12,72);
                        active-color: root.lyric-active;
                        inactive-color: root.lyric-inactive;
                        weight: root.lyric-weight;
                        style: root.lyric-style;
                        native-text-gradients: root.native-text-gradients;
                        scroll-duration: root.lyrics-scroll-duration-ms;
                        scroll-snap: root.native-scroll-snap;
                        scroll-ratio: root.lyrics-scroll-ratio;
                        credits: root.player-tools ? root.lyrics-credits : "";
                        geometry(width,height) => {root.lyrics-widget-width=width;root.lyrics-viewport-height=height;}
                        viewport(y,extent) => {root.native-content-y=y;root.native-content-height=extent;}
                        seek(line,part) => {root.native-lyric-seek(line,part);}
                        user-scroll => {root.lyric-user-scroll();}
                        resume => {root.lyric-resume();}
                    }

                    // Compact Mobile Now-Playing Header + Transport Card
                    if root.mobile: Rectangle {
                        height: 162px;
                        border-radius: 28px;
                        background: transparent;
                        border-width: 0px;
                        border-color: #ffffff1c;
                        VerticalLayout {
                            padding: 4px; spacing: 8px;
                            HorizontalLayout {
                                spacing: 12px;
                                MediaSlot { cover: root.current-art; frame: root.video-frame; active: root.art-mode == "clip" && root.player-on-stage; width: root.art-mode == "clip" ? 100px : 56px; height: 56px; border-radius: 10px;
                                    geometry(x,y,width,height) => { root.video-x=x; root.video-y=y; root.video-width=width; root.video-height=height; }
                                }
                                VerticalLayout {
                                    alignment: center; horizontal-stretch: 1; spacing: 3px;
                                    Text { text: root.current-title; color: Tokens.ink-100; font-size: 16px; font-weight: 700; overflow: elide; }
                                    HorizontalLayout {
                                        spacing: 4px;
                                        Text { text: root.current-artist; color: Tokens.ink-200; font-size: 13px; overflow: elide; horizontal-stretch: 1; }
                                    }
                                }
                                VerticalLayout {
                                    alignment: center;
                                    Action { comfortable: true; label: I18n.tr("Подобається"); icon: @image-url("../assets/icons/Heart.svg"); selected: root.current-liked; clicked => { root.toggle-like(-1); } }
                                }
                            }
                            SeekBar {
                                position: root.position;
                                duration: root.duration;
                                accent: true;
                                seek(value) => { root.seek-to(round(value * 1000)); }
                            }
                            HorizontalLayout {
                                height: 14px;
                                Text { text: root.clock(root.position); color: Tokens.ink-200; font-size: 11px; }
                                Rectangle { horizontal-stretch: 1; }
                                Text { text: root.clock(root.duration); color: Tokens.ink-200; font-size: 11px; horizontal-alignment: right; }
                            }
                            HorizontalLayout {
                                height: 48px; alignment: center;
                                HorizontalLayout {
                                    spacing: 6px; alignment: center;
                                    Action { comfortable: true; label: I18n.tr("Перемішати"); icon: @image-url("../assets/icons/Shuffle.svg"); selected: root.shuffle; clicked => { root.toggle-shuffle(); } }
                                    Action { comfortable: true; label: I18n.tr("Попередня композиція"); icon: @image-url("../assets/icons/SkipBack.svg"); clicked => { root.previous-track(); } }
                                    Transport { playing: root.player-state == "playing"; brand: true; clicked => { root.play-toggle(); } }
                                    Action { comfortable: true; label: I18n.tr("Наступна композиція"); icon: @image-url("../assets/icons/SkipForward.svg"); clicked => { root.next-track(); } }
                                    Action { comfortable: true; label: I18n.tr("Повтор"); icon: @image-url("../assets/icons/Repeat.svg"); selected: root.repeat-mode != "off"; clicked => { root.toggle-repeat(); } }
                                }
                            }
                        }
                    }

                    // Keep errors visible; show the manual time offset only with lyric tools open.
                    HorizontalLayout {
                        height: root.lyrics-renderer-error != "" || (root.player-tools && root.lyrics-offset != 0) ? 28px : 0px;
                        spacing: 10px;
                        Rectangle {
                            height: 26px;
                            border-radius: 13px;
                            background: transparent;
                            border-width: 0px;
                            border-color: #ffffff14;
                            HorizontalLayout {
                                padding-left: 12px; padding-right: 12px; spacing: 8px;
                                Text {
                                    text: I18n.tr(root.lyrics-renderer-error);
                                    color: Tokens.ink-200;
                                    font-size: 11px;
                                    font-weight: 600;
                                    vertical-alignment: center;
                                    overflow: elide;
                                }
                            }
                        }
                        Rectangle { horizontal-stretch: 1; }
                        if root.player-tools && root.lyrics-offset != 0: Rectangle {
                            height: 26px;
                            border-radius: 13px;
                            background: #ffffff10;
                            HorizontalLayout {
                                padding-left: 10px; padding-right: 10px;
                                Text {
                                    text: (root.lyrics-offset > 0 ? "+" : "") + root.lyrics-offset + I18n.tr(" мс");
                                    color: Tokens.brand-300;
                                    font-size: 11px;
                                    font-weight: 700;
                                    vertical-alignment: center;
                                }
                            }
                        }
                    }
                    }
                }
            }

        }
        if !root.mobile && (root.immersive || root.expanded-active): HorizontalLayout {
            x: parent.width - self.width - 16px; y: 12px; width: 116px; height: 40px; spacing: 4px;
            Action { icon: @image-url("../assets/icons/Settings.svg"); label: I18n.tr("Інструменти слів пісні"); selected: root.player-tools; clicked => { root.player-tools = !root.player-tools; } }
            Action { icon: @image-url("../assets/icons/MonitorPlay.svg"); label: root.immersive ? I18n.tr("Звичайний вигляд") : I18n.tr("Режим фокусування"); selected: root.immersive; clicked => { if root.immersive { root.focus-player = false; root.expanded-player = false; } else { root.player-tab = "lyrics"; root.focus-player = true; } } }
            Action { icon: @image-url("../assets/icons/ChevronDown.svg"); label: I18n.tr("Згорнути програвач"); clicked => { root.close-player(); } }
        }
        }

        // Only the page textures fade through blur. The ambient canvas stays fixed.
        if root.navigation-blend > 0.001: Rectangle {
            width: 100%; height: 100%; opacity: root.navigation-blend;
            Image {
                source: root.navigation-from-image; image-fit: fill;
                width: 100%; height: 100%;
                x: (root.camera-start-x - root.camera-x) * content.width;
                y: (root.camera-start-y - root.camera-y) * content.height;
            }
            Image {
                source: root.navigation-to-image; image-fit: fill;
                width: 100%; height: 100%;
                x: (root.camera-end-x - root.camera-x) * content.width;
                y: (root.camera-end-y - root.camera-y) * content.height;
            }
        }
        if root.navigation-pulse > 0.001: NavigationStreaks {
            width: 100%; height: 100%;
            direction-x: root.camera-end-x - root.camera-start-x;
            direction-y: root.camera-end-y - root.camera-start-y;
            progress: root.navigation-progress; strength: root.navigation-pulse;
        }

        // Independent overlay: opening tools never changes player geometry.
        tools-panel := Rectangle {
            visible: (root.player-tools || root.tools-progress > 0.001) && root.displayed-view == "lyrics" && root.dialog == "";
            opacity: root.tools-progress;
            x: parent.width - self.width - 16px;
            y: parent.height - self.height - 16px + (1 - root.tools-progress) * 12px;
            width: min(380px, parent.width - 32px);
            height: min(480px, parent.height - 32px);
            background: Tokens.neutral-100;
            border-radius: 22px;
            border-width: 0px;
            border-color: Tokens.neutral-300;
            clip: true;
            TouchArea {} // Consume clicks on panel gaps.
            ScrollView { VerticalLayout {
                padding: 16px; spacing: 12px;
                HorizontalLayout {
                    height: 32px;
                    Text { text: I18n.tr("Інструменти треку"); font-weight: 700; color: Tokens.ink-100; vertical-alignment: center; horizontal-stretch: 1; }
                    Action { text: "×"; label: I18n.tr("Закрити"); clicked => {root.player-tools=false;} }
                }
                HorizontalLayout {
                    spacing: 8px;
                    ComboBox { horizontal-stretch: 1; model: root.providers; current-index <=> root.provider-index; selected(value) => {root.choose-provider(root.provider-index);} }
                    Action { icon: @image-url("../assets/icons/RefreshCw.svg"); label: I18n.tr("Оновити слова"); outlined: true; clicked => {root.refresh-lyrics();} }
                }
                HorizontalLayout {
                    spacing: 8px;
                    Action {text: I18n.tr("Вставити"); outlined: true; clicked => {root.player-tools=false;root.dialog="paste";} }
                    Action {text: I18n.tr("Копіювати"); outlined: true; clicked => {root.copy-lyrics();} }
                    Rectangle {horizontal-stretch:1;}
                }
                LyricsSettings {
                    embedded: true;
                    appearance => {root.player-tools=false;root.dialog="lyric-style";}
                    provider <=> root.lyrics-provider;
                    romanization <=> root.lyrics-romanization;
                    translation <=> root.lyrics-translation;
                    secondary-gap <=> root.lyrics-secondary-gap;
                    language <=> root.lyrics-translation-language;
                    status: root.lyrics-enrichment-status;
                    reduced-motion <=> root.lyrics-reduced-motion;
                    stage <=> root.lyrics-stage;
                    passive <=> root.lyrics-passive-scroll;
                    provider-changed(value) => { root.provider-changed(value); }
                    display-changed => { root.preferences-changed(); }
                    mode-changed => { root.lyric-mode-changed(root.lyrics-stage,root.lyrics-reduced-motion,root.lyrics-passive-scroll); }
                }
                HorizontalLayout {
                    spacing: 8px;
                    Text {text:I18n.tr("Зсув");color:Tokens.ink-300;vertical-alignment:center;horizontal-stretch:1;}
                    Action {text:"−";min-width:56px;max-width:56px;outlined:true;clicked=>{root.adjust-offset(-100);} }
                    Text {text:root.lyrics-offset+I18n.tr(" мс");width:root.mobile ? 48px : 72px;color:Tokens.ink-100;horizontal-alignment:center;vertical-alignment:center;}
                    Action {text:"+";min-width:56px;max-width:56px;outlined:true;clicked=>{root.adjust-offset(100);} }
                }
                HorizontalLayout {
                    spacing: 8px;
                    Action {text:I18n.tr("Радіо");outlined:true;clicked=>{root.radio();} }
                    Action {text:I18n.tr("До списку");outlined:true;clicked=>{root.player-tools=false;root.dialog="add";} }
                    Action {text:I18n.tr("YT теги");outlined:true;clicked=>{root.sync-tags();} }
                    Rectangle {horizontal-stretch:1;}
                }
                if root.current-video-id != "": HorizontalLayout {
                    spacing: 8px;
                    Action { text: root.current-downloaded ? I18n.tr("Завантажено") : root.current-downloading ? I18n.tr("Завантаження файлу…") : I18n.tr("Завантажити"); outlined: true; clicked => { root.download(-1); } }
                    Rectangle { horizontal-stretch: 1; }
                }
                if root.native-file-tools && root.current-track-key != "": HorizontalLayout {
                    spacing: 8px;
                    if root.current-local: Action { text: I18n.tr("Обкладинка"); label: I18n.tr("Вибрати обкладинку для файлу"); outlined: true; clicked => { root.choose-cover(); } }
                    Action { text: I18n.tr("Зберегти"); label: I18n.tr("Зберегти обкладинку"); outlined: true; clicked => { root.save-cover(); } }
                    Rectangle { horizontal-stretch: 1; }
                }
            } }
        }
    }

    // Mobile playback and page selection share one safe-area-aware dock.
    Rectangle {
        x: (!root.mobile && root.displayed-view == "lyrics" ? 0px : 8px) + root.safe-left * 1px;
        y: root.height - (!root.mobile && root.displayed-view == "lyrics" ? root.bottom-dock-height : root.bottom-reserve) - root.safe-bottom * 1px;
        width: root.width - (!root.mobile && root.displayed-view == "lyrics" ? 0px : 16px) - (root.safe-left + root.safe-right) * 1px;
        height: root.bottom-dock-height;
        visible: !root.immersive;
        background: !root.mobile && root.displayed-view == "lyrics" ? Tokens.neutral-0 : Tokens.neutral-100;
        border-radius: !root.mobile && root.displayed-view == "lyrics" ? 0px : PlayerTheme.enabled ? PlayerTheme.corner * 1px : 24px;
        clip: true;
        if root.mobile: TouchArea {
            x: 0px; y: 3px; width: 100%; height: 53px;
            mouse-cursor: pointer;
            clicked => { root.player-tab = "lyrics"; root.navigate("lyrics"); root.request-lyrics(); }
        }
        // Interactive Top Progress Track
        Rectangle {
            x: !root.mobile && root.displayed-view == "lyrics" ? 0px : 24px; y: 0px;
            height: prog-touch.has-hover ? 5px : 3px;
            width: parent.width - self.x * 2;
            border-radius: 3px;
            background: #ffffff22;
            animate height { duration: Motion.feedback; }
            Rectangle {
                x: 0px; y: 0px;
                height: 100%;
                width: root.duration > 0 ? parent.width * clamp(root.position / root.duration, 0, 1) : 0px;
                background: Tokens.brand-500;
                border-radius: 3px;
            }
            prog-touch := TouchArea {
                mouse-cursor: pointer;
                moved => {
                    if self.pressed && root.duration > 0 {
                        root.seek-to(round(clamp(self.mouse-x / self.width, 0, 1) * root.duration * 1000));
                    }
                }
                clicked => {
                    if root.duration > 0 {
                        root.seek-to(round(clamp(self.mouse-x / self.width, 0, 1) * root.duration * 1000));
                    }
                }
            }
        }
        HorizontalLayout {
            x: 0px; y: 3px; width: 100%; height: root.mobile ? 53px : 69px;
            padding-left: root.mobile ? 10px : 20px;
            padding-right: root.mobile ? 10px : 20px;
            spacing: root.mobile ? 8px : 14px;
            padding-top: root.mobile ? 4px : 12px; padding-bottom: root.mobile ? 4px : 12px;

            if !root.mobile: Action { icon: @image-url("../assets/icons/SkipBack.svg"); label: I18n.tr("Попередня композиція"); clicked => { root.previous-track(); } }
            Transport { playing: root.player-state == "playing"; brand: true; clicked => { root.play-toggle(); } }
            Action { icon: @image-url("../assets/icons/SkipForward.svg"); label: I18n.tr("Наступна композиція"); clicked => { root.next-track(); } }
            if !root.mobile: Text { text: root.time-label; color: Tokens.ink-200; font-size: 12px; font-weight: 500; width: 108px; vertical-alignment: center; }

            if !root.mobile: Artwork { art: root.current-art; width: 44px; height: 44px; tone: 3; border-radius: 8px; }
            Rectangle {
                horizontal-stretch: 1;
                VerticalLayout {
                    alignment: center; spacing: 3px;
                    Text { text: root.current-title; color: Tokens.ink-100; font-size: 14px; font-weight: 700; overflow: elide; }
                    Text { text: root.current-artist; color: Tokens.ink-300; font-size: 12px; overflow: elide; }
                }
                TouchArea { mouse-cursor: pointer; clicked => { root.player-tab = "lyrics"; root.navigate("lyrics"); root.request-lyrics(); } }
            }

            if !root.mobile: Action { icon: @image-url("../assets/icons/Heart.svg"); label: I18n.tr("Подобається"); selected: root.current-liked; clicked => { root.toggle-like(-1); } }
            if !root.mobile: Action { icon: @image-url("../assets/icons/Captions.svg"); label: I18n.tr("Слова пісні"); selected: root.displayed-view == "lyrics"; clicked => { root.player-tab = "lyrics"; root.navigate("lyrics"); root.request-lyrics(); } }
            if !root.mobile && root.width >= 1040px: Action { icon: @image-url("../assets/icons/ListMusic.svg"); label: I18n.tr("Черга відтворення"); selected: root.displayed-view == "queue"; clicked => { root.navigate("queue"); } }
            if !root.mobile && root.width >= 1040px: Action { icon: @image-url("../assets/icons/Plus.svg"); label: I18n.tr("Додати до списку"); clicked => { root.dialog = "add"; } }
            if !root.mobile: Action { icon: @image-url("../assets/icons/Volume2.svg"); label: I18n.tr("Гучність"); clicked => { root.volume = root.volume > 0 ? 0 : 1; root.volume-changed(root.volume); } }
            if !root.mobile: TonalSlider { label: I18n.tr("Гучність"); width: root.width < 1040px ? 64px : 84px; minimum: 0; maximum: 1; value <=> root.volume; changed(value) => { root.volume-changed(value); } }
            if !root.mobile && root.width >= 960px: Action { icon: @image-url("../assets/icons/Repeat.svg"); label: I18n.tr("Повтор"); selected: root.repeat-mode != "off"; clicked => { root.toggle-repeat(); } }
            if !root.mobile && root.width >= 960px: Action { icon: @image-url("../assets/icons/Shuffle.svg"); label: I18n.tr("Перемішати"); selected: root.shuffle; clicked => { root.toggle-shuffle(); } }
            if !root.mobile: Action {
                icon: root.displayed-view == "lyrics" ? @image-url("../assets/icons/ChevronDown.svg") : @image-url("../assets/icons/ChevronUp.svg");
                label: I18n.tr("Розгорнути програвач");
                clicked => {
                    if root.displayed-view == "lyrics" { root.close-player(); } else { root.player-tab = "lyrics"; root.navigate("lyrics"); root.request-lyrics(); }
                }
            }
        }
        if root.mobile: Rectangle {
            x: 12px; y: 55px; width: parent.width - 24px; height: 1px;
            background: Tokens.neutral-300.with-alpha(0.5);
        }
        if root.mobile: Rectangle {
            x: 0px; y: 56px;
            width: 100%; height: root.compact-height ? 48px : 56px;
            background: transparent;
            HorizontalLayout { padding-left: 4px; padding-right: 4px; spacing: 0px;
                MobileNavItem { height: root.compact-height ? 48px : 56px; text: I18n.tr("Головна"); icon: @image-url("../assets/icons/House.svg"); selected: root.active-view == "home"; clicked => { root.navigate("home"); } }
                MobileNavItem { height: root.compact-height ? 48px : 56px; text: I18n.tr("Огляд"); icon: @image-url("../assets/icons/Compass.svg"); selected: root.active-view == "explore"; clicked => { root.navigate("explore"); } }
                MobileNavItem { height: root.compact-height ? 48px : 56px; text: I18n.tr("Бібліотека"); icon: @image-url("../assets/icons/Library.svg"); selected: root.active-view == "library"; clicked => { root.navigate("library"); } }
                MobileNavItem { height: root.compact-height ? 48px : 56px; text: I18n.tr("Улюблене"); icon: @image-url("../assets/icons/Heart.svg"); selected: root.active-view == "liked"; clicked => { root.navigate("liked"); } }
                MobileNavItem { height: root.compact-height ? 48px : 56px; text: I18n.tr("Параметри"); icon: @image-url("../assets/icons/Settings.svg"); selected: root.active-view == "settings"; clicked => { root.navigate-settings(); } }
            }
        }
    }

    private property <float> tools-progress: root.player-tools ? 1 : 0;
    animate tools-progress { duration: Motion.panel; easing: cubic-bezier(0.2, 0, 0, 1); }

    // Modal Dialogs
    private property <length> dialog-bottom: min(root.height - root.safe-bottom * 1px, root.virtual-keyboard-size.height > 0px ? root.virtual-keyboard-position.y : root.height);
    function cancel-lyric-appearance() {
        root.lyric-theme-source = root.lyric-theme-applied;
        root.lyric-font-family = root.lyric-font-applied;
        root.theme-entire-player-draft = root.theme-entire-player;
        root.dialog = "";
    }
    if root.dialog != "": Rectangle {
        width: 100%; height: 100%;
        background: #06060ae6;
        TouchArea { clicked => { if root.dialog == "lyric-style" { root.cancel-lyric-appearance(); } else { root.dialog = ""; } } }
        if root.dialog == "lyric-style": LyricAppearance {
            width: min(root.width - (root.safe-left + root.safe-right) * 1px - 32px, 640px);
            height: min(root.dialog-bottom - root.safe-top * 1px - 32px, 840px);
            x: root.safe-left * 1px + (root.width - (root.safe-left + root.safe-right) * 1px - self.width) / 2;
            y: root.safe-top * 1px + (root.dialog-bottom - root.safe-top * 1px - self.height) / 2;
            compact: root.mobile; presets: root.lyric-theme-presets; names: root.lyric-theme-names;
            source <=> root.lyric-theme-source; font-family <=> root.lyric-font-family;
            preset-index: root.lyric-preset-index; style: root.lyric-draft-style;
            size: root.lyric-draft-size; weight: root.lyric-draft-weight;
            active: root.lyric-draft-active; inactive: root.lyric-draft-inactive;
            entire-player <=> root.theme-entire-player-draft;
            player-style: root.player-theme-draft;
            cover: root.current-art;
            rows: root.lyric-preview-rows; reduced: root.lyrics-reduced-motion;
            native-text-gradients: root.native-text-gradients;
            status: root.lyric-style-status; valid: root.lyric-draft-valid;
            import-supported: root.lyric-font-import-supported;
            picked(index) => { root.select-lyric-preset(index); }
            adjusted(key, value) => { root.adjust-lyric-style(key, value); }
            adjusted-color(key,value) => { root.adjust-player-color(key,value); }
            paint => { root.lyric-preview-paint(); }
            import-font => { root.import-lyric-font(); }
            apply => { root.apply-lyric-style(); }
            cancel => { root.cancel-lyric-appearance(); }
        }
        if root.dialog != "lyric-style": Rectangle {
            width: min(root.width - (root.safe-left + root.safe-right) * 1px - 32px, 520px);
            height: min(root.dialog-bottom - root.safe-top * 1px - 32px, root.dialog == "connections" ? 720px : root.dialog == "music-import" ? 430px : root.dialog == "home-layout" ? 600px : root.dialog == "lyric-style" ? 720px : root.dialog == "paste" || root.dialog == "add" ? 440px : root.dialog == "match" ? 360px : 210px);
            x: root.safe-left * 1px + (root.width - (root.safe-left + root.safe-right) * 1px - self.width) / 2;
            y: root.safe-top * 1px + (root.dialog-bottom - root.safe-top * 1px - self.height) / 2;
            background: Tokens.neutral-100;
            border-radius: 20px;
            border-width: 0px;
            border-color: #ffffff24;
            TouchArea { }
            ScrollView {
            width: 100%; height: 100%;
            content-width: self.width;
            content-height: max(self.height, dialog-layout.min-height);
            dialog-layout := VerticalLayout {
                alignment: root.dialog == "home-layout" || root.dialog == "music-import" || root.dialog == "connections" ? start : stretch;
                padding: root.mobile ? 16px : 24px; spacing: root.mobile ? 12px : 16px;
                Text {
                    text: root.dialog == "connections" ? I18n.tr("Підключені акаунти") : root.dialog == "home-layout" ? I18n.tr("Макет головної") : root.dialog == "music-import" ? I18n.tr("Імпорт плейліста") : root.dialog == "lyric-style" ? I18n.tr("Вигляд слів") : root.dialog == "auth" ? I18n.tr("Доступ до слів пісень") : root.dialog == "paste" ? I18n.tr("Вставити слова пісні") :
                          root.dialog == "add" ? I18n.tr("Додати до списку") :
                          root.dialog == "source" ? I18n.tr("Шлях до папки або файлу") :
                          root.dialog == "match" ? I18n.tr("Перевірте збіг YouTube Music") : I18n.tr("Новий список відтворення");
                    color: Tokens.ink-100;
                    font-size: root.mobile ? 18px : 20px;
                    wrap: word-wrap;
                    font-weight: 700;
                }
                if root.dialog == "home-layout": VerticalLayout {
                    spacing: 10px;
                    for row in [0,1,2]: HorizontalLayout {
                        spacing: 10px;
                        HomePreview { variant: row * 2; selected: root.home-layout == self.variant; clicked => {root.home-choose(self.variant);} }
                        HomePreview { variant: row * 2 + 1; selected: root.home-layout == self.variant; clicked => {root.home-choose(self.variant);} }
                    }
                    SwitchRow {text: I18n.tr("Новий макет при відкритті головної"); checked: root.home-rotate; toggled => {root.home-choose(-2);} }
                    Action {text: I18n.tr("Випадковий макет"); comfortable: true; clicked => {root.home-choose(-1);} }
                }
                if root.dialog == "music-import": VerticalLayout {
                    alignment: start;
                    spacing: 14px;
                    Text {text: I18n.tr("Вставте посилання на публічний плейліст YouTube Music. Вхід не потрібен."); color: Tokens.ink-200; wrap: word-wrap;}
                    LineEdit {text <=> root.music-link; placeholder-text: I18n.tr("Посилання YouTube Music або Spotify"); enabled: !root.music-busy; accepted => {root.music-command("import");}}
                    Text {text: I18n.tr("Для приватних плейлістів і Spotify спочатку підключіть відповідний акаунт."); color: Tokens.ink-300; wrap: word-wrap; font-size: 12px;}
                    Action {text: I18n.tr("Імпортувати"); primary: true; comfortable: true; enabled: !root.music-busy && root.music-link != ""; clicked => {root.music-command("import");}}
                    if root.music-busy: Action {text: I18n.tr("Скасувати імпорт"); comfortable: true; clicked => {root.music-command("cancel");}}
                    if root.music-status != "": Text {text: I18n.tr(root.music-status); color: Tokens.ink-200; wrap: word-wrap; font-size: 13px;}
                    Action {text: I18n.tr("Підключені акаунти"); comfortable: true; clicked => {root.dialog = "connections";}}
                }
                if root.dialog == "connections": VerticalLayout {
                    alignment: start;
                    spacing: 12px;
                    Text {text: I18n.tr("Виберіть, який акаунт підключити. YouTube Music та Vey працюють незалежно; можна підключити обидва."); color: Tokens.ink-200; wrap: word-wrap;}
                    ComboBox {model: ["Vey", "YouTube Music", "Spotify"]; current-index <=> root.connection-provider; enabled: !root.music-busy; selected(value) => {root.music-provider = max(0, root.connection-provider - 1); root.music-client-id = ""; root.music-client-secret = ""; root.music-command("select");}}
                    Text {text: "Vey · " + (root.account-signed-in ? root.account-email : I18n.tr("Не підключено")) + "\nYouTube Music · " + (root.youtube-account == "" ? I18n.tr("Не підключено") : root.youtube-account) + "\nSpotify · " + (root.spotify-account == "" ? I18n.tr("Не підключено") : root.spotify-account); color: Tokens.ink-100; wrap: word-wrap;}
                    if root.connection-provider == 0: VerticalLayout {
                        alignment: start;
                        spacing: 12px;
                        Text {text: I18n.tr("Vey зберігає вашу бібліотеку, улюблене та плейлісти між пристроями."); color: Tokens.ink-200; wrap: word-wrap;}
                        Action {text: root.account-signed-in ? I18n.tr("Керувати акаунтом Vey") : I18n.tr("Підключити Vey"); primary: true; comfortable: true; clicked => {root.dialog = ""; root.navigate-settings(); root.settings-section = "account";}}
                        if root.account-signed-in: SwitchRow {text: I18n.tr("Автоматична синхронізація"); checked: root.account-auto-sync; toggled => {root.account-auto-sync = !root.account-auto-sync;}}
                    }
                    if root.connection-provider != 0: VerticalLayout {
                        alignment: start;
                        spacing: 12px;
                        if !root.music-supported: Text {text: I18n.tr("Підключіть сервіси у настільній Vey. На цьому пристрої плейлісти доступні через акаунт Vey."); color: Tokens.ink-200; wrap: word-wrap;}
                        if root.music-supported: VerticalLayout {
                            spacing: 12px;
                            if root.connection-provider == 2: LineEdit {text <=> root.music-client-id; placeholder-text: "Spotify OAuth Client ID"; enabled: !root.music-busy;}
                            Text {text: root.connection-provider == 1 ? I18n.tr("Підключення приватних плейлістів використовує окремий профіль Vey.") : I18n.tr("Вкажіть Client ID власного зареєстрованого застосунку та підтвердьте доступ у браузері."); color: Tokens.ink-300; font-size: 12px; wrap: word-wrap;}
                            if root.connection-provider == 1: Text {text: I18n.tr("Типовий браузер відкриває його поточний профіль, але не підключає Vey до приватних списків."); color: Tokens.ink-300; font-size: 12px; wrap: word-wrap;}
                            if root.connection-provider == 1: Action {text: I18n.tr("Відкрити в типовому браузері"); comfortable: true; clicked => {root.music-command("youtube-browser-login");}}
                            HorizontalLayout {
                                Action {text: I18n.tr("Підключити"); primary: true; comfortable: true; enabled: !root.music-busy; clicked => {root.music-command("connect");}}
                                Action {text: I18n.tr("Відключити"); comfortable: true; enabled: !root.music-busy; clicked => {root.music-command("disconnect");}}
                            }
                            Action {text: I18n.tr("Синхронізувати"); comfortable: true; enabled: !root.music-busy; clicked => {root.music-command("sync");}}
                            SwitchRow {text: I18n.tr("Оновлювати кожні 15 хвилин"); checked: root.music-auto-sync; toggled => {root.music-auto-sync = !root.music-auto-sync; root.music-command("auto");}}
                            if root.music-busy: Action {text: I18n.tr("Скасувати"); comfortable: true; clicked => {root.music-command("cancel");}}
                        }
                    }
                    if root.music-status != "" && root.connection-provider != 0: Text {text: I18n.tr(root.music-status); color: Tokens.ink-200; wrap: word-wrap; font-size: 13px;}
                    Action {text: I18n.tr("Імпорт плейліста"); comfortable: true; clicked => {root.dialog = "music-import";}}
                }
                if root.dialog == "create" || root.dialog == "source": LineEdit {
                    text <=> root.new-name;
                    placeholder-text: root.dialog == "source" ? I18n.tr("Вкажіть повний шлях") : I18n.tr("Назва списку відтворення");
                    accepted => {
                        if root.dialog == "source" { root.add-path(root.source-kind, root.new-name); } else { root.create-playlist(root.new-name); }
                        root.new-name = "";
                        root.dialog = "";
                    }
                }
                if root.dialog == "auth": LineEdit {
                    text <=> root.auth-token;
                    input-type: password;
                    placeholder-text: I18n.tr("JWT або Turnstile token");
                }
                if root.dialog == "paste": lyrics-edit-viewport := Rectangle {
                    vertical-stretch: 1;
                    min-height: root.mobile ? 80px : 200px;
                    out property <float> widget-x: self.absolute-position.x / 1px;
                    out property <float> widget-y: self.absolute-position.y / 1px;
                    changed widget-x => {root.lyrics-editor-x=self.widget-x;}
                    changed widget-y => {root.lyrics-editor-y=self.widget-y;}
                    changed width => {root.lyrics-editor-width=self.width / 1px;}
                    changed height => {root.lyrics-editor-height=self.height / 1px;}
                    Timer {
                        interval: 50ms; running: true;
                        triggered => {
                            root.lyrics-editor-x=lyrics-edit-viewport.widget-x;
                            root.lyrics-editor-y=lyrics-edit-viewport.widget-y;
                            root.lyrics-editor-width=lyrics-edit-viewport.width / 1px;
                            root.lyrics-editor-height=lyrics-edit-viewport.height / 1px;
                        }
                    }
                    TextEdit { width:100%;height:100%;text <=> root.lyrics-paste;visible:root.dialog != "paste" || !root.lyrics-web-ready; }
                }
                if root.dialog == "match": VerticalLayout {
                    spacing: 12px;
                    LineEdit { text <=> root.match-title; }
                    LineEdit { text <=> root.match-artist; }
                    LineEdit { text <=> root.match-album; }
                    Text { text: I18n.tr("Перед зміною буде створено резервну копію тегів"); color: Tokens.ink-300; wrap: word-wrap; }
                }
                if root.dialog == "add": Text { text: root.current-title; color: Tokens.ink-300; font-size: 13px; overflow: elide; }
                if root.dialog == "add" && root.playlist-destinations.length == 0: Text {
                    text: I18n.tr("У вас ще немає списків відтворення"); color: Tokens.ink-200; wrap: word-wrap; vertical-stretch: 1;
                }
                if root.dialog == "add" && root.playlist-destinations.length > 0: ListView {
                    min-height: 72px; vertical-stretch: 1;
                    for p in root.playlist-destinations: Rectangle {
                        height: 72px;
                        PlaylistChoice {
                            width: 100%; height: 64px;
                            name: p.name; detail: p.detail;
                            clicked => { root.add-to-playlist(p.id); root.dialog = ""; }
                        }
                    }
                }
                if root.dialog == "add": Action {
                    text: I18n.tr("Створити список"); icon: @image-url("../assets/icons/Plus.svg"); comfortable: true; wide: true; outlined: true;
                    clicked => { root.adding-to-new-playlist = true; root.new-name = ""; root.dialog = "create"; }
                }
                HorizontalLayout {
                    spacing: 10px;
                    Rectangle { horizontal-stretch: 1; }
                    Action { comfortable: root.mobile; text: root.dialog == "home-layout" || root.dialog == "music-import" || root.dialog == "connections" ? I18n.tr("Закрити") : I18n.tr("Скасувати"); outlined: true; clicked => { root.dialog = ""; } }
                    if root.dialog != "add" && root.dialog != "lyric-style" && root.dialog != "home-layout" && root.dialog != "music-import" && root.dialog != "connections": Action {
                        text: I18n.tr("Зберегти");
                        comfortable: root.mobile;
                        primary: true;
                        clicked => {
                            if root.dialog == "auth" { root.submit-auth(root.auth-token); root.auth-token = ""; }
                            else if root.dialog == "match" { root.apply-tags(root.match-title, root.match-artist, root.match-album); }
                            else if root.dialog == "source" { root.add-path(root.source-kind, root.new-name); root.new-name = ""; }
                            else if root.dialog == "paste" { root.import-lyrics(root.lyrics-paste); }
                            else { root.create-playlist(root.new-name); root.new-name = ""; }
                            root.dialog = "";
                        }
                    }
                }
            }
            }
        }
    }
}
