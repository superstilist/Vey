// Gestures are confined to this pad, preserving list scrolling and lyric input.
export component StageNavigator inherits Rectangle {
    in property <int> stage-column;
    in property <int> stage-row;
    in property <bool> reduced;
    callback navigate(int, int);
    private property <length> press-x;
    private property <length> press-y;
    private property <int> press-column;
    private property <int> press-row;
    private property <bool> pointer-active: false;
    private property <length> swipe-threshold: max(16px, min(root.width, root.height) * 0.34);
    horizontal-stretch: 0;
    border-radius: 12px;
    background: #ffffff08;
    for name[index] in ["Пошук", "Налаштування", "Програвач", "Черга", "Головна", "Огляд", "Список відтворення", "Сподобалось", "Бібліотека"]: Rectangle {
        property <int> stage-column: mod(index, 3) - 1;
        property <int> stage-row: floor(index / 3) - 1;
        property <bool> selected: self.stage-column == root.stage-column && self.stage-row == root.stage-row;
        x: (self.stage-column + 1) * root.width / 3;
        y: (self.stage-row + 1) * root.height / 3;
        width: root.width / 3; height: root.height / 3;
        accessible-role: button;
        accessible-label: "Перейти: " + name;
        accessible-action-default => { root.navigate(self.stage-column, self.stage-row); }
        Rectangle {
            width: parent.selected ? 9px : 5px; height: self.width;
            x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2;
            border-radius: self.width / 2;
            background: parent.selected ? #ffffff : #ffffff60;
            animate background { duration: root.reduced ? 0ms : 100ms; }
        }
    }
    TouchArea {
        mouse-cursor: pointer;
        pointer-event(event) => {
            if event.kind == PointerEventKind.cancel {
                root.pointer-active = false;
                return;
            }
            if event.button == PointerEventButton.left && event.kind == PointerEventKind.down {
                root.press-x = self.mouse-x; root.press-y = self.mouse-y;
                root.press-column = root.stage-column; root.press-row = root.stage-row;
                root.pointer-active = true;
            }
            if event.button == PointerEventButton.left && event.kind == PointerEventKind.up {
                if !root.pointer-active { return; }
                root.pointer-active = false;
                let dx = self.mouse-x - root.press-x;
                let dy = self.mouse-y - root.press-y;
                let column-step = dx < -root.swipe-threshold ? 1 : dx > root.swipe-threshold ? -1 : 0;
                let row-step = dy < -root.swipe-threshold ? 1 : dy > root.swipe-threshold ? -1 : 0;
                if column-step != 0 || row-step != 0 {
                    root.navigate(clamp(root.press-column + column-step, -1, 1), clamp(root.press-row + row-step, -1, 1));
                } else {
                    root.navigate(clamp(floor(root.press-x * 3 / self.width) - 1, -1, 1), clamp(floor(root.press-y * 3 / self.height) - 1, -1, 1));
                }
            }
        }
    }
}
