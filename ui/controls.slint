import { Slider } from "std-widgets.slint";
import { Tokens } from "tokens.slint";

export component Action inherits Rectangle {
    in property <string> text;
    in property <string> label;
    in property <image> icon;
    in property <bool> chip;
    in property <bool> primary;
    in property <bool> selected;
    in property <bool> outlined;
    in property <bool> comfortable;
    in property <bool> wide;
    callback clicked();
    horizontal-stretch: wide ? 1 : 0;
    min-width: text == "" ? (comfortable ? 44px : 36px) : max(chip ? 64px : 84px, (icon.width > 0 ? 54px : 32px) + label-text.preferred-width);
    preferred-width: self.min-width;
    max-width: wide ? 100000px : text == "" ? (comfortable ? 44px : 36px) : 280px;
    height: comfortable ? 44px : chip ? 32px : 36px;
    border-width: 0px;
    border-color: Tokens.neutral-300;
    background: primary ? (touch.has-hover ? Tokens.brand-300 : Tokens.brand-500) : selected ? Tokens.primary-container : touch.has-hover ? Tokens.neutral-200 : chip || outlined ? Tokens.neutral-150 : transparent;
    border-radius: Tokens.radius-pill;
    animate background { duration: 110ms; }
    animate border-color { duration: 110ms; }
    HorizontalLayout {
        x: 0px; y: 0px; width: 100%; height: 100%;
        alignment: center;
        spacing: text == "" ? 0px : 8px;
        padding-left: text == "" ? 0px : 14px;
        padding-right: text == "" ? 0px : 14px;
        if root.icon.width > 0: VerticalLayout {
            width: 18px;
            alignment: center;
            Image {
                source: root.icon;
                width: 18px;
                height: 18px;
                colorize: root.primary ? Tokens.brand-ink : root.selected ? Tokens.brand-300 : touch.has-hover ? Tokens.ink-100 : Tokens.ink-200;
            }
        }
        if root.text != "": Text {
            text: root.text;
            color: root.primary ? Tokens.brand-ink : root.selected ? Tokens.brand-300 : Tokens.ink-100;
            font-size: Tokens.font-sm;
            font-weight: root.primary || root.selected ? 700 : 600;
            vertical-alignment: center;
            overflow: elide;
        }
    }
    label-text := Text {
        visible: false;
        text: root.text;
        font-size: Tokens.font-sm;
        font-weight: root.primary || root.selected ? 700 : 600;
    }
    touch := TouchArea { mouse-cursor: pointer; clicked => { root.clicked(); } }
    accessible-role: button;
    accessible-label: label == "" ? text : label;
    accessible-action-default => { root.clicked(); }
}

export component NavItem inherits Rectangle {
    in property <string> text;
    in property <image> icon;
    in property <bool> selected;
    in property <bool> collapsed;
    callback clicked();
    height: 44px;
    border-radius: 24px;
    background: selected ? Tokens.primary-container : touch.has-hover ? Tokens.neutral-150 : transparent;
    border-width: 0px;
    border-color: #ffffff14;
    animate background { duration: 110ms; }
    Image {
        source: root.icon;
        x: root.collapsed ? (root.width - 20px) / 2 : 16px;
        y: 12px;
        width: 20px;
        height: 20px;
        colorize: root.selected ? Tokens.brand-300 : touch.has-hover ? Tokens.ink-100 : Tokens.ink-200;
    }
    if !root.collapsed: Text {
        x: 52px;
        y: 0px;
        width: max(0px, root.width - 60px);
        height: 44px;
        text: root.text;
        color: root.selected ? Tokens.brand-300 : touch.has-hover ? Tokens.ink-100 : Tokens.ink-150;
        font-size: 14px;
        font-weight: root.selected ? 700 : 500;
        vertical-alignment: center;
        overflow: elide;
    }
    touch := TouchArea { mouse-cursor: pointer; clicked => { root.clicked(); } }
    accessible-role: button;
    accessible-label: text;
    accessible-action-default => { root.clicked(); }
}

export component Artwork inherits Rectangle {
    in property <image> art;
    in property <int> tone;
    border-radius: 24px;
    clip: true;
    border-width: 0px;
    border-color: #ffffff14;
    background: Math.mod(tone, 3) == 0 ? Tokens.primary-container : Math.mod(tone, 3) == 1 ? Tokens.secondary-container : Tokens.tertiary-container;
    Image {
        source: @image-url("../assets/icons/Music2.svg");
        width: root.width * 0.32;
        height: root.height * 0.32;
        x: (root.width - self.width) / 2;
        y: (root.height - self.height) / 2;
        colorize: #ffffff38;
    }
    Image {
        source: root.art;
        x: 0px;
        y: 0px;
        width: 100%;
        height: 100%;
        image-fit: cover;
    }
}

export component Transport inherits Rectangle {
    in property <bool> playing;
    in property <bool> brand;
    callback clicked();
    width: brand ? 42px : 58px;
    height: brand ? 42px : 58px;
    border-radius: root.playing ? (root.brand ? 15px : 20px) : self.width / 2;
    background: touch.has-hover ? Tokens.brand-300 : Tokens.brand-500;
    animate background { duration: 110ms; }
    Image {
        source: root.playing ? @image-url("../assets/icons/Pause.svg") : @image-url("../assets/icons/Play.svg");
        width: root.brand ? 20px : 26px;
        height: root.brand ? 20px : 26px;
        x: (root.width - self.width) / 2 + (root.playing ? 0px : 1px);
        y: (root.height - self.height) / 2;
        colorize: Tokens.brand-ink;
    }
    touch := TouchArea { mouse-cursor: pointer; clicked => { root.clicked(); } }
    accessible-role: button;
    accessible-label: playing ? "Пауза" : "Відтворити";
    accessible-action-default => { root.clicked(); }
}

export component SeekBar inherits Rectangle {
    in property <float> position;
    in property <float> duration;
    in property <bool> accent;
    callback seek(float);
    height: 20px;
    private property <float> ratio: root.duration > 0 ? clamp(root.position / root.duration, 0, 1) : 0;
    Rectangle {
        y: (root.height - self.height) / 2;
        height: touch.has-hover ? 8px : 6px;
        width: 100%;
        border-radius: 3px;
        background: Tokens.neutral-200;
        animate height { duration: 100ms; }
        Rectangle {
            x: 0px;
            y: 0px;
            width: parent.width * root.ratio;
            height: 100%;
            border-radius: 3px;
            background: root.accent ? Tokens.brand-500 : Tokens.ink-100;
        }
    }
    Rectangle {
        x: (root.width - self.width) * root.ratio;
        y: (root.height - self.height) / 2;
        width: touch.has-hover || touch.pressed ? 12px : 0px;
        height: touch.has-hover || touch.pressed ? 12px : 0px;
        border-radius: self.width / 2;
        background: root.accent ? Tokens.brand-300 : Tokens.ink-100;
        animate width, height { duration: 100ms; }
    }
    touch := TouchArea {
        mouse-cursor: pointer;
        moved => {
            if self.pressed && root.duration > 0 {
                root.seek(clamp(self.mouse-x / self.width, 0, 1) * root.duration);
            }
        }
        clicked => {
            if root.duration > 0 {
                root.seek(clamp(self.mouse-x / self.width, 0, 1) * root.duration);
            }
        }
    }
    accessible-role: slider;
    accessible-label: "Позиція відтворення";
    accessible-value: root.position;
    accessible-value-minimum: 0;
    accessible-value-maximum: root.duration;
    accessible-value-step: 5;
    accessible-action-increment => { root.seek(min(root.duration, root.position + 5)); }
    accessible-action-decrement => { root.seek(max(0, root.position - 5)); }
}

// Retain the platform slider's input, keyboard and accessibility behavior.
export component TonalSlider inherits Rectangle {
    in property <float> minimum: 0;
    in property <float> maximum: 1;
    in-out property <float> value;
    in property <string> label;
    callback changed(float);
    horizontal-stretch: 1;
    min-height: 20px;
    preferred-height: 20px;
    vertical-stretch: 1;
    border-radius: 10px;
    border-width: native-input.has-focus ? 1px : 0px;
    border-color: Tokens.brand-300;
    min-width: 40px;
    private property <float> ratio: maximum > minimum ? clamp((value - minimum) / (maximum - minimum), 0, 1) : 0;
    Rectangle {
        x: 0px; y: (root.height - 6px) / 2; width: 100%; height: 6px;
        border-radius: 3px; background: Tokens.neutral-300;
        Rectangle { width: parent.width * root.ratio; height: 100%; border-radius: 3px; background: Tokens.brand-500; }
    }
    Rectangle {
        x: (root.width - 4px) * root.ratio; y: (root.height - 20px) / 2;
        width: 4px; height: 20px; border-radius: 2px;
        background: Tokens.brand-300;
    }
    Rectangle {
        width: 100%; height: 100%; opacity: 0.001;
        native-input := Slider {
            width: 100%; height: 100%; minimum: root.minimum; maximum: root.maximum;
            value <=> root.value;
            accessible-label: root.label;
            changed(value) => { root.changed(value); }
        }
    }
}

export component MobileNavItem inherits Rectangle {
    in property <string> text;
    in property <image> icon;
    in property <bool> selected;
    callback clicked();
    horizontal-stretch: 1;
    height: 64px;
    Rectangle {
        width: min(52px, root.width - 4px); height: 28px;
        x: (root.width - self.width) / 2; y: 7px;
        border-radius: 16px;
        background: root.selected ? Tokens.primary-container : transparent;
        animate background { duration: 120ms; }
        Image { source: root.icon; width: 20px; height: 20px; x: (parent.width - 20px) / 2; y: 4px; colorize: root.selected ? Tokens.brand-300 : Tokens.ink-200; }
    }
    Text { text: root.text; x: 1px; y: 39px; width: root.width - 2px; height: 18px; font-size: 10px; font-weight: root.selected ? 700 : 500; color: root.selected ? Tokens.brand-300 : Tokens.ink-200; horizontal-alignment: center; overflow: elide; }
    TouchArea { mouse-cursor: pointer; clicked => { root.clicked(); } }
    accessible-role: button; accessible-label: text;
    accessible-action-default => { root.clicked(); }
}

export component SettingsTile inherits Rectangle {
    in property <string> text;
    in property <string> detail;
    in property <image> icon;
    callback clicked();
    height: 80px;
    border-radius: 24px;
    background: touch.has-hover ? Tokens.neutral-150 : Tokens.neutral-100;
    HorizontalLayout {
        padding: 16px; spacing: 14px;
        Rectangle { width: 44px; height: 44px; border-radius: 16px; background: Tokens.primary-container;
            Image { source: root.icon; width: 22px; height: 22px; x: 11px; y: 11px; colorize: Tokens.brand-300; }
        }
        VerticalLayout { alignment: center; spacing: 5px; horizontal-stretch: 1;
            Text { text: root.text; color: Tokens.ink-100; font-size: 16px; font-weight: 600; overflow: elide; }
            Text { text: root.detail; color: Tokens.ink-300; font-size: 12px; overflow: elide; }
        }
        Image { source: @image-url("../assets/icons/ChevronRight.svg"); width: 18px; height: 18px; colorize: Tokens.ink-200; }
    }
    touch := TouchArea { mouse-cursor: pointer; clicked => { root.clicked(); } }
    accessible-role: button; accessible-label: text;
    accessible-action-default => { root.clicked(); }
}
