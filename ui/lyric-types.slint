export struct WordRow { text: string, start-ms: int, end-ms: int, background: bool, explicit: bool }
export struct LyricRow { start-ms: int, end-ms: int, text: string, background-text: string, translation: string, romanization: string, words: [WordRow], instrumental: bool, active: bool, rtl: bool, agent: string, stage-role: int, rendered: styled-text, background-rendered: styled-text, roman-words: [WordRow], roman-rendered: styled-text }
