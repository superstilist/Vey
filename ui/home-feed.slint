import { ScrollView } from "std-widgets.slint";
import { Tokens } from "tokens.slint";
import { I18n } from "i18n.slint";
import { Motion } from "motion.slint";
import { Action, SongRow } from "controls.slint";
export struct HomeItemRow { key: string, art-key: string, title: string, subtitle: string, kind: string, duration: string, art: image }
export struct HomeShelfRow { key: string, title: string, subtitle: string, kind: string, items: [HomeItemRow] }

export component HomeFeed inherits Rectangle {
    in property <[HomeShelfRow]> shelves;
    in property <[string]> filters: ["all"];
    in property <bool> mobile;
    in property <int> layout;
    in property <bool> loading;
    in property <bool> failed;
    in property <string> current-key;
    in property <string> profile-name;
    in property <image> profile-art;
    callback open-item(string, string);
    callback play-shelf(string);
    callback refresh();
    private property <string> filter: "all";
    height: feed.preferred-height;
    function filter-label(kind: string) -> string {
        kind == "video" ? I18n.tr("Відео") : kind == "album" ? I18n.tr("Альбоми") : kind == "artist" ? I18n.tr("Виконавці") : kind == "playlist" ? I18n.tr("Плейлісти") : I18n.tr("Для вас")
    }
    feed := VerticalLayout {
        spacing: 0px;
        padding-bottom: 36px;
        HorizontalLayout {
            height: 40px; spacing: 12px;
            ScrollView {
                horizontal-stretch: 1;
                horizontal-scrollbar-policy: always-off; vertical-scrollbar-policy: always-off;
                mouse-drag-pan-enabled: true; content-height: self.height;
                content-width: max(self.width, filters.preferred-width);
                filters := HorizontalLayout { height: 40px; spacing: 8px; alignment: start;
                    for kind in root.filters: Action {
                        text: root.filter-label(kind); chip: true; selected: root.filter == kind;
                        clicked => { root.filter = kind; }
                    }
                }
            }
            Action { icon: @image-url("../assets/icons/RefreshCw.svg"); label: I18n.tr("Оновити добірки"); enabled: !root.loading; clicked => { root.refresh(); } }
        }
        Rectangle { height: root.mobile ? 32px : 52px; }
        if root.shelves.length == 0: VerticalLayout {
            spacing: 20px;
            Text { text: root.loading ? I18n.tr("Музика для вас") : I18n.tr("Ваша музика починається тут"); color: Tokens.ink-100; font-size: root.mobile ? 26px : 34px; font-weight: 700; wrap: word-wrap; }
            if root.loading: HorizontalLayout { spacing: 20px; height: root.mobile ? 184px : 248px;
                for n in [0, 1, 2, 3, 4]: Rectangle { background: Tokens.neutral-100; border-radius: 8px; }
            }
            Text { text: root.loading ? I18n.tr("Оновлюємо добірки…") : root.failed ? I18n.tr("Не вдалося завантажити добірки. Спробуйте ще раз.") : I18n.tr("Знайдіть пісню або додайте свою бібліотеку — тут з’являться ваші добірки."); color: Tokens.ink-300; font-size: 14px; wrap: word-wrap; }
            if !root.loading: HorizontalLayout { alignment: start; Action { text: I18n.tr("Оновити добірки"); outlined: true; clicked => { root.refresh(); } } }
        }
        for shelf in root.shelves: section := Rectangle {
            visible: root.filter == "all" || root.filter == shelf.kind;
            min-height: 0px; max-height: self.preferred-height; vertical-stretch: 0;
            private property <length> card-width: shelf.kind == "video" ? (root.mobile ? 264px : min(360px, max(286px, root.width / 3.6))) : root.mobile ? 156px : root.layout == 1 ? 176px : min(218px, max(172px, root.width / 6.2));
            in-out property <length> scroll-x: 0px;
            private property <length> gallery-content-width: max(self.width, shelf.items.length * (self.card-width + 24px) - 24px);
            private property <length> cover-height: shelf.kind == "video" ? self.card-width * 9 / 16 : self.card-width;
            preferred-height: self.visible ? section-layout.preferred-height + (root.mobile ? 32px : 52px) : 0px;
            section-layout := VerticalLayout {
                x: 0px; y: 0px; width: 100%; height: self.preferred-height;
                spacing: root.mobile ? 16px : 20px;
                HorizontalLayout { spacing: 12px; height: shelf.subtitle == "" ? (root.mobile ? 40px : 48px) : (root.mobile ? 58px : 68px);
                    if shelf.key == "again" && root.profile-name != "": Rectangle { width: 48px; height: 48px; border-radius: 24px; clip: true; background: Tokens.neutral-150;
                        Image { source: @image-url("../assets/icons/User.svg"); width: 24px; height: 24px; x: 12px; y: 12px; colorize: Tokens.ink-300; }
                        Image { source: root.profile-art; width: 100%; height: 100%; image-fit: cover; }
                    }
                    VerticalLayout { spacing: 3px; horizontal-stretch: 1; alignment: center;
                        if shelf.subtitle != "": Text { text: shelf.key == "again" && root.profile-name != "" ? root.profile-name : I18n.tr(shelf.subtitle); color: Tokens.ink-300; font-size: 12px; font-weight: 600; overflow: elide; }
                        Text { text: I18n.tr(shelf.title); color: Tokens.ink-100; font-size: root.mobile ? 25px : 34px; font-weight: 700; overflow: elide; }
                    }
                    if shelf.kind == "song" || shelf.kind == "video" || shelf.kind == "quick": Action { text: root.mobile ? "" : I18n.tr("Відтворити все"); icon: @image-url("../assets/icons/Play.svg"); label: I18n.tr("Відтворити все"); outlined: true; clicked => { root.play-shelf(shelf.key); } }
                    if shelf.kind != "quick" && !root.mobile: Action { icon: @image-url("../assets/icons/ChevronLeft.svg"); label: I18n.tr("Назад"); outlined: true; enabled: section.scroll-x < 0px; clicked => { section.scroll-x = min(0px, section.scroll-x + section.width * 0.8); } }
                    if shelf.kind != "quick" && !root.mobile: Action { icon: @image-url("../assets/icons/ChevronRight.svg"); label: I18n.tr("Далі"); outlined: true; enabled: section.scroll-x > section.width - section.gallery-content-width; clicked => { section.scroll-x = max(section.width - section.gallery-content-width, section.scroll-x - section.width * 0.8); } }
                }
                if shelf.kind != "quick": gallery := ScrollView {
                    height: section.cover-height + (root.mobile ? 78px : 86px);
                    content-height: self.height;
                    content-x <=> section.scroll-x;
                    content-width: section.gallery-content-width;
                    horizontal-scrollbar-policy: always-off; vertical-scrollbar-policy: always-off; mouse-drag-pan-enabled: true;
                    HorizontalLayout { spacing: 24px; alignment: start;
                        for item in shelf.items: card := Rectangle {
                            width: section.card-width;
                            VerticalLayout { spacing: 9px;
                                Rectangle { height: section.cover-height; border-radius: item.kind == "artist" ? self.width / 2 : 8px; clip: true; background: Tokens.neutral-100;
                                    Image { source: @image-url("../assets/icons/Music2.svg"); width: 32px; height: 32px; x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2; colorize: Tokens.ink-300; }
                                    Image { source: item.art; width: 100%; height: 100%; image-fit: cover; }
                                    Rectangle { width: 100%; height: 100%; background: touch.has-hover ? #00000035 : transparent; animate background {duration: Motion.feedback;} }
                                    if item.kind != "artist" && (touch.has-hover || item.kind == "video"): Rectangle {
                                        width: 48px; height: 48px; x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2; border-radius: 24px; background: #00000070;
                                        Image { source: item.kind == "album" || item.kind == "playlist" ? @image-url("../assets/icons/ChevronRight.svg") : @image-url("../assets/icons/Play.svg"); width: 24px; height: 24px; x: 12px; y: 12px; colorize: #ffffff; }
                                    }
                                    if item.kind == "video" && item.duration != "": Rectangle { width: timestamp.preferred-width + 10px; height: 22px; x: parent.width - self.width - 7px; y: parent.height - 29px; border-radius: 4px; background: #000000b0;
                                        timestamp := Text {text: item.duration; color: #ffffff; font-size: 11px; font-weight: 600; horizontal-alignment: center; vertical-alignment: center;}
                                    }
                                }
                                Text { text: item.title; color: item.key == root.current-key ? Tokens.brand-300 : Tokens.ink-100; font-size: 15px; font-weight: 600; wrap: word-wrap; overflow: elide; max-height: 40px; horizontal-alignment: item.kind == "artist" ? center : left; }
                                Text { text: item.subtitle; color: Tokens.ink-300; font-size: 13px; wrap: word-wrap; overflow: elide; max-height: 36px; horizontal-alignment: item.kind == "artist" ? center : left; }
                                Rectangle {vertical-stretch: 1;}
                            }
                            touch := TouchArea { mouse-cursor: pointer; clicked => { root.open-item(shelf.key, item.key); } }
                            accessible-role: button; accessible-label: item.title + " · " + item.subtitle;
                            accessible-action-default => {root.open-item(shelf.key, item.key);}
                        }
                    }
                }
                if shelf.kind == "quick": HorizontalLayout { spacing: root.mobile ? 0px : 24px;
                    for column in [0, 1, 2]: VerticalLayout { visible: !root.mobile || column == 0; spacing: 4px; min-width: 0px; max-width: root.mobile && column > 0 ? 0px : 100000px; horizontal-stretch: root.mobile && column > 0 ? 0 : 1;
                        for row in [0, 1, 2, 3]: quick := SongRow {
                            visible: column * 4 + row < shelf.items.length;
                            property <HomeItemRow> item: shelf.items[column * 4 + row];
                            title: self.item.title; artist: self.item.subtitle; art: self.item.art;
                            current: self.item.key == root.current-key; mobile: true; actions: false; filled: false;
                            activated => {root.open-item(shelf.key, self.item.key);}
                        }
                    }
                }
            }
        }
        if root.filter != "all": HorizontalLayout { alignment: start;
            Action {text: I18n.tr("Усі добірки"); icon: @image-url("../assets/icons/ChevronLeft.svg"); clicked => {root.filter = "all";} }
        }
    }
}
