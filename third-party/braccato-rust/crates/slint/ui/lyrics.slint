export struct LyricGlyph {
    text: string,
    start: float,
    width: float,
    delay-ms: float,
    wave-ms: float,
    sweep-delay-ms: float,
    sweep-duration-ms: float,
    sweep-from: float,
    sweep-to: float,
    sweep-feather: float,
}

export struct WobbleFrame {
    x-em: float,
    y-em: float,
    scale-x: float,
    scale-y: float,
}

export struct LyricWord {
    text: string,
    active: bool,
    background: bool,
    start-ms: float,
    duration-ms: float,
    cue-offset: float,
    cue-span: float,
    source-part: int,
    font-family: string,
    glow-wide: image,
    glow-tight: image,
    glow-padding: float,
    glow-levels: int,
    sustain-blurred: image,
    glyphs: [LyricGlyph],
}

export struct BraccatoRow {
    text: string,
    active: bool,
    secondary: bool,
    translation: bool,
    romanization: bool,
    agent: string,
    instrumental: bool,
    stage-role: string,
    source-index: int,
    parts: [LyricWord],
    sustain-blurred: image,
    sustain-blurred-width: float,
    sustain-blurred-height: float,
    sustain-blurred-padding: float,
    sustain-distance: int,
    focus-mix: float,
    font-family: string,
    start-ms: float,
    end-ms: float,
}

export struct InstrumentalFrames {
    silhouette: image,
    fill: image,
    glow: image,
    tile-size: int,
    columns: int,
    levels: int,
    phases: int,
}

component InstrumentalNote inherits Rectangle {
    in property <InstrumentalFrames> frames;
    in property <color> active-color;
    in property <color> muted-color;
    in property <color> glow-color;
    in property <length> note-size: 36px;
    in property <bool> animate: true;
    in property <float> time-ms;
    in property <float> start-ms;
    in property <float> end-ms;
    private property <float> progress: min(1, max(0, (root.time-ms - root.start-ms) / max(1, root.end-ms - root.start-ms)));
    private property <float> level: root.progress * max(0, root.frames.levels - 1);
    private property <float> phase: root.animate ? mod(max(0, root.time-ms - root.start-ms) / 1250, 1) * max(1, root.frames.phases) : 0;
    private property <float> fade: root.time-ms < root.start-ms ? 0 : min(1, max(0, (root.time-ms - root.start-ms) / 150)) * min(1, max(0, 1 - (root.time-ms - root.end-ms) / 500));
    private property <float> deep-stop: min(1, max(0, (6 + 3 + 24 * (0.78 - 0.82 * root.progress) + 0.65) / 36));
    width: root.note-size * 4 / 3;
    height: root.note-size;
    Image {
        x: (root.width - self.width) / 2; y: (root.height - self.height) / 2;
        width: root.note-size * 1.5; height: self.width;
        source: root.frames.silhouette;
        colorize: root.muted-color;
    }
    Rectangle {
        x: (root.width - self.width) / 2;
        y: (root.height - root.note-size * 1.5) / 2 + root.note-size * 1.5 * root.deep-stop;
        width: root.note-size * 1.5;
        height: root.note-size * 1.5 * (1 - root.deep-stop);
        clip: true; opacity: root.fade;
        Image {
            y: -root.note-size * 1.5 * root.deep-stop;
            width: root.note-size * 1.5; height: self.width;
            source: root.frames.silhouette;
            colorize: root.active-color;
        }
    }
    // Bilinear sampling of immutable alpha-mask cells keeps the water surface and rise smooth.
    for sample in [0, 1, 2, 3]: Rectangle {
        private property <int> level-index: min(root.frames.levels - 1, floor(root.level) + (sample >= 2 ? 1 : 0));
        private property <int> phase-index: mod(floor(root.phase) + mod(sample, 2), max(1, root.frames.phases));
        private property <int> frame-index: max(0, self.level-index) * max(1, root.frames.phases) + self.phase-index;
        opacity: root.fade * (sample >= 2 ? root.level - floor(root.level) : 1 - root.level + floor(root.level))
            * (mod(sample, 2) == 1 ? root.phase - floor(root.phase) : 1 - root.phase + floor(root.phase));
        Image {
            x: (root.width - self.width) / 2; y: (root.height - self.height) / 2;
            width: root.note-size * 1.5; height: self.width;
            source: root.frames.glow;
            source-clip-x: mod(parent.frame-index, max(1, root.frames.columns)) * root.frames.tile-size;
            source-clip-y: floor(parent.frame-index / max(1, root.frames.columns)) * root.frames.tile-size;
            source-clip-width: root.frames.tile-size; source-clip-height: root.frames.tile-size;
            colorize: root.glow-color;
        }
        Image {
            x: (root.width - self.width) / 2; y: (root.height - self.height) / 2;
            width: root.note-size * 1.5; height: self.width;
            source: root.frames.fill;
            source-clip-x: mod(parent.frame-index, max(1, root.frames.columns)) * root.frames.tile-size;
            source-clip-y: floor(parent.frame-index / max(1, root.frames.columns)) * root.frames.tile-size;
            source-clip-width: root.frames.tile-size; source-clip-height: root.frames.tile-size;
            colorize: root.active-color;
        }
    }
}

// Clip geometry and text offsets stay on a fixed integer-pixel grid. Moving the clips and
// cancelling their offsets re-rasterizes text at changing phases and makes slow fills flicker.
component LyricInk inherits Rectangle {
    in property <string> text;
    in property <string> font-family;
    in property <length> font-size;
    in property <int> font-weight;
    in property <color> ink;
    in property <color> base-ink: transparent;
    in property <float> reveal: 1;
    in property <float> sweep-start;
    in property <float> sweep-end;
    in property <length> wave-amplitude;
    in property <float> wave-phase;
    in property <bool> native-text-gradients: true;
    private property <angle> wave-angle: sin(root.wave-phase * 180deg)
        * min(0.12, root.wave-amplitude * 2 / max(1px, root.height)) * 57.2958deg;
    private property <float> span: max(0.0001, root.sweep-end - root.sweep-start);
    private property <color> left-ink: root.ink.mix(root.base-ink, root.reveal * min(1, max(0, root.sweep-end / root.span)));
    private property <color> right-ink: root.ink.mix(root.base-ink, root.reveal * min(1, max(0, (root.sweep-end - 1) / root.span)));
    private property <float> start-stop: min(1, max(0, root.sweep-start));
    private property <float> end-stop: min(1, max(0, root.sweep-end));
    // One native text run: no per-band scissor edges can cut through the glyphs.
    if root.native-text-gradients: Text {
        width: root.width; height: root.height; text: root.text;
        color: @linear-gradient(90deg + root.wave-angle,
            root.left-ink 0%, root.left-ink root.start-stop * 100%,
            root.right-ink root.end-stop * 100%, root.right-ink 100%);
        font-family: root.font-family; font-size: root.font-size; font-weight: root.font-weight;
        wrap: no-wrap; horizontal-alignment: left; vertical-alignment: center;
    }
    // Slint's software text rasterizer only supports solid brushes. Retain the fixed
    // integer-pixel feather for hosts using that backend instead of a native GPU renderer.
    private property <length> ink-padding: ceil(root.font-size / 4px) * 1px;
    private property <length> cell-size: max(1, ceil((root.width + root.ink-padding * 2) / 256px)) * 1px;
    private property <int> cell-count: max(1, ceil((root.width + root.ink-padding * 2) / root.cell-size));
    if !root.native-text-gradients: Rectangle {
        width: root.width; height: root.height;
        for cell in root.cell-count: Rectangle {
        private property <float> edge-from: self.x / max(0.001px, root.width);
        private property <float> edge-to: (self.x + self.width) / max(0.001px, root.width);
        private property <float> start: root.sweep-start;
        private property <float> end: root.sweep-end;
        private property <float> feather-from: max(self.edge-from, self.start);
        private property <float> feather-to: min(self.edge-to, self.end);
        private property <float> coverage: self.start >= 1 || self.edge-to <= self.start ? 1
            : self.edge-from >= self.end ? 0
            : min(1, max(0, (max(0, min(self.edge-to, self.start) - self.edge-from)
                + max(0, self.feather-to - self.feather-from)
                * min(1, max(0, (self.end - (self.feather-from + self.feather-to) / 2)
                    / max(0.0001, self.end - self.start)))) / max(0.0001, self.edge-to - self.edge-from)));
        x: cell * root.cell-size - root.ink-padding;
        width: root.cell-size; height: root.height; clip: true;
        Text {
            x: -parent.x;
            width: root.width; height: root.height; text: root.text;
            // Paint alpha directly; container opacity would switch offscreen compositing at 1.0.
            color: root.ink.mix(root.base-ink, root.reveal * parent.coverage);
            font-family: root.font-family; font-size: root.font-size; font-weight: root.font-weight;
            wrap: no-wrap; horizontal-alignment: left; vertical-alignment: center;
        }
        }
    }
}

component LyricWordView inherits Rectangle {
    in property <string> text;
    in property <bool> active;
    in property <bool> background-vocal;
    in property <color> foreground-color;
    in property <color> muted-color;
    in property <color> active-color;
    in property <color> accent-color;
    in property <color> glow-color;
    in property <length> font-size;
    in property <float> line-scale: 1;
    in property <int> line-scale-duration-ms: 166;
    in property <bool> animate-line-scale: true;
    private property <float> animated-line-scale: root.line-scale;
    animate animated-line-scale { duration: root.animate-line-scale ? root.line-scale-duration-ms * 1ms : 0ms; easing: ease; }
    in property <float> cue-duration-ms;
    // Wrapped fragments share the original cue's sweep without inventing new timings.
    in property <float> cue-offset;
    in property <float> cue-span: 1;
    private property <float> fragment-span: root.cue-span > 0 ? root.cue-span : 1;
    in property <float> after-line-ms: -1;
    in property <image> glow-wide;
    in property <image> glow-tight;
    in property <float> glow-padding: 32;
    in property <int> glow-levels: 0;
    in property <image> sustain-blurred;
    in property <[LyricGlyph]> glyphs;
    in property <bool> glow-enabled: true;
    in property <float> elapsed-ms: -1;
    in property <string> motion: "stretch";
    in property <int> font-weight: 700;
    in property <bool> word-wobble: true;
    in property <float> wobble-duration-ms: 1000;
    in property <float> wobble-peak-offset: 0.125;
    in property <float> wobble-settle-offset: 0.75;
    in property <string> wobble-easing: "ease";
    in property <string> wobble-peak-easing: "ease-in-out";
    in property <string> wobble-end-easing: "ease-out";
    in property <WobbleFrame> wobble-from: { x-em: 0, y-em: 0, scale-x: 1, scale-y: 1 };
    in property <WobbleFrame> wobble-peak: { x-em: 0.05, y-em: 0, scale-x: 1.025, scale-y: 1 };
    in property <WobbleFrame> wobble-settle: { x-em: 0, y-em: 0, scale-x: 1, scale-y: 1 };
    in property <WobbleFrame> wobble-to: { x-em: 0, y-em: 0, scale-x: 1, scale-y: 1 };
    in property <float> letter-wave-y-em: -0.05;
    in property <float> letter-wave-settle-y-em: -0.02;
    in property <float> letter-wave-emphasis-scale: 1.11;
    in property <float> letter-wave-duration-ms: 900;
    in property <bool> letter-wave: true;
    in property <string> letter-wave-rise-easing: "ease-in-out";
    in property <string> letter-wave-fall-easing: "ease-out";
    in property <bool> use-sustain-blur: false;
    in property <bool> highlight-swipe: true;
    in property <bool> finish-fill-at-cue-end: false;
    in property <float> swipe-wave-em: 0;
    in property <bool> native-text-gradients: true;
    in property <bool> highlight-fade: true;
    in property <bool> smooth-highlight-fade: false;
    in property <float> swipe-lead-ratio: 0.1;
    in property <float> swipe-duration-ratio: 1.6;
    in property <string> swipe-easing: "linear";
    in property <float> swipe-start-from: -0.2;
    in property <float> swipe-end-from: -0.1;
    in property <float> swipe-start-to: 1.4;
    in property <float> swipe-end-to: 1.5;
    in property <float> glow-duration-ratio: 1.2;
    in property <float> glow-min-duration-ms: 1200;
    in property <string> glow-easing: "ease";
    in property <float> highlight-fade-in-ms: 330;
    in property <float> highlight-fade-out-ms: 500;
    in property <float> glow-radius-from-px: 12.8;
    in property <float> long-word-threshold-ms: 1500;
    // These are the upstream ramp, lead and duration ratios, not a hard clipping rectangle.
    private property <float> completion-progress: min(1, max(0, (1 - root.swipe-start-from) / max(0.0001, root.swipe-start-to - root.swipe-start-from)));
    private property <float> initial-progress: min(root.completion-progress, root.swipe-lead-ratio / max(0.0001, root.swipe-duration-ratio));
    private property <bool> fill-complete: root.finish-fill-at-cue-end && root.cue-duration-ms > 0 && root.cue-phase >= min(1,root.cue-offset + root.fragment-span);
    private property <float> cue-phase: min(1,max(0,root.elapsed-ms / max(1,root.cue-duration-ms)));
    private property <float> local-cue-phase: min(1,max(0,(root.cue-phase - root.cue-offset) / root.fragment-span));
    private property <float> progress: !root.highlight-swipe ? 1 : root.cue-duration-ms > 0
        ? (root.finish-fill-at-cue-end ? root.initial-progress + (root.completion-progress - root.initial-progress) * root.ease-progress(root.local-cue-phase,root.swipe-easing)
            : root.ease-progress(min(1, max(0, (root.elapsed-ms + root.cue-duration-ms * root.swipe-lead-ratio) / (root.cue-duration-ms * root.swipe-duration-ratio))), root.swipe-easing)) : 1;
    private property <float> ramp-start: (root.swipe-start-from + (root.swipe-start-to - root.swipe-start-from) * root.progress - (root.finish-fill-at-cue-end ? 0 : root.cue-offset)) / (root.finish-fill-at-cue-end ? 1 : root.fragment-span);
    private property <float> ramp-end: (root.swipe-end-from + (root.swipe-end-to - root.swipe-end-from) * root.progress - (root.finish-fill-at-cue-end ? 0 : root.cue-offset)) / (root.finish-fill-at-cue-end ? 1 : root.fragment-span);
    private property <float> fade-phase: min(1, max(0, root.after-line-ms / max(1, root.highlight-fade-out-ms)));
    private property <float> fade: !root.highlight-fade ? 1 : root.smooth-highlight-fade
        ? 1 - root.fade-phase * root.fade-phase * (3 - 2 * root.fade-phase) : 1 - root.fade-phase;
    private property <float> reveal: (root.cue-duration-ms <= 0 ? min(1, max(0, root.elapsed-ms / max(1, root.highlight-fade-in-ms))) : (root.elapsed-ms >= 0 && (!root.finish-fill-at-cue-end || !root.highlight-swipe || root.cue-phase >= root.cue-offset) ? 1 : 0)) * root.fade;
    private property <float> glow-time: root.ease-progress(min(1, max(0, root.elapsed-ms / max(root.glow-min-duration-ms, root.cue-duration-ms * root.glow-duration-ratio))), root.glow-easing);
    private property <float> glow-in: root.ease-progress(min(1, max(0, root.elapsed-ms / 80)), "ease-out");
    private property <float> glow-fade: root.glow-enabled && root.elapsed-ms >= 0 && root.cue-duration-ms > 0 && (!root.finish-fill-at-cue-end || !root.highlight-swipe || root.cue-phase >= root.cue-offset)
        ? root.glow-in * root.fade : 0;
    // Only positive-radius shadows have cached paint. The zero-radius resting state is empty.
    private property <float> glow-wide-strength: 1 - root.glow-time;
    private property <float> glow-tight-strength: root.glow-time;
    private property <brush> glow-highlight: root.glow-color;
    // inject.ts splits every non-joining timed word, including short syllables. The long-word
    // threshold controls emphasis scaling only, never the existence of letter masks or floats.
    private property <bool> lettered: root.letter-wave && root.glyphs.length > 0
        && root.cue-duration-ms > 0 && root.motion != "karaoke";
    private property <float> wobble-phase: root.ease-progress(root.wobble-duration-ms > 0 ? min(1, max(0, root.elapsed-ms / root.wobble-duration-ms)) : 1, root.wobble-easing);
    private property <int> wobble-segment: root.wobble-phase <= root.wobble-peak-offset ? 0 : root.wobble-phase <= root.wobble-settle-offset ? 1 : 2;
    private property <float> wobble-local: root.wobble-segment == 0
        ? root.wobble-phase / max(0.0001, root.wobble-peak-offset)
        : root.wobble-segment == 1
            ? root.ease-progress((root.wobble-phase - root.wobble-peak-offset) / max(0.0001, root.wobble-settle-offset - root.wobble-peak-offset), root.wobble-peak-easing)
            : (root.wobble-phase - root.wobble-settle-offset) / max(0.0001, 1 - root.wobble-settle-offset);
    private property <float> wobble-x-em: root.wobble-segment == 0 ? root.mix(root.wobble-from.x-em, root.wobble-peak.x-em, root.wobble-local)
        : root.wobble-segment == 1 ? root.mix(root.wobble-peak.x-em, root.wobble-settle.x-em, root.wobble-local)
        : root.mix(root.wobble-settle.x-em, root.wobble-to.x-em, root.wobble-local);
    private property <float> wobble-y-em: root.wobble-segment == 0 ? root.mix(root.wobble-from.y-em, root.wobble-peak.y-em, root.wobble-local)
        : root.wobble-segment == 1 ? root.mix(root.wobble-peak.y-em, root.wobble-settle.y-em, root.wobble-local)
        : root.mix(root.wobble-settle.y-em, root.wobble-to.y-em, root.wobble-local);
    private property <float> wobble-scale-x: root.wobble-segment == 0 ? root.mix(root.wobble-from.scale-x, root.wobble-peak.scale-x, root.wobble-local)
        : root.wobble-segment == 1 ? root.mix(root.wobble-peak.scale-x, root.wobble-settle.scale-x, root.wobble-local)
        : root.mix(root.wobble-settle.scale-x, root.wobble-to.scale-x, root.wobble-local);
    private property <float> wobble-scale-y: root.wobble-segment == 0 ? root.mix(root.wobble-from.scale-y, root.wobble-peak.scale-y, root.wobble-local)
        : root.wobble-segment == 1 ? root.mix(root.wobble-peak.scale-y, root.wobble-settle.scale-y, root.wobble-local)
        : root.mix(root.wobble-settle.scale-y, root.wobble-to.scale-y, root.wobble-local);
    private property <bool> wobble-enabled: root.word-wobble && root.elapsed-ms >= 0 && root.motion != "none" && root.motion != "karaoke";
    private property <float> karaoke-lift-phase: root.elapsed-ms < 160
        ? root.ease-progress(min(1, max(0, root.elapsed-ms / 160)), "ease-in-out")
        : 1 - root.ease-progress(min(1, max(0, (root.elapsed-ms - 160) / 360)), "ease-in-out");
    private property <length> motion-y: root.motion == "karaoke" && root.elapsed-ms >= 0
        ? -root.font-size * 0.15 * root.karaoke-lift-phase : 0px;
    public pure function mix(a: float, b: float, progress: float) -> float { a + (b - a) * progress }
    pure function bezier-x(t: float, p1: float, p2: float) -> float {
        3 * (1 - t) * (1 - t) * t * p1 + 3 * (1 - t) * t * t * p2 + t * t * t
    }
    pure function bezier-y(t: float, p1: float, p2: float) -> float {
        3 * (1 - t) * (1 - t) * t * p1 + 3 * (1 - t) * t * t * p2 + t * t * t
    }
    pure function bezier-slope-x(t: float, p1: float, p2: float) -> float {
        3 * (1 - t) * (1 - t) * p1 + 6 * (1 - t) * t * (p2 - p1) + 3 * t * t * (1 - p2)
    }
    pure function cubic-bezier-progress(progress: float, x1: float, y1: float, x2: float, y2: float) -> float {
        let p = min(1, max(0, progress));
        let t0 = p;
        let t1 = min(1, max(0, t0 - (root.bezier-x(t0, x1, x2) - p) / max(0.0001, root.bezier-slope-x(t0, x1, x2))));
        let t2 = min(1, max(0, t1 - (root.bezier-x(t1, x1, x2) - p) / max(0.0001, root.bezier-slope-x(t1, x1, x2))));
        let t3 = min(1, max(0, t2 - (root.bezier-x(t2, x1, x2) - p) / max(0.0001, root.bezier-slope-x(t2, x1, x2))));
        let t4 = min(1, max(0, t3 - (root.bezier-x(t3, x1, x2) - p) / max(0.0001, root.bezier-slope-x(t3, x1, x2))));
        root.bezier-y(t4, y1, y2)
    }
    public pure function ease-progress(progress: float, curve: string) -> float {
        if curve == "linear" { return min(1, max(0, progress)); }
        if curve == "ease-in" { return root.cubic-bezier-progress(progress, 0.42, 0, 1, 1); }
        if curve == "ease-out" { return root.cubic-bezier-progress(progress, 0, 0, 0.58, 1); }
        if curve == "ease-in-out" { return root.cubic-bezier-progress(progress, 0.42, 0, 0.58, 1); }
        root.cubic-bezier-progress(progress, 0.25, 0.1, 0.25, 1)
    }
    in property <string> font-family;
    callback clicked();
    background: transparent;
    // Loading a glyph plan must never change the width of its host word.
    width: word.preferred-width;
    height: word.preferred-height;
    private property <length> mask-y: (root.height - (word.font-metrics.ascent - word.font-metrics.descent)) / 2 - root.font-size * root.glow-padding / 64;
    Rectangle {
    x: root.wobble-enabled ? root.font-size * root.wobble-x-em : 0px;
    y: root.motion-y + (root.wobble-enabled ? root.font-size * root.wobble-y-em : 0px);
    width: root.width; height: root.height;
    // Center the scale pop on the word like the upstream inline-block transform origin.
    // Translation still comes from the same song clock, so the full word and its glow travel together.
    transform-origin: { x: self.width / 2, y: self.height / 2 };
    transform-scale-x: root.animated-line-scale * (root.wobble-enabled ? root.wobble-scale-x : 1);
    transform-scale-y: root.animated-line-scale * (root.wobble-enabled ? root.wobble-scale-y : 1);
    // Shadows are blurred glyph alpha masks, shared by words, never rectangular box shadows.
    if root.glow-fade > 0.001: Rectangle {
        width: root.width; height: root.height;
        if root.glow-levels == 0: Image {
            x: -root.font-size * root.glow-padding / 64; y: root.mask-y;
            width: self.source.width * root.font-size / 64;
            height: self.source.height * root.font-size / 64;
            image-fit: fill;
            source: root.glow-wide;
            colorize: root.glow-highlight;
            opacity: root.glow-fade * min(1, root.glow-wide-strength);
        }
        if root.glow-levels == 0: Image {
